                {StyleBox["c", "TI"], "-", StyleBox["i", "TI"], StyleBox["p", 
                  "TI"]}]], ","}], TraditionalForm], "errors" -> {}, 
          "input" -> "\\int_0^\\infty \
e^{-cz}\\cos(pz)\\,dz=\\frac{c}{p^2+c^2},\\qquad\n\\int_0^\\infty \
e^{-cz}\\log \
z\\cos(pz)\\,dz=-\\operatorname{Re}\\frac{\\gamma_E+\\log(c-ip)}{c-ip},", 
          "state" -> "Boxes"|>, "TeXAssistantTemplate"], TraditionalForm]], 
      ExpressionUUID -> "2efab8d6-2155-ea47-96f4-ce4f3dc5bdc1"], 
