                {"-", StyleBox["c", "TI"], StyleBox["z", "TI"]}]], "cos", 
              RowBox[{"(", RowBox[{StyleBox["p", "TI"], StyleBox["z", 
                   "TI"]}], ")"}], "\[DifferentialD]", StyleBox["z", "TI"], 
              "\[LongEqual]", FractionBox[StyleBox["c", "TI"], RowBox[
                {SuperscriptBox[StyleBox["p", "TI"], "2"], "+", 
                 SuperscriptBox[StyleBox["c", "TI"], "2"]}]], ",    ", 
              SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
              SuperscriptBox[StyleBox["e", "TI"], RowBox[{"-", StyleBox["c", 
                  "TI"], StyleBox["z", "TI"]}]], "log", StyleBox["z", "TI"], 
              "cos", RowBox[{"(", RowBox[{StyleBox["p", "TI"], StyleBox["z", 
                   "TI"]}], ")"}], "\[DifferentialD]", StyleBox["z", "TI"], 
              "\[LongEqual]", "-", RowBox[{StyleBox["R", "TI"], StyleBox["e", 
                 "TI"]}], FractionBox[RowBox[{SubscriptBox["\[Gamma]", 
                  StyleBox["E", "TI"]], "+", "log", RowBox[{"(", RowBox[
                    {StyleBox["c", "TI"], "-", StyleBox["i", "TI"], 
