  Cell["7. Properties and removable limits", "Section", 
   ExpressionUUID -> "22e2d5b9-a58a-e848-ab50-ce8e7b50c6ce"], 
  Cell[BoxData[{RowBox[{RowBox[{"symmetryResidual", "=", 
         RowBox[{"N", "[", RowBox[{RowBox[{RowBox[{"derivativeClosed", "[", 
                 RowBox[{RowBox[{"13", "/", "10"}], ",", RowBox[{"17", "/", 
                     "10"}], ",", RowBox[{"7", "/", "10"}]}], "]"}], "-", 
               RowBox[{"derivativeClosed", "[", RowBox[{RowBox[{"17", "/", 
                     "10"}], ",", RowBox[{"13", "/", "10"}], ",", 
                   RowBox[{"7", "/", "10"}]}], "]"}]}], ",", "30"}], "]"}]}], 
       ";"}], "\[IndentingNewLine]", 
     RowBox[{RowBox[{"scalingResidual", "=", 
         RowBox[{"N", "[", RowBox[{RowBox[{RowBox[{"8", " ", RowBox[
                  {"derivativeClosed", "[", RowBox[{RowBox[{"26", "/", 
                       "10"}], ",", RowBox[{"34", "/", "10"}], ",", 
                     RowBox[{"14", "/", "10"}]}], "]"}]}], "-", RowBox[
                {"derivativeClosed", "[", RowBox[{RowBox[{"13", "/", "10"}], 
                   ",", RowBox[{"17", "/", "10"}], ",", RowBox[{"7", "/", 
                     "10"}]}], "]"}]}], ",", "30"}], "]"}]}], ";"}], 
     "\[IndentingNewLine]", 
     RowBox[{RowBox[{RowBox[{"edgeFormula", "[", RowBox[{"b_", ",", "k_"}], 
           "]"}], ":=", RowBox[{RowBox[{RowBox[{"Pi", "^", "3"}], "/", 
             RowBox[{"(", RowBox[{"2", " ", RowBox[{"k", "^", "2"}], " ", 
                 RowBox[{"(", RowBox[{RowBox[{"b", "^", "2"}], "-", 
                     RowBox[{"k", "^", "2"}]}], ")"}]}], ")"}]}], " ", 
           RowBox[{"(", RowBox[{RowBox[{RowBox[{RowBox[{"(", RowBox[
                      {"b", "+", "k"}], ")"}], "/", "2"}], " ", 
                 RowBox[{RowBox[{"Log", "[", RowBox[{RowBox[{"(", RowBox[
                          {"b", "+", "k"}], ")"}], "/", RowBox[{"(", RowBox[
                          {"2", " ", "k"}], ")"}]}], "]"}], "^", "2"}]}], 
               "+", RowBox[{"2", " ", "b", " ", RowBox[{"Log", "[", 
                   RowBox[{RowBox[{"(", RowBox[{"b", "+", "k"}], ")"}], "/", 
                     RowBox[{"(", RowBox[{"2", " ", "k"}], ")"}]}], "]"}]}], 
               "-", RowBox[{RowBox[{"(", RowBox[{"b", "-", "k"}], ")"}], " ", 
                 RowBox[{"(", RowBox[{RowBox[{"PolyLog", "[", RowBox[
                        {"2", ",", RowBox[{RowBox[{"-", RowBox[{"(", RowBox[
                          {"b", "-", "k"}], ")"}]}], "/", RowBox[{"(", 
                          RowBox[{"2", " ", "k"}], ")"}]}]}], "]"}], "+", 
                     RowBox[{RowBox[{"Pi", "^", "2"}], "/", "6"}]}], 
                   ")"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
     RowBox[{RowBox[{"edgeResidual", "=", RowBox[{"Quiet", "[", 
