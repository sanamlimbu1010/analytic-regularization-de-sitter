        RowBox[{"-", "2.163028214697234`5.086744825642712*^-23"}], 
        "\"22 digits\""}, {"\"Q benchmark (0.8, 1.5, 2.5)\"", 
        "\"numerical\"", RowBox[{"-", 
          "7.248273697587543`5.288861282047265*^-23"}], "\"22 digits\""}, 
       {"\"large-k limit of Q/Pi\"", "\"exact\"", "0", "\"identity\""}, 
       {"\"ten dilogarithm arguments\"", "\"exact\"", "0", "\"identity\""}, 
       {"\"Qh[a,k] first argument is 0\"", "\"exact\"", "0", "\"identity\""}, 
       {"\"PolyLog[2, 0] vanishes\"", "\"exact\"", "0", "\"identity\""}, 
       {"\"Qh[k,b] repeats (b-k)/(b+k)\"", "\"exact\"", "0", "\"identity\""}, 
       {"\"equal coefficients on the second Landen line\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"Landen partner, line 1\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"Landen logarithm, line 1\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"Landen partner, line 2\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"Landen logarithm, line 2\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"Landen partner, line 3\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"Landen logarithm, line 3\"", "\"exact\"", "0", 
