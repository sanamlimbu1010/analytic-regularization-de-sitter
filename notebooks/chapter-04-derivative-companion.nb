              RowBox[{"[", RowBox[{SuperscriptBox[RowBox[{"(", RowBox[
                      {SubscriptBox[StyleBox["Z", "TI"], "1"], "-", 
                       SubscriptBox[StyleBox["Z", "TI"], "4"]}], ")"}], "2"], 
                  OverscriptBox[StyleBox["P", "TI"], "."]}], "]"}], "+", "2", 
