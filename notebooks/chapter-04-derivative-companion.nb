                         "10"}], ",", RowBox[{"7", "/", "10"}]}], "]"}]}], 
                 ",", "22"}], "]"}], ",", RowBox[{"Power", "::", "infy"}]}], 
           "]"}]}], ";"}], "\[IndentingNewLine]", 
     RowBox[{RowBox[{"cornerResidual", "=", RowBox[{"Quiet", "[", 
           RowBox[{RowBox[{"N", "[", RowBox[{RowBox[{RowBox[{"Limit", "[", 
