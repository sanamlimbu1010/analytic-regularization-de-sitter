                "]"}], "\[LongEqual]", FractionBox[SuperscriptBox["\[Pi]", 
                "3"], RowBox[{"2", StyleBox["k", "TI"]}]], SubsuperscriptBox[
               "\[Integral]", "0", "1"], SuperscriptBox["log", "2"], 
              StyleBox["s", "TI"], UnderscriptBox["\[Sum]", RowBox[
                {"\[Sigma]", "\[LongEqual]", "\[PlusMinus]", "1"}], 
               LimitsPositioning -> True], RowBox[{"[", RowBox[
