  Cell[BoxData[
    {RowBox[{RowBox[{RowBox[{"laplace0", "[", RowBox[{"c_", ",", "p_"}], 
           "]"}], ":=", RowBox[{"c", "/", RowBox[
            {"(", RowBox[{RowBox[{"p", "^", "2"}], "+", RowBox[{"c", "^", 
                 "2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
     RowBox[{RowBox[{RowBox[{"laplaceLog", "[", RowBox[{"c_", ",", "p_"}], 
           "]"}], ":=", RowBox[{"-", RowBox[{"Re", "[", 
             RowBox[{RowBox[{"(", RowBox[{"EulerGamma", "+", RowBox[
                    {"Log", "[", RowBox[{"c", "-", RowBox[{"I", " ", "p"}]}], 
                     "]"}]}], ")"}], "/", RowBox[{"(", RowBox[{"c", "-", 
                   RowBox[{"I", " ", "p"}]}], ")"}]}], "]"}]}]}], ";"}], 
     "\[IndentingNewLine]", 
     RowBox[{RowBox[{RowBox[{"eulerFamily", "[", RowBox[{"nu_", ",", "c_", 
             ",", "p_"}], "]"}], ":=", RowBox[
          {RowBox[{"Gamma", "[", RowBox[{"1", "+", "nu"}], "]"}], "/", 
           RowBox[{RowBox[{"(", RowBox[{"c", "-", RowBox[{"I", " ", "p"}]}], 
               ")"}], "^", RowBox[{"(", RowBox[{"1", "+", "nu"}], 
               ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
     RowBox[{"record", "[", RowBox[{"\"Laplace transforms\"", ",", 
         RowBox[{"{", RowBox[{RowBox[{"FullSimplify", "[", RowBox[
                {RowBox[{RowBox[{"Re", "[", RowBox[{"eulerFamily", "[", 
