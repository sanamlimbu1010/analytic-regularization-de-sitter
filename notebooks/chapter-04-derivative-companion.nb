           "}"}]}], "]"}]}], "Input", ExpressionUUID -> 
    "f8d50b4f-bc40-5d40-b5b4-e9b96f80ece7"], Cell["8. Quick verification", 
   "Section", ExpressionUUID -> "9b99e199-b26c-8047-9029-59ef780379dd"], 
  Cell[BoxData[{RowBox[{RowBox[{"quickVerification", "=", 
         RowBox[{"<|", RowBox[{RowBox[{"\"Old form = revised form\"", "->", 
               RowBox[{"checks", "[", "\"old form equals current form\"", 
                 "]"}]}], ",", RowBox[{"\"Q primitive + constant\"", "->", 
               RowBox[{"checks", "[", "\"Q primitive plus constant\"", 
                 "]"}]}], ",", RowBox[{"\"Six-Q assembly\"", "->", 
               "qAssemblyValue"}], ",", RowBox[
              {"\"Direct differentiated strings\"", "->", "sourceValue"}], 
             ",", RowBox[{"\"Boxed derivative\"", "->", "closedValue"}], ",", 
             RowBox[{"\"Q minus boxed\"", "->", RowBox[{"qAssemblyValue", 
                 "-", "closedValue"}]}], ",", RowBox[
              {"\"Source minus boxed\"", "->", RowBox[{"sourceValue", "-", 
                 "closedValue"}]}], ",", RowBox[{"\"Benchmark\"", "->", 
               "22.0282468648473596347"}], ",", RowBox[
              {"\"Exchange residual\"", "->", "symmetryResidual"}], ",", 
             RowBox[{"\"Scaling residual\"", "->", "scalingResidual"}], ",", 
             RowBox[{"\"Edge residual\"", "->", "edgeResidual"}], ",", 
             RowBox[{"\"Corner residual\"", "->", "cornerResidual"}]}], 
           "|>"}]}], ";"}], "\[IndentingNewLine]", "quickVerification"}], 
   "Input", ExpressionUUID -> "8c3c4e61-feb1-cb48-9f1c-ee45cf041e01"], 
  Cell["9. Interpretation", "Section", ExpressionUUID -> 
    "ce3a86ef-2463-2d45-9797-0cf3ae16c8bb"], Cell["The exact residual proves \
equality of the earlier common-denominator expression and the revised \
four-term box after the displayed Landen identities. The Q cells check its \
primitive, integration constant, derivative, diagonal limit, and defining \
integral. Independent one-dimensional quadratures reproduce the \
differentiated strings at the benchmark point.", "Text", 
   ExpressionUUID -> "b6639fe6-3172-3343-bff0-be20c4204be8"], 
  Cell["The contour, dominated-convergence, and integration-order arguments \
remain analytic parts of the thesis proof. Precision goals are not certified \
error bounds.", "Text", ExpressionUUID -> 
    "99c62eb1-55c8-ea43-9916-c80f8cf08049"]}, 
