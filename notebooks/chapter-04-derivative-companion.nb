              ",", RowBox[{"{", RowBox[{"remain", ",", "four"}], "}"}]}], 
            "]"}]}], "]"}], ";", RowBox[{"checkExact", "[", 
        RowBox[{"\"four dilogarithms remain\"", ",", 
          RowBox[{RowBox[{"Length", "[", "remain", "]"}], "-", "4"}]}], 
        "]"}], ";", RowBox[{RowBox[{"toSymbols", "[", "e_", "]"}], ":=", 
        RowBox[{"e", "/.", "\[VeryThinSpace]", 
          RowBox[{RowBox[{"PolyLog", "[", RowBox[{"2", ",", "z_"}], "]"}], 
            "\[RuleDelayed]", RowBox[{"Which", "[", RowBox[{RowBox[
                 {"matchArg", "[", RowBox[{"z", ",", RowBox[{"-", FractionBox[
                       RowBox[{"a", "-", "k"}], RowBox[{"2", " ", "k"}]]}]}], 
                  "]"}], ",", "liA", ",", RowBox[{"matchArg", "[", 
                  RowBox[{"z", ",", RowBox[{"-", FractionBox[RowBox[{"b", 
                         "-", "k"}], RowBox[{"2", " ", "k"}]]}]}], "]"}], 
                ",", "liB", ",", RowBox[{"matchArg", "[", RowBox[{"z", ",", 
                    RowBox[{"-", FractionBox[RowBox[{"a", "-", "k"}], 
                       RowBox[{"b", "+", "k"}]]}]}], "]"}], ",", "liC", ",", 
                RowBox[{"matchArg", "[", RowBox[{"z", ",", RowBox[{"-", 
                      FractionBox[RowBox[{"b", "-", "k"}], RowBox[{"a", "+", 
                         "k"}]]}]}], "]"}], ",", "liD", ",", "True", ",", 
                RowBox[{"PolyLog", "[", RowBox[{"2", ",", "z"}], "]"}]}], 
              "]"}]}]}]}], ";", RowBox[{RowBox[{"basis", "[", "e_", "]"}], 
        ":=", RowBox[{"Expand", "[", RowBox[{"PowerExpand", "[", 
            RowBox[{"toSymbols", "[", "e", "]"}], "]"}], "]"}]}], ";", 
      RowBox[{RowBox[{"result421", "[", RowBox[{"u_", ",", "v_", ",", "t_"}], 
          "]"}], ":=", FractionBox[RowBox[{SuperscriptBox["\[Pi]", "3"], " ", 
           RowBox[{"(", RowBox[{FractionBox[RowBox[{RowBox[{"PolyLog", "[", 
                    RowBox[{"2", ",", RowBox[{"-", FractionBox[RowBox[
                          {"v", "-", "t"}], RowBox[{"u", "+", "t"}]]}]}], 
                    "]"}], "-", RowBox[{"PolyLog", "[", RowBox[{"2", ",", 
                      RowBox[{"-", FractionBox[RowBox[{"v", "-", "t"}], 
                         RowBox[{"2", " ", "t"}]]}]}], "]"}], "+", 
                  RowBox[{FractionBox["1", "2"], " ", SuperscriptBox[
                     RowBox[{"Log", "[", FractionBox[RowBox[{"u", "+", "t"}], 
                        RowBox[{"2", " ", "t"}]], "]"}], "2"]}]}], 
                RowBox[{RowBox[{"(", RowBox[{"u", "-", "t"}], ")"}], " ", 
                  RowBox[{"(", RowBox[{"v", "+", "t"}], ")"}]}]], "+", 
               FractionBox[RowBox[{RowBox[{"PolyLog", "[", RowBox[{"2", ",", 
                      RowBox[{"-", FractionBox[RowBox[{"u", "-", "t"}], 
                         RowBox[{"v", "+", "t"}]]}]}], "]"}], "-", 
                  RowBox[{"PolyLog", "[", RowBox[{"2", ",", RowBox[{"-", 
                        FractionBox[RowBox[{"u", "-", "t"}], RowBox[{"2", 
                          " ", "t"}]]}]}], "]"}], "+", RowBox[{FractionBox[
                     "1", "2"], " ", SuperscriptBox[RowBox[{"Log", "[", 
                       FractionBox[RowBox[{"v", "+", "t"}], RowBox[{"2", " ", 
                          "t"}]], "]"}], "2"]}]}], RowBox[
                 {RowBox[{"(", RowBox[{"u", "+", "t"}], ")"}], " ", 
                  RowBox[{"(", RowBox[{"v", "-", "t"}], ")"}]}]], "+", 
               FractionBox[RowBox[{RowBox[{"Log", "[", FractionBox[RowBox[
                      {"u", "+", "t"}], RowBox[{"2", " ", "t"}]], "]"}], " ", 
                  RowBox[{"Log", "[", FractionBox[RowBox[{"v", "+", "t"}], 
                     RowBox[{"2", " ", "t"}]], "]"}]}], RowBox[
                 {RowBox[{"(", RowBox[{"u", "-", "t"}], ")"}], " ", 
                  RowBox[{"(", RowBox[{"v", "-", "t"}], ")"}]}]], "-", 
               FractionBox[RowBox[{RowBox[{"PolyLog", "[", RowBox[{"2", ",", 
                      RowBox[{"-", FractionBox[RowBox[{"u", "-", "t"}], 
                         RowBox[{"2", " ", "t"}]]}]}], "]"}], "+", 
                  RowBox[{"PolyLog", "[", RowBox[{"2", ",", RowBox[{"-", 
                        FractionBox[RowBox[{"v", "-", "t"}], RowBox[{"2", 
                          " ", "t"}]]}]}], "]"}], "+", FractionBox[
                   SuperscriptBox["\[Pi]", "2"], "6"]}], RowBox[
                 {RowBox[{"(", RowBox[{"u", "+", "t"}], ")"}], " ", 
                  RowBox[{"(", RowBox[{"v", "+", "t"}], ")"}]}]]}], ")"}]}], 
         "t"]}], ";", RowBox[{"derivB", "=", RowBox[{"basis", "[", "reduced", 
          "]"}]}], ";", RowBox[{"resB", "=", 
        RowBox[{"basis", "[", RowBox[{"dropZeroLi2", "[", 
            RowBox[{RowBox[{"result421", "[", RowBox[{"a", ",", "b", ",", 
                  "k"}], "]"}], "/.", "\[VeryThinSpace]", 
              RowBox[{RowBox[{"PolyLog", "[", RowBox[{"2", ",", "z_"}], 
                  "]"}], "\[RuleDelayed]", RowBox[{"PolyLog", "[", 
                  RowBox[{"2", ",", RowBox[{"Together", "[", "z", "]"}]}], 
                  "]"}]}]}], "]"}], "]"}]}], ";", 
      RowBox[{"checkExact", "[", RowBox[{"\"(4.21) assembly residual\"", ",", 
          RowBox[{"Together", "[", RowBox[{"derivB", "-", "resB"}], "]"}]}], 
        "]"}], ";", RowBox[{"checkExact", "[", 
        RowBox[{"\"Log[a+b] drops out\"", ",", RowBox[{"Coefficient", "[", 
            RowBox[{RowBox[{"Expand", "[", "derivB", "]"}], ",", 
              RowBox[{"Log", "[", RowBox[{"a", "+", "b"}], "]"}]}], "]"}]}], 
        "]"}], ";", RowBox[{"checkExact", "[", 
        RowBox[{"\"no dilogarithm outside (4.21)\"", ",", 
          RowBox[{"Boole", "[", RowBox[{"!", RowBox[{"FreeQ", "[", 
                RowBox[{"derivB", ",", "PolyLog"}], "]"}]}], "]"}]}], "]"}], 
      ";", RowBox[{"Do", "[", RowBox[
         {RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Together", "[", 
                  RowBox[{"Coefficient", "[", RowBox[{"derivB", ",", "sym"}], 
                    "]"}], "]"}], "===", "0"}], ",", RowBox[{"failCheck", 
                "[", RowBox[{"\"dilogarithm of (4.21) remains\"", ",", 
                  "sym"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", RowBox[{"sym", ",", RowBox[{"{", RowBox[{"liA", ",", 
                  "liB", ",", "liC", ",", "liD"}], "}"}]}], "}"}]}], "]"}], 
      ";", RowBox[{"checkExact", "[", 
        RowBox[{"\"the four dilogarithms of (4.21) are present\"", ",", 
          "0"}], "]"}], ";", RowBox[{"sectionRows", "[", "start", "]"}]}]], 
   "Input"], 
  Cell[BoxData[TagBox[GridBox[{{"\"check\"", "\"kind\"", "\"residual\"", 
        "\"agreement\""}, {"\"ten dilogarithm arguments\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"Qh[a,k] first argument is 0\"", "\"exact\"", 
        "0", "\"identity\""}, {"\"PolyLog[2, 0] vanishes\"", "\"exact\"", 
        "0", "\"identity\""}, {"\"Qh[k,b] repeats (b-k)/(b+k)\"", 
        "\"exact\"", "0", "\"identity\""}, 
       {"\"equal coefficients on the second Landen line\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"Landen partner, line 1\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"Landen logarithm, line 1\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"Landen partner, line 2\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"Landen logarithm, line 2\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"Landen partner, line 3\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"Landen logarithm, line 3\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"Landen partner, line 4\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"Landen logarithm, line 4\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"Landen partner, line 5\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"Landen logarithm, line 5\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"four dilogarithms remain\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"(4.21) assembly residual\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"Log[a+b] drops out\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"no dilogarithm outside (4.21)\"", "\"exact\"", 
        "0", "\"identity\""}, 
       {"\"the four dilogarithms of (4.21) are present\"", "\"exact\"", "0", 
        "\"identity\""}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, 
      AutoDelete -> False, GridBoxFrame -> {"Columns" -> {{True}}, 
        "Rows" -> {{True}}}, GridBoxItemSize -> {"Columns" -> {{Automatic}}, 
        "Rows" -> {{Automatic}}}], "Grid"]], "Output"], 
  Cell["7. Properties of (4.21)", "Section"], Cell["The exchange a <-> b \
swaps the first two terms of (4.21) and leaves the last two unchanged. The \
expression is homogeneous of degree -3. Every logarithm has a positive \
argument and every dilogarithm argument is below 1 for all positive a, b and \
k.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"start", "=", 
        RowBox[{RowBox[{"Length", "[", "checks", "]"}], "+", "1"}]}], ";", 
      RowBox[{RowBox[{"canonPoly", "[", "e_", "]"}], ":=", 
        RowBox[{"e", "/.", "\[VeryThinSpace]", 
          RowBox[{RowBox[{"PolyLog", "[", RowBox[{"n_", ",", "z_"}], "]"}], 
            "\[RuleDelayed]", RowBox[{"PolyLog", "[", RowBox[{"n", ",", 
                RowBox[{"Together", "[", "z", "]"}]}], "]"}]}]}]}], ";", 
      RowBox[{"checkExact", "[", RowBox[
         {"\"(4.21) symmetric under a <-> b\"", ",", 
          RowBox[{"FullSimplify", "[", RowBox[{RowBox[{"canonPoly", "[", 
                RowBox[{RowBox[{"result421", "[", RowBox[{"a", ",", "b", ",", 
                      "k"}], "]"}], "-", RowBox[{"result421", "[", 
                    RowBox[{"b", ",", "a", ",", "k"}], "]"}]}], "]"}], ",", 
              RowBox[{"Assumptions", "\[Rule]", RowBox[{"assumptions", "&&", 
                  RowBox[{"a", "\[NotEqual]", "b"}], "&&", RowBox[
                   {"a", "\[NotEqual]", "k"}], "&&", RowBox[{"b", 
                    "\[NotEqual]", "k"}]}]}]}], "]"}]}], "]"}], ";", 
      RowBox[{"checkExact", "[", RowBox[
         {"\"(4.21) homogeneous of degree -3\"", ",", 
          RowBox[{"FullSimplify", "[", RowBox[{RowBox[{RowBox[
                 {SuperscriptBox["t", "3"], " ", RowBox[{"result421", "[", 
                    RowBox[{RowBox[{"t", " ", "a"}], ",", RowBox[{"t", " ", 
                        "b"}], ",", RowBox[{"t", " ", "k"}]}], "]"}]}], "-", 
                RowBox[{"result421", "[", RowBox[{"a", ",", "b", ",", "k"}], 
                  "]"}]}], ",", RowBox[{"Assumptions", "\[Rule]", 
                RowBox[{"assumptions", "&&", RowBox[{"t", ">", "0"}], "&&", 
                  RowBox[{"a", "\[NotEqual]", "k"}], "&&", RowBox[
                   {"b", "\[NotEqual]", "k"}]}]}]}], "]"}]}], "]"}], ";", 
      RowBox[{"checkTrue", "[", RowBox[
         {"\"(4.21) log arguments positive and dilogarithm arguments below \
1\"", ",", RowBox[{"Resolve", "[", RowBox[{RowBox[{SubscriptBox["\[ForAll]", 
                 RowBox[{RowBox[{"{", RowBox[{"a", ",", "b", ",", "k"}], 
                     "}"}], ",", RowBox[{RowBox[{"a", ">", "0"}], "&&", 
                     RowBox[{"b", ">", "0"}], "&&", RowBox[{"k", ">", 
                       "0"}]}]}]], RowBox[{"(", RowBox[{RowBox[{FractionBox[
                       RowBox[{"a", "+", "k"}], RowBox[{"2", " ", "k"}]], 
                      ">", "0"}], "&&", RowBox[{FractionBox[RowBox[{"b", "+", 
                         "k"}], RowBox[{"2", " ", "k"}]], ">", "0"}], "&&", 
                    RowBox[{RowBox[{"-", FractionBox[RowBox[{"b", "-", "k"}], 
                         RowBox[{"a", "+", "k"}]]}], "<", "1"}], "&&", 
                    RowBox[{RowBox[{"-", FractionBox[RowBox[{"a", "-", "k"}], 
                         RowBox[{"b", "+", "k"}]]}], "<", "1"}], "&&", 
                    RowBox[{RowBox[{"-", FractionBox[RowBox[{"a", "-", "k"}], 
                         RowBox[{"2", " ", "k"}]]}], "<", "1"}], "&&", 
                    RowBox[{RowBox[{"-", FractionBox[RowBox[{"b", "-", "k"}], 
                         RowBox[{"2", " ", "k"}]]}], "<", "1"}]}], ")"}]}], 
              ",", TemplateBox[{}, "Reals"]}], "]"}]}], "]"}], ";", 
      RowBox[{"sectionRows", "[", "start", "]"}]}]], "Input"], 
  Cell[BoxData[TagBox[GridBox[{{"\"check\"", "\"kind\"", "\"residual\"", 
        "\"agreement\""}, {"\"(4.21) symmetric under a <-> b\"", "\"exact\"", 
        "0", "\"identity\""}, {"\"(4.21) homogeneous of degree -3\"", 
        "\"exact\"", "0", "\"identity\""}, 
       {
        "\"(4.21) log arguments positive and dilogarithm arguments below 1\""\
, "\"exact\"", "0", "\"identity\""}}, GridBoxAlignment -> 
       {"Columns" -> {{Left}}}, AutoDelete -> False, 
      GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
      GridBoxItemSize -> {"Columns" -> {{Automatic}}, 
        "Rows" -> {{Automatic}}}], "Grid"]], "Output"], 
  Cell["8. Independent numerics", "Section"], Cell["Equation (4.21) is \
compared with the one-dimensional integrals (4.6), (4.11) and (4.13), Euler's \
constant kept, combined as in (4.2), at (1.3, 1.7, 0.7) and (0.8, 1.5, 2.5). \
The same closed form is compared with the benchmark values. These quadratures \
are separate from the Python script, which is the independent numerical check \
cited in the chapter.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"start", "=", 
        RowBox[{RowBox[{"Length", "[", "checks", "]"}], "+", "1"}]}], ";", 
      RowBox[{RowBox[{"t0", "[", RowBox[{"c_", ",", "p_"}], "]"}], ":=", 
        FractionBox["c", RowBox[{SuperscriptBox["p", "2"], "+", 
           SuperscriptBox["c", "2"]}]]}], ";", 
      RowBox[{RowBox[{"t1", "[", RowBox[{"c_", ",", "p_"}], "]"}], ":=", 
        RowBox[{"-", RowBox[{"Re", "[", FractionBox[RowBox[{"EulerGamma", 
               "+", RowBox[{"Log", "[", RowBox[{"c", "-", RowBox[
                    {"\[ImaginaryI]", " ", "p"}]}], "]"}]}], 
             RowBox[{"c", "-", RowBox[{"\[ImaginaryI]", " ", "p"}]}]], 
            "]"}]}]}], ";", RowBox[{RowBox[{"line", "[", "f_", "]"}], ":=", 
        RowBox[{"2", " ", RowBox[{"NIntegrate", "[", 
            RowBox[{RowBox[{"f", "[", "p", "]"}], ",", RowBox[{"{", 
                RowBox[{"p", ",", "0", ",", "1", ",", "10", ",", 
                  "\[Infinity]"}], "}"}], ",", RowBox[{"WorkingPrecision", 
                "\[Rule]", "22"}], ",", RowBox[{"PrecisionGoal", "\[Rule]", 
                "12"}], ",", RowBox[{"MaxRecursion", "\[Rule]", "20"}], ",", 
              RowBox[{"Method", "\[Rule]", RowBox[{"{", RowBox[
                   {"\"GlobalAdaptive\"", ",", RowBox[
                     {"\"SymbolicProcessing\"", "\[Rule]", "0"}]}], 
                  "}"}]}]}], "]"}]}]}], ";", 
      RowBox[{RowBox[{"cInt", "[", RowBox[{"u_", ",", "v_", ",", "t_"}], 
          "]"}], ":=", RowBox[{SuperscriptBox["\[Pi]", "2"], " ", "v", " ", 
          RowBox[{"line", "[", RowBox[{"Function", "[", RowBox[{"p", ",", 
                FractionBox[RowBox[{RowBox[{"Log", "[", RowBox[
                      {SuperscriptBox["p", "2"], "+", SuperscriptBox["t", 
                        "2"]}], "]"}], " ", RowBox[{"t1", "[", RowBox[
                      {"u", ",", "p"}], "]"}]}], RowBox[{RowBox[{"(", 
                     RowBox[{SuperscriptBox["p", "2"], "+", SuperscriptBox[
                        "t", "2"]}], ")"}], " ", RowBox[{"(", RowBox[
                      {SuperscriptBox["p", "2"], "+", SuperscriptBox["v", 
                        "2"]}], ")"}]}]]}], "]"}], "]"}]}]}], ";", 
      RowBox[{RowBox[{"dInt", "[", RowBox[{"u_", ",", "v_", ",", "t_"}], 
          "]"}], ":=", RowBox[{"-", FractionBox[RowBox[{"2", " ", 
             SuperscriptBox["\[Pi]", "2"], " ", "v", " ", 
             RowBox[{"line", "[", RowBox[{"Function", "[", RowBox[{"p", ",", 
                   FractionBox[RowBox[{RowBox[{"Log", "[", RowBox[
                         {SuperscriptBox["p", "2"], "+", SuperscriptBox["t", 
                          "2"]}], "]"}], " ", RowBox[{"(", RowBox[
                         {RowBox[{RowBox[{"-", "u"}], " ", RowBox[{"t1", "[", 
                          RowBox[{"t", ",", "p"}], "]"}]}], "+", RowBox[
                          {"t", " ", RowBox[{"t1", "[", RowBox[{"u", ",", 
                          "p"}], "]"}]}]}], ")"}]}], RowBox[{SuperscriptBox[
                       "p", "2"], "+", SuperscriptBox["v", "2"]}]]}], "]"}], 
               "]"}]}], RowBox[{"t", " ", RowBox[{"(", RowBox[
                {SuperscriptBox["u", "2"], "-", SuperscriptBox["t", "2"]}], 
               ")"}]}]]}]}], ";", 
      RowBox[{RowBox[{"derivFromIntegrals", "[", RowBox[{"u_", ",", "v_", 
            ",", "t_"}], "]"}], ":=", 
        RowBox[{"-", RowBox[{"(", RowBox[{RowBox[{"zzFromS", "[", 
                RowBox[{"u", ",", "v", ",", "t"}], "]"}], "-", 
              RowBox[{"2", " ", RowBox[{"(", RowBox[{RowBox[{"cInt", "[", 
                      RowBox[{"u", ",", "v", ",", "t"}], "]"}], "+", 
                    RowBox[{"cInt", "[", RowBox[{"v", ",", "u", ",", "t"}], 
                      "]"}]}], ")"}]}], "+", RowBox[{"dInt", "[", 
                RowBox[{"u", ",", "v", ",", "t"}], "]"}], "+", 
              RowBox[{"dInt", "[", RowBox[{"v", ",", "u", ",", "t"}], 
                "]"}]}], ")"}]}]}], ";", RowBox[{"checkNumerical", "[", 
        RowBox[
         {"\"(4.21) against (4.6), (4.11), (4.13) at (1.3, 1.7, 0.7)\"", ",", 
          RowBox[{"result421", "[", RowBox[{FractionBox["13", "10"], ",", 
              FractionBox["17", "10"], ",", FractionBox["7", "10"]}], "]"}], 
          ",", RowBox[{"derivFromIntegrals", "[", 
            RowBox[{FractionBox["13", "10"], ",", FractionBox["17", "10"], 
              ",", FractionBox["7", "10"]}], "]"}], ",", "12"}], "]"}], ";", 
      RowBox[{"checkNumerical", "[", RowBox[
         {"\"(4.21) against (4.6), (4.11), (4.13) at (0.8, 1.5, 2.5)\"", ",", 
          RowBox[{"result421", "[", RowBox[{FractionBox["4", "5"], ",", 
              FractionBox["3", "2"], ",", FractionBox["5", "2"]}], "]"}], 
          ",", RowBox[{"derivFromIntegrals", "[", 
            RowBox[{FractionBox["4", "5"], ",", FractionBox["3", "2"], ",", 
              FractionBox["5", "2"]}], "]"}], ",", "12"}], "]"}], ";", 
      RowBox[{"checkNumerical", "[", RowBox[
         {"\"(4.21) benchmark (1.3, 1.7, 0.7)\"", ",", 
          RowBox[{"result421", "[", RowBox[{FractionBox["13", "10"], ",", 
              FractionBox["17", "10"], ",", FractionBox["7", "10"]}], "]"}], 
          ",", RowBox[{"bench", "[", "\"22.0282468648473596347\"", "]"}], 
          ",", "18"}], "]"}], ";", RowBox[{"checkNumerical", "[", 
        RowBox[{"\"(4.21) benchmark (0.8, 1.5, 2.5)\"", ",", 
          RowBox[{"result421", "[", RowBox[{FractionBox["4", "5"], ",", 
              FractionBox["3", "2"], ",", FractionBox["5", "2"]}], "]"}], 
          ",", RowBox[{"bench", "[", "\"-2.289477270760079462981\"", "]"}], 
          ",", "18"}], "]"}], ";", RowBox[{"sectionRows", "[", "start", 
        "]"}]}]], "Input"], 
  Cell[BoxData[TagBox[GridBox[{{"\"check\"", "\"kind\"", "\"residual\"", 
        "\"agreement\""}, 
       {"\"(4.21) against (4.6), (4.11), (4.13) at (1.3, 1.7, 0.7)\"", 
        "\"numerical\"", "0``19.962185665712774", "\"22 digits\""}, 
       {"\"(4.21) against (4.6), (4.11), (4.13) at (0.8, 1.5, 2.5)\"", 
        "\"numerical\"", "0``20.33882879007098", "\"22 digits\""}, 
       {"\"(4.21) benchmark (1.3, 1.7, 0.7)\"", "\"numerical\"", 
        "1.70885081576621244`5.588694219545418*^-21", "\"22 digits\""}, 
       {"\"(4.21) benchmark (0.8, 1.5, 2.5)\"", "\"numerical\"", 
        RowBox[{"-", "3.6684412202687479`5.903715232726373*^-22"}], 
        "\"21 digits\""}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, 
      AutoDelete -> False, GridBoxFrame -> {"Columns" -> {{True}}, 
        "Rows" -> {{True}}}, GridBoxItemSize -> {"Columns" -> {{Automatic}}, 
        "Rows" -> {{Automatic}}}], "Grid"]], "Output"], 
  Cell["9. Summary", "Section"], Cell["Every check above is listed with its \
kind and its residual. An exact residual is an identity. A numerical \
agreement is the number of digits reached, not a certified error bound.", 
   "Text"], Cell[BoxData[RowBox[{"Grid", "[", 
      RowBox[{RowBox[{"Prepend", "[", RowBox[
           {RowBox[{"Values", "/@", "checks"}], ",", 
            RowBox[{"{", RowBox[{"\"check\"", ",", "\"kind\"", ",", 
                "\"residual\"", ",", "\"agreement\""}], "}"}]}], "]"}], ",", 
        RowBox[{"Frame", "\[Rule]", "All"}], ",", 
        RowBox[{"Alignment", "\[Rule]", "Left"}]}], "]"}]], "Input"], 
  Cell[BoxData[TagBox[GridBox[{{"\"check\"", "\"kind\"", "\"residual\"", 
        "\"agreement\""}, {"\"(4.3) cosine transform of 1\"", "\"exact\"", 
        "0", "\"identity\""}, {"\"(4.4) cosine transform of log z\"", 
        "\"exact\"", "0", "\"identity\""}, 
       {"\"cosine transform of log^2 z\"", "\"exact\"", "0", "\"identity\""}, 
       {"\"(4.5) at (z,z')={1, 2}\"", "\"numerical\"", 
        "0``19.852936861690747", "\"22 digits\""}, 
       {"\"(4.5) at (z,z')= 1  1\\n{-, -}\\n 2  2\"", "\"numerical\"", 
        "0``19.469555312990135", "\"22 digits\""}, 
       {"\"(4.5) at (z,z')=    1\\n{2, -}\\n    5\"", "\"numerical\"", 
        "0``19.947396813255576", "\"22 digits\""}, 
       {"\"log^2 integral on (0,1)\"", "\"exact\"", "0", "\"identity\""}, 
       {"\"log^2 integral at negative alpha\"", "\"numerical\"", 
        "0``27.841825085775934", "\"28 digits\""}, 
       {"\"(4.8) derivative vanishes for w < 0\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"(4.8) holds at w = -1\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"(4.9) against (4.6) at {1.3, 1.7, 0.70}\"", 
        "\"numerical\"", "0``20.186813527279", "\"22 digits\""}, 
       {"\"(4.9) against the (0,1) form at {1.3, 1.7, 0.70}\"", 
