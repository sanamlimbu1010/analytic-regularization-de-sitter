Notebook[
 {Cell["Chapter 4 companion: the differentiated three-loop difference", 
   "Title", ExpressionUUID -> "d741d689-f9fa-ac47-b2c0-3664ff388043"], 
  Cell["From the differentiated strings to the boxed four-term result", 
   "Section", ExpressionUUID -> "484a29c0-39b8-ad42-9400-386995998464"], 
  Cell[TextData[{"This self-contained notebook follows section 4.1 of the \
revised Chapter 4. Evaluate it from top to bottom in a fresh kernel. Exact \
zero residuals check algebra; numerical quadratures provide independent \
regression evidence.", StyleBox["Scope.", FontWeight -> Bold], " The \
differentiated PZP term uses the iterated order specified in section 4.1.2. \
No equivalence with other prescriptions is claimed. "}], "Text", 
   ExpressionUUID -> "a4716815-b5e8-e941-871d-2ed167f00c39"], 
  Cell["1. Conventions and assumptions", "Section", 
   ExpressionUUID -> "06c8e0f4-1179-5c40-a296-bd7ca4818114"], 
  Cell[TextData[{"Write ", 
     Cell[BoxData[FormBox[TemplateBox[
         <|"boxes" -> FormBox[RowBox[{StyleBox["a", "TI"], "\[LongEqual]", 
              SubscriptBox[StyleBox["k", "TI"], "12"]}], TraditionalForm], 
          "errors" -> {}, "input" -> "a=k_{12}", "state" -> "Boxes"|>, 
         "TeXAssistantTemplate"], TraditionalForm]], 
      ExpressionUUID -> "d1194b28-4286-3544-8d1f-d3c32545ff62"], ", ", 
