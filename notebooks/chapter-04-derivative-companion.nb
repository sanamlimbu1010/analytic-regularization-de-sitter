Notebook[
 {Cell["Chapter 4 companion: the differentiated three-loop difference", 
   "Title"], Cell["Thesis: Comparing UV Regularizations for Cosmological \
Correlators in de Sitter Space, Sanam Limbu (LMU Munich, 2026), Chapter 4. \
Notation: a = k12, b = k34, and k is the exchanged momentum. 14.3.0 for \
Microsoft Windows (64-bit) (July 8, 2025).", "Text"], 
  Cell["This notebook follows section 4.1. It records the computer-algebra \
steps behind the boxed derivative (4.21). Exact checks return a zero residual \
under a > 0, b > 0, k > 0. Numerical checks state how many digits agreed. A \
precision goal is not an error bound. The ansatz search that found the \
undifferentiated closed form is not used.", "Text"], 
  Cell["1. Setup", "Section"], Cell["a = k12, b = k34, and k is the exchanged \
momentum, all positive. Each check stores its name, whether it is exact or \
numerical, and its residual. A failed check aborts the evaluation.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", "\"Global`*\"", "]"}], ";", 
      RowBox[{"$MaxExtraPrecision", "=", "10000"}], ";", 
      RowBox[{"checks", "=", RowBox[{"{", "}"}]}], ";", 
      RowBox[{"assumptions", "=", RowBox[{RowBox[{"a", ">", "0"}], "&&", 
          RowBox[{"b", ">", "0"}], "&&", RowBox[{"k", ">", "0"}]}]}], ";", 
      RowBox[{RowBox[{"failCheck", "[", RowBox[{"name_", ",", "detail_"}], 
          "]"}], ":=", RowBox[{"(", RowBox[{RowBox[{"Print", "[", 
              RowBox[{"\"FAILED: \"", ",", "name"}], "]"}], ";", 
            RowBox[{"Print", "[", "detail", "]"}], ";", 
            RowBox[{"Abort", "[", "]"}]}], ")"}]}], ";", 
      RowBox[{RowBox[{"checkExact", "[", RowBox[{"name_", ",", "residual_"}], 
          "]"}], ":=", RowBox[{"Module", "[", 
          RowBox[{RowBox[{"{", RowBox[{"r", "=", "residual"}], "}"}], ",", 
            RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"r", "=!=", "0"}], 
                  ",", RowBox[{"r", "=", RowBox[{"Together", "[", "residual", 
                      "]"}]}]}], "]"}], ";", RowBox[{"If", "[", 
                RowBox[{RowBox[{"r", "=!=", "0"}], ",", RowBox[{"r", "=", 
                    RowBox[{"Expand", "[", "residual", "]"}]}]}], "]"}], ";", 
              RowBox[{"If", "[", RowBox[{RowBox[{"r", "=!=", "0"}], ",", 
                  RowBox[{"r", "=", RowBox[{"Simplify", "[", RowBox[
                       {"residual", ",", RowBox[{"Assumptions", "\[Rule]", 
                          "assumptions"}]}], "]"}]}]}], "]"}], ";", 
              RowBox[{"If", "[", RowBox[{RowBox[{"r", "=!=", "0"}], ",", 
                  RowBox[{"r", "=", RowBox[{"FullSimplify", "[", RowBox[
                       {"residual", ",", RowBox[{"Assumptions", "\[Rule]", 
                          "assumptions"}]}], "]"}]}]}], "]"}], ";", 
              RowBox[{"If", "[", RowBox[{RowBox[{"r", "=!=", "0"}], ",", 
                  RowBox[{"failCheck", "[", RowBox[{"name", ",", 
                      "residual"}], "]"}]}], "]"}], ";", RowBox[{"AppendTo", 
                "[", RowBox[{"checks", ",", RowBox[{"Association", "[", 
                    RowBox[{RowBox[{"\"name\"", "\[Rule]", "name"}], ",", 
                      RowBox[{"\"kind\"", "\[Rule]", "\"exact\""}], ",", 
                      RowBox[{"\"residual\"", "\[Rule]", "0"}], ",", 
                      RowBox[{"\"agreement\"", "\[Rule]", "\"identity\""}]}], 
                    "]"}]}], "]"}], ";", "0"}]}], "]"}]}], ";", 
      RowBox[{RowBox[{"checkTrue", "[", RowBox[{"name_", ",", "value_"}], 
          "]"}], ":=", RowBox[{"If", "[", RowBox[
           {RowBox[{"TrueQ", "[", "value", "]"}], ",", 
            RowBox[{"checkExact", "[", RowBox[{"name", ",", "0"}], "]"}], 
            ",", RowBox[{"failCheck", "[", RowBox[{"name", ",", "value"}], 
              "]"}]}], "]"}]}], ";", 
      RowBox[{RowBox[{"checkNumerical", "[", RowBox[{"name_", ",", "got_", 
            ",", "want_", ",", "digits_Integer"}], "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"diff", ",", 
                "scale", ",", "rel", ",", "agreement"}], "}"}], ",", 
            RowBox[{RowBox[{"diff", "=", RowBox[{"Quiet", "[", RowBox[
                   {RowBox[{RowBox[{"N", "[", RowBox[{"got", ",", RowBox[
                          {"digits", "+", "10"}]}], "]"}], "-", RowBox[
                       {"N", "[", RowBox[{"want", ",", RowBox[{"digits", "+", 
                          "10"}]}], "]"}]}], ",", RowBox[{"{", RowBox[
                       {StyleBox[RowBox[{"N", "::", "meprec"}], 
                         "MessageName"], ",", StyleBox[RowBox[{"N", "::", 
                          "precw"}], "MessageName"]}], "}"}]}], "]"}]}], ";", 
              RowBox[{"If", "[", RowBox[{RowBox[{"!", RowBox[{"NumericQ", 
                      "[", "diff", "]"}]}], ",", RowBox[{"failCheck", "[", 
                    RowBox[{"name", ",", "diff"}], "]"}]}], "]"}], ";", 
              RowBox[{"scale", "=", RowBox[{"Max", "[", RowBox[{"1", ",", 
                    RowBox[{"Abs", "[", RowBox[{"Quiet", "[", RowBox[
                         {RowBox[{"N", "[", RowBox[{"want", ",", RowBox[
                          {"digits", "+", "10"}]}], "]"}], ",", RowBox[
                          {"{", RowBox[{StyleBox[RowBox[{"N", "::", 
                          "meprec"}], "MessageName"], ",", StyleBox[RowBox[
                          {"N", "::", "precw"}], "MessageName"]}], "}"}]}], 
                        "]"}], "]"}]}], "]"}]}], ";", RowBox[{"rel", "=", 
                FractionBox[RowBox[{"Abs", "[", "diff", "]"}], "scale"]}], 
              ";", RowBox[{"agreement", "=", RowBox[{"If", "[", RowBox[
                   {RowBox[{"rel", "\[Equal]", "0"}], ",", RowBox[{"digits", 
                      "+", "10"}], ",", RowBox[{"Floor", "[", RowBox[
                       {"-", RowBox[{"Log10", "[", "rel", "]"}]}], "]"}]}], 
                  "]"}]}], ";", RowBox[{"If", "[", RowBox[
                 {RowBox[{RowBox[{"!", RowBox[{"IntegerQ", "[", "agreement", 
                        "]"}]}], "||", RowBox[{"agreement", "<", 
                      "digits"}]}], ",", RowBox[{"failCheck", "[", 
                    RowBox[{"name", ",", RowBox[{"{", RowBox[{RowBox[{"N", 
                          "[", RowBox[{"diff", ",", "8"}], "]"}], ",", 
                          "agreement"}], "}"}]}], "]"}]}], "]"}], ";", 
              RowBox[{"AppendTo", "[", RowBox[{"checks", ",", RowBox[
                   {"Association", "[", RowBox[{RowBox[{"\"name\"", 
                        "\[Rule]", "name"}], ",", RowBox[{"\"kind\"", 
                        "\[Rule]", "\"numerical\""}], ",", RowBox[
                       {"\"residual\"", "\[Rule]", RowBox[{"N", "[", RowBox[
                          {"diff", ",", "6"}], "]"}]}], ",", RowBox[
                       {"\"agreement\"", "\[Rule]", RowBox[{RowBox[
                          {"ToString", "[", "agreement", "]"}], "<>", 
                          "\" digits\""}]}]}], "]"}]}], "]"}], ";", 
              "agreement"}]}], "]"}]}], ";", 
      RowBox[{RowBox[{"bench", "[", "s_String", "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"t", "=", "s"}], ",", 
                RowBox[{"sign", "=", "1"}], ",", "parts", ",", "frac"}], 
              "}"}], ",", RowBox[{RowBox[{"If", "[", RowBox[
                 {RowBox[{"StringStartsQ", "[", RowBox[{"t", ",", "\"-\""}], 
                    "]"}], ",", RowBox[{RowBox[{"sign", "=", RowBox[
                       {"-", "1"}]}], ";", RowBox[{"t", "=", RowBox[
                       {"StringDrop", "[", RowBox[{"t", ",", "1"}], 
                        "]"}]}]}]}], "]"}], ";", RowBox[{"parts", "=", 
                RowBox[{"StringSplit", "[", RowBox[{"t", ",", "\".\""}], 
                  "]"}]}], ";", RowBox[{"frac", "=", RowBox[{"If", "[", 
                  RowBox[{RowBox[{RowBox[{"Length", "[", "parts", "]"}], 
                      "\[Equal]", "1"}], ",", "\"\"", ",", RowBox[{"parts", 
                      "\[LeftDoubleBracket]", "2", 
                      "\[RightDoubleBracket]"}]}], "]"}]}], ";", 
              FractionBox[RowBox[{"sign", " ", RowBox[{"ToExpression", "[", 
                   RowBox[{"StringDelete", "[", RowBox[{"t", ",", "\".\""}], 
                     "]"}], "]"}]}], SuperscriptBox["10", RowBox[
                 {"StringLength", "[", "frac", "]"}]]]}]}], "]"}]}], ";", 
      RowBox[{RowBox[{"sectionRows", "[", "start_Integer", "]"}], ":=", 
        RowBox[{"Grid", "[", RowBox[{RowBox[{"Prepend", "[", 
              RowBox[{RowBox[{"Values", "/@", RowBox[{"checks", 
                    "\[LeftDoubleBracket]", RowBox[{"start", ";;", "All"}], 
                    "\[RightDoubleBracket]"}]}], ",", RowBox[{"{", 
                  RowBox[{"\"check\"", ",", "\"kind\"", ",", "\"residual\"", 
                    ",", "\"agreement\""}], "}"}]}], "]"}], ",", 
            RowBox[{"Frame", "\[Rule]", "All"}], ",", 
            RowBox[{"Alignment", "\[Rule]", "Left"}]}], "]"}]}], ";", 
      "$Version"}]], "Input"], 
  Cell[BoxData["\"14.3.0 for Microsoft Windows (64-bit) (July 8, 2025)\""], 
   "Output"], Cell["2. Elementary integrals (4.3)-(4.5)", "Section"], 
  Cell["Equations (4.3) and (4.4) are the cosine transforms of 1 and of log \
z, real parts of Laplace transforms at c - I p. The same Gamma-function \
derivative gives the transform of log^2 z, Re[((EulerGamma + Log[s])^2 + \
Pi^2/6)/s], with s = c - I p. Equation (4.5) is checked by quadrature at a \
few positive times, with k = 7/10.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"start", "=", 
        RowBox[{RowBox[{"Length", "[", "checks", "]"}], "+", "1"}]}], ";", 
      RowBox[{RowBox[{"sLap", "[", "nu_", "]"}], ":=", 
        FractionBox[RowBox[{"Gamma", "[", RowBox[{"1", "+", "nu"}], "]"}], 
         SuperscriptBox[RowBox[{"(", RowBox[{"c", "-", RowBox[{
                "\[ImaginaryI]", " ", "p"}]}], ")"}], 
          RowBox[{"1", "+", "nu"}]]]}], ";", 
      RowBox[{"checkExact", "[", RowBox[{"\"(4.3) cosine transform of 1\"", 
          ",", RowBox[{"FullSimplify", "[", RowBox[
             {RowBox[{RowBox[{"Re", "[", RowBox[{"sLap", "[", "0", "]"}], 
                  "]"}], "-", FractionBox["c", RowBox[{SuperscriptBox["c", 
                    "2"], "+", SuperscriptBox["p", "2"]}]]}], ",", 
              RowBox[{"Assumptions", "\[Rule]", RowBox[{RowBox[{"c", ">", 
                    "0"}], "&&", RowBox[{"p", "\[Element]", TemplateBox[{}, 
                     "Reals"]}]}]}]}], "]"}]}], "]"}], ";", 
      RowBox[{"checkExact", "[", RowBox[
         {"\"(4.4) cosine transform of log z\"", ",", 
          RowBox[{"FullSimplify", "[", RowBox[{RowBox[{RowBox[{"(", 
                  RowBox[{RowBox[{SubscriptBox["\[PartialD]", RowBox[
                        {"nu"}]], RowBox[{"sLap", "[", "nu", "]"}]}], "/.", 
                    "\[VeryThinSpace]", RowBox[{"nu", "\[Rule]", "0"}]}], 
                  ")"}], "+", FractionBox[RowBox[{"EulerGamma", "+", 
                   RowBox[{"Log", "[", RowBox[{"c", "-", RowBox[
                        {"\[ImaginaryI]", " ", "p"}]}], "]"}]}], 
                 RowBox[{"c", "-", RowBox[{"\[ImaginaryI]", " ", "p"}]}]]}], 
              ",", RowBox[{"Assumptions", "\[Rule]", RowBox[
                 {RowBox[{"c", ">", "0"}], "&&", RowBox[{"p", "\[Element]", 
                    TemplateBox[{}, "Reals"]}]}]}]}], "]"}]}], "]"}], ";", 
      RowBox[{"checkExact", "[", RowBox[{"\"cosine transform of log^2 z\"", 
          ",", RowBox[{"FullSimplify", "[", RowBox[
             {RowBox[{RowBox[{"(", RowBox[{RowBox[{SubscriptBox[
                       "\[PartialD]", RowBox[{RowBox[{"{", RowBox[{"nu", ",", 
                          "2"}], "}"}]}]], RowBox[{"sLap", "[", "nu", 
                        "]"}]}], "/.", "\[VeryThinSpace]", RowBox[{"nu", 
                      "\[Rule]", "0"}]}], ")"}], "-", FractionBox[
                 RowBox[{SuperscriptBox[RowBox[{"(", RowBox[{"EulerGamma", 
                        "+", RowBox[{"Log", "[", RowBox[{"c", "-", RowBox[
                          {"\[ImaginaryI]", " ", "p"}]}], "]"}]}], ")"}], 
                    "2"], "+", FractionBox[SuperscriptBox["\[Pi]", "2"], 
                    "6"]}], RowBox[{"c", "-", RowBox[{"\[ImaginaryI]", " ", 
                     "p"}]}]]}], ",", RowBox[{"Assumptions", "\[Rule]", 
                RowBox[{RowBox[{"c", ">", "0"}], "&&", RowBox[{"p", 
                    "\[Element]", TemplateBox[{}, "Reals"]}]}]}]}], "]"}]}], 
        "]"}], ";", RowBox[{RowBox[{"kernelClosed", "[", 
          RowBox[{"z_", ",", "zp_", ",", "kk_"}], "]"}], ":=", 
        FractionBox[RowBox[{"\[Pi]", " ", RowBox[
            {"(", RowBox[{RowBox[{"Exp", "[", RowBox[{RowBox[{"-", "kk"}], 
                   " ", RowBox[{"Abs", "[", RowBox[{"z", "-", "zp"}], 
                     "]"}]}], "]"}], "+", RowBox[{"Exp", "[", RowBox[
                  {RowBox[{"-", "kk"}], " ", RowBox[{"(", RowBox[{"z", "+", 
                       "zp"}], ")"}]}], "]"}]}], ")"}]}], 
         RowBox[{"2", " ", "kk"}]]}], ";", 
      RowBox[{RowBox[{"kernelNum", "[", RowBox[{"z_", ",", "zp_", ",", 
            "kk_"}], "]"}], ":=", RowBox[{"NIntegrate", "[", 
          RowBox[{FractionBox[RowBox[{RowBox[{"Cos", "[", RowBox[{"p", " ", 
                   "z"}], "]"}], " ", RowBox[{"Cos", "[", RowBox[{"p", " ", 
                   "zp"}], "]"}]}], RowBox[{SuperscriptBox["p", "2"], "+", 
               SuperscriptBox["kk", "2"]}]], ",", 
            RowBox[{"{", RowBox[{"p", ",", RowBox[{"-", "\[Infinity]"}], ",", 
                "\[Infinity]"}], "}"}], ",", RowBox[{"Method", "\[Rule]", 
              "\"LevinRule\""}], ",", RowBox[{"WorkingPrecision", "\[Rule]", 
              "20"}], ",", RowBox[{"PrecisionGoal", "\[Rule]", "12"}]}], 
          "]"}]}], ";", RowBox[{"Do", "[", 
        RowBox[{RowBox[{"checkNumerical", "[", RowBox[
             {RowBox[{"\"(4.5) at (z,z')=\"", "<>", RowBox[{"ToString", "[", 
                  "pair", "]"}]}], ",", RowBox[{"kernelNum", "[", 
                RowBox[{RowBox[{"pair", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], ",", RowBox[{"pair", 
                    "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                  ",", FractionBox["7", "10"]}], "]"}], ",", 
              RowBox[{"kernelClosed", "[", RowBox[{RowBox[{"pair", 
                    "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                  ",", RowBox[{"pair", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], ",", FractionBox["7", "10"]}], 
                "]"}], ",", "12"}], "]"}], ",", 
          RowBox[{"{", RowBox[{"pair", ",", RowBox[{"{", RowBox[
                 {RowBox[{"{", RowBox[{"1", ",", "2"}], "}"}], ",", 
                  RowBox[{"{", RowBox[{FractionBox["1", "2"], ",", 
                      FractionBox["1", "2"]}], "}"}], ",", RowBox[
                   {"{", RowBox[{"2", ",", FractionBox["1", "5"]}], "}"}]}], 
                "}"}]}], "}"}]}], "]"}], ";", 
      RowBox[{"sectionRows", "[", "start", "]"}]}]], "Input"], 
  Cell[BoxData[TagBox[GridBox[{{"\"check\"", "\"kind\"", "\"residual\"", 
        "\"agreement\""}, {"\"(4.3) cosine transform of 1\"", "\"exact\"", 
        "0", "\"identity\""}, {"\"(4.4) cosine transform of log z\"", 
        "\"exact\"", "0", "\"identity\""}, 
       {"\"cosine transform of log^2 z\"", "\"exact\"", "0", "\"identity\""}, 
       {"\"(4.5) at (z,z')={1, 2}\"", "\"numerical\"", 
        "0``19.852936861690747", "\"22 digits\""}, 
       {"\"(4.5) at (z,z')= 1  1\\n{-, -}\\n 2  2\"", "\"numerical\"", 
        "0``19.469555312990135", "\"22 digits\""}, 
       {"\"(4.5) at (z,z')=    1\\n{2, -}\\n    5\"", "\"numerical\"", 
        "0``19.947396813255576", "\"22 digits\""}}, GridBoxAlignment -> 
       {"Columns" -> {{Left}}}, AutoDelete -> False, 
      GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
      GridBoxItemSize -> {"Columns" -> {{Automatic}}, 
        "Rows" -> {{Automatic}}}], "Grid"]], "Output"], 
  Cell["3. Section 4.1.1", "Section"], Cell["The s integral of log^2 s over \
(alpha s + beta)^2 equals -2/(alpha beta) Li2(-alpha/beta) for beta > 0 and \
alpha > -beta, including a negative alpha. Equation (4.8) is the inversion \
formula. The quadrature of (4.6) splits at s = 1 and maps s > 1 to (0,1) by s \
-> 1/s, which is the step leading to the integral on (0,1). Equation (4.9) is \
checked against both, including the point (0.8, 1.5, 2.5) where k is above \
both a and b.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"start", "=", 
        RowBox[{RowBox[{"Length", "[", "checks", "]"}], "+", "1"}]}], ";", 
      RowBox[{"sIntegral", "=", RowBox[{"Integrate", "[", 
          RowBox[{FractionBox[SuperscriptBox[RowBox[{"Log", "[", "s", "]"}], 
              "2"], SuperscriptBox[RowBox[{"(", RowBox[{RowBox[{"al", " ", 
                    "s"}], "+", "be"}], ")"}], "2"]], ",", 
            RowBox[{"{", RowBox[{"s", ",", "0", ",", "1"}], "}"}], ",", 
            RowBox[{"Assumptions", "\[Rule]", RowBox[{RowBox[{"be", ">", 
                  "0"}], "&&", RowBox[{"al", ">", RowBox[{"-", "be"}]}], 
                "&&", RowBox[{"al", "\[NotEqual]", "0"}]}]}]}], "]"}]}], ";", 
      RowBox[{"checkExact", "[", RowBox[{"\"log^2 integral on (0,1)\"", ",", 
          RowBox[{"FullSimplify", "[", RowBox[{RowBox[{"sIntegral", "+", 
                FractionBox[RowBox[{"2", " ", RowBox[{"PolyLog", "[", 
                     RowBox[{"2", ",", RowBox[{"-", FractionBox["al", 
                          "be"]}]}], "]"}]}], RowBox[{"al", " ", "be"}]]}], 
              ",", RowBox[{"Assumptions", "\[Rule]", RowBox[
                 {RowBox[{"be", ">", "0"}], "&&", RowBox[{"al", ">", 
                    RowBox[{"-", "be"}]}], "&&", RowBox[{"al", "\[NotEqual]", 
                    "0"}]}]}]}], "]"}]}], "]"}], ";", 
      RowBox[{"checkNumerical", "[", RowBox[
         {"\"log^2 integral at negative alpha\"", ",", 
          RowBox[{"NIntegrate", "[", RowBox[{FractionBox[SuperscriptBox[
                RowBox[{"Log", "[", "s", "]"}], "2"], SuperscriptBox[
                RowBox[{"(", RowBox[{RowBox[{"-", FractionBox[RowBox[
                        {"3", " ", "s"}], "5"]}], "+", FractionBox["7", 
                     "4"]}], ")"}], "2"]], ",", RowBox[{"{", RowBox[
                 {"s", ",", "0", ",", "1"}], "}"}], ",", RowBox[{
                "WorkingPrecision", "\[Rule]", "30"}], ",", 
              RowBox[{"PrecisionGoal", "\[Rule]", "18"}], ",", 
              RowBox[{"Method", "\[Rule]", RowBox[{"{", RowBox[
                   {"\"GlobalAdaptive\"", ",", RowBox[
                     {"\"SymbolicProcessing\"", "\[Rule]", "0"}]}], 
                  "}"}]}]}], "]"}], ",", FractionBox[
           RowBox[{RowBox[{"-", "2"}], " ", RowBox[{"PolyLog", "[", RowBox[
                {"2", ",", RowBox[{"-", FractionBox[RowBox[{"-", "3"}], 
                    FractionBox[RowBox[{"5", " ", "7"}], "4"]]}]}], "]"}]}], 
           RowBox[{"-", FractionBox[RowBox[{"3", " ", "7"}], RowBox[{"5", 
                " ", "4"}]]}]], ",", "18"}], "]"}], ";", 
      RowBox[{"inv", "=", RowBox[{RowBox[{"PolyLog", "[", 
            RowBox[{"2", ",", "w"}], "]"}], "+", RowBox[{"PolyLog", "[", 
            RowBox[{"2", ",", FractionBox["1", "w"]}], "]"}], "+", 
          FractionBox[SuperscriptBox["\[Pi]", "2"], "6"], "+", 
          RowBox[{FractionBox["1", "2"], " ", SuperscriptBox[
             RowBox[{"Log", "[", RowBox[{"-", "w"}], "]"}], "2"]}]}]}], ";", 
      RowBox[{"checkExact", "[", RowBox[
         {"\"(4.8) derivative vanishes for w < 0\"", ",", 
          RowBox[{"FullSimplify", "[", RowBox[{RowBox[{SubscriptBox[
                 "\[PartialD]", RowBox[{"w"}]], "inv"}], ",", 
              RowBox[{"Assumptions", "\[Rule]", RowBox[{"w", "<", "0"}]}]}], 
            "]"}]}], "]"}], ";", RowBox[{"checkExact", "[", 
        RowBox[{"\"(4.8) holds at w = -1\"", ",", 
          RowBox[{"inv", "/.", "\[VeryThinSpace]", RowBox[{"w", "\[Rule]", 
              RowBox[{"-", "1"}]}]}]}], "]"}], ";", 
      RowBox[{RowBox[{"zzClosed", "[", RowBox[{"u_", ",", "v_", ",", "t_"}], 
          "]"}], ":=", FractionBox[RowBox[{SuperscriptBox["\[Pi]", "3"], " ", 
           RowBox[{"(", RowBox[{RowBox[{"-", FractionBox[RowBox[{"PolyLog", 
                    "[", RowBox[{"2", ",", RowBox[{"-", FractionBox[RowBox[
                          {"u", "-", "t"}], RowBox[{"v", "+", "t"}]]}]}], 
                    "]"}], RowBox[{RowBox[{"(", RowBox[{"u", "-", "t"}], 
                      ")"}], " ", RowBox[{"(", RowBox[{"v", "+", "t"}], 
                      ")"}]}]]}], "-", FractionBox[RowBox[{"PolyLog", "[", 
                  RowBox[{"2", ",", RowBox[{"-", FractionBox[RowBox[{"v", 
                         "-", "t"}], RowBox[{"u", "+", "t"}]]}]}], "]"}], 
                RowBox[{RowBox[{"(", RowBox[{"u", "+", "t"}], ")"}], " ", 
                  RowBox[{"(", RowBox[{"v", "-", "t"}], ")"}]}]], "+", 
               FractionBox[RowBox[{RowBox[{FractionBox["1", "2"], " ", 
                    SuperscriptBox[RowBox[{"Log", "[", FractionBox[RowBox[
                         {"u", "+", "t"}], RowBox[{"v", "+", "t"}]], "]"}], 
                     "2"]}], "+", FractionBox[SuperscriptBox["\[Pi]", "2"], 
                   "6"]}], RowBox[{RowBox[{"(", RowBox[{"u", "+", "t"}], 
                    ")"}], " ", RowBox[{"(", RowBox[{"v", "+", "t"}], 
                    ")"}]}]]}], ")"}]}], "t"]}], ";", 
      RowBox[{RowBox[{"onUnit", "[", "g_", "]"}], ":=", 
        RowBox[{"NIntegrate", "[", RowBox[{"g", ",", 
            RowBox[{"{", RowBox[{"s", ",", "0", ",", "1"}], "}"}], ",", 
            RowBox[{"WorkingPrecision", "\[Rule]", "22"}], ",", 
            RowBox[{"PrecisionGoal", "\[Rule]", "14"}], ",", 
            RowBox[{"MaxRecursion", "\[Rule]", "15"}], ",", 
            RowBox[{"Method", "\[Rule]", RowBox[{"{", RowBox[
                 {"\"DoubleExponential\"", ",", RowBox[
                   {"\"SymbolicProcessing\"", "\[Rule]", "0"}]}], "}"}]}]}], 
          "]"}]}], ";", RowBox[{RowBox[{"zzFromS", "[", 
          RowBox[{"u_", ",", "v_", ",", "t_"}], "]"}], ":=", 
        FractionBox[RowBox[{SuperscriptBox["\[Pi]", "3"], " ", 
           RowBox[{"(", RowBox[{RowBox[{"onUnit", "[", RowBox[
                  {SuperscriptBox[RowBox[{"Log", "[", "s", "]"}], "2"], " ", 
                   RowBox[{"(", RowBox[{FractionBox["1", SuperscriptBox[
                         RowBox[{"(", RowBox[{RowBox[{RowBox[{"(", RowBox[
                          {"u", "-", "t"}], ")"}], " ", "s"}], "+", "v", "+", 
                          "t"}], ")"}], "2"]], "+", FractionBox["1", 
                        SuperscriptBox[RowBox[{"(", RowBox[{RowBox[{RowBox[
                          {"(", RowBox[{"u", "+", "t"}], ")"}], " ", "s"}], 
                          "+", "v", "+", "t"}], ")"}], "2"]]}], ")"}]}], 
                 "]"}], "+", RowBox[{"onUnit", "[", RowBox[{SuperscriptBox[
                    RowBox[{"Log", "[", "s", "]"}], "2"], " ", RowBox[
                    {"(", RowBox[{FractionBox["1", SuperscriptBox[RowBox[
                          {"(", RowBox[{RowBox[{"(", RowBox[{"u", "+", "t"}], 
                          ")"}], "+", RowBox[{RowBox[{"(", RowBox[{"v", "-", 
                          "t"}], ")"}], " ", "s"}]}], ")"}], "2"]], "+", 
                       FractionBox["1", SuperscriptBox[RowBox[{"(", RowBox[
                          {RowBox[{"(", RowBox[{"u", "+", "t"}], ")"}], "+", 
                          RowBox[{RowBox[{"(", RowBox[{"v", "+", "t"}], 
                          ")"}], " ", "s"}]}], ")"}], "2"]]}], ")"}]}], 
                 "]"}]}], ")"}]}], RowBox[{"2", " ", "t"}]]}], ";", 
      RowBox[{RowBox[{"zzFrom01", "[", RowBox[{"u_", ",", "v_", ",", "t_"}], 
          "]"}], ":=", FractionBox[RowBox[{SuperscriptBox["\[Pi]", "3"], " ", 
           RowBox[{"onUnit", "[", RowBox[{SuperscriptBox[RowBox[{"Log", "[", 
                  "s", "]"}], "2"], " ", RowBox[{"(", RowBox[{FractionBox[
                    "1", SuperscriptBox[RowBox[{"(", RowBox[{RowBox[
                          {RowBox[{"(", RowBox[{"u", "-", "t"}], ")"}], " ", 
                          "s"}], "+", "v", "+", "t"}], ")"}], "2"]], "+", 
                   FractionBox["1", SuperscriptBox[RowBox[{"(", RowBox[
                        {RowBox[{RowBox[{"(", RowBox[{"v", "-", "t"}], ")"}], 
                          " ", "s"}], "+", "u", "+", "t"}], ")"}], "2"]], 
                   "+", FractionBox["1", SuperscriptBox[RowBox[{"(", 
                       RowBox[{RowBox[{RowBox[{"(", RowBox[{"u", "+", "t"}], 
                          ")"}], " ", "s"}], "+", "v", "+", "t"}], ")"}], 
                     "2"]], "+", FractionBox["1", SuperscriptBox[RowBox[
                      {"(", RowBox[{RowBox[{RowBox[{"(", RowBox[{"v", "+", 
                          "t"}], ")"}], " ", "s"}], "+", "u", "+", "t"}], 
                       ")"}], "2"]]}], ")"}]}], "]"}]}], 
         RowBox[{"2", " ", "t"}]]}], ";", 
      RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{"checkNumerical", "[", 
              RowBox[{RowBox[{"\"(4.9) against (4.6) at \"", "<>", 
                  RowBox[{"ToString", "[", RowBox[{"N", "[", RowBox[{"pt", 
                        ",", "2"}], "]"}], "]"}]}], ",", RowBox[{"zzClosed", 
                  "@@", "pt"}], ",", RowBox[{"zzFromS", "@@", "pt"}], ",", 
                "12"}], "]"}], ";", RowBox[{"checkNumerical", "[", 
              RowBox[{RowBox[{"\"(4.9) against the (0,1) form at \"", "<>", 
                  RowBox[{"ToString", "[", RowBox[{"N", "[", RowBox[{"pt", 
                        ",", "2"}], "]"}], "]"}]}], ",", RowBox[{"zzClosed", 
                  "@@", "pt"}], ",", RowBox[{"zzFrom01", "@@", "pt"}], ",", 
                "12"}], "]"}], ";"}], ",", RowBox[
           {"{", RowBox[{"pt", ",", RowBox[{"{", RowBox[{RowBox[{"{", 
                    RowBox[{FractionBox["13", "10"], ",", FractionBox["17", 
                       "10"], ",", FractionBox["7", "10"]}], "}"}], ",", 
                  RowBox[{"{", RowBox[{FractionBox["4", "5"], ",", 
                      FractionBox["3", "2"], ",", FractionBox["5", "2"]}], 
                    "}"}]}], "}"}]}], "}"}]}], "]"}], ";", 
      RowBox[{"checkNumerical", "[", RowBox[
         {"\"(4.9) benchmark (1.3, 1.7, 0.7)\"", ",", 
          RowBox[{"zzClosed", "[", RowBox[{FractionBox["13", "10"], ",", 
              FractionBox["17", "10"], ",", FractionBox["7", "10"]}], "]"}], 
          ",", RowBox[{"bench", "[", "\"32.52044480074924921207\"", "]"}], 
          ",", "18"}], "]"}], ";", RowBox[{"checkNumerical", "[", 
        RowBox[{"\"(4.9) benchmark (0.8, 1.5, 2.5)\"", ",", 
          RowBox[{"zzClosed", "[", RowBox[{FractionBox["4", "5"], ",", 
              FractionBox["3", "2"], ",", FractionBox["5", "2"]}], "]"}], 
          ",", RowBox[{"bench", "[", "\"3.680440979012054311524\"", "]"}], 
          ",", "18"}], "]"}], ";", RowBox[{"sectionRows", "[", "start", 
        "]"}]}]], "Input"], 
  Cell[BoxData[TagBox[GridBox[{{"\"check\"", "\"kind\"", "\"residual\"", 
        "\"agreement\""}, {"\"log^2 integral on (0,1)\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"log^2 integral at negative alpha\"", 
        "\"numerical\"", "0``27.841825085775934", "\"28 digits\""}, 
       {"\"(4.8) derivative vanishes for w < 0\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"(4.8) holds at w = -1\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"(4.9) against (4.6) at {1.3, 1.7, 0.70}\"", 
        "\"numerical\"", "0``20.186813527279", "\"22 digits\""}, 
       {"\"(4.9) against the (0,1) form at {1.3, 1.7, 0.70}\"", 
        "\"numerical\"", "0``20.186813527279", "\"22 digits\""}, 
       {"\"(4.9) against (4.6) at {0.80, 1.5, 2.5}\"", "\"numerical\"", 
        "0``21.13307014672833", "\"22 digits\""}, 
       {"\"(4.9) against the (0,1) form at {0.80, 1.5, 2.5}\"", 
        "\"numerical\"", "0``21.13307014672833", "\"22 digits\""}, 
       {"\"(4.9) benchmark (1.3, 1.7, 0.7)\"", "\"numerical\"", 
        RowBox[{"-", "9.8934257535058075`5.182160226179482*^-22"}], 
        "\"22 digits\""}, {"\"(4.9) benchmark (0.8, 1.5, 2.5)\"", 
        "\"numerical\"", RowBox[{"-", 
          "4.1664975514121969`5.752841277661749*^-22"}], "\"21 digits\""}}, 
      GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
      GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
      GridBoxItemSize -> {"Columns" -> {{Automatic}}, 
        "Rows" -> {{Automatic}}}], "Grid"]], "Output"], 
  Cell["4. Section 4.1.2", "Section"], Cell["After the external times are \
integrated, the terms with Euler's constant in 2 times (4.11) and in (4.13) \
have the same integrand, so they cancel in 2[Z1 P Pdot] - [Pdot Z P]. The \
cell compares those integrands before the cancellation is used.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"start", "=", 
        RowBox[{RowBox[{"Length", "[", "checks", "]"}], "+", "1"}]}], ";", 
      RowBox[{"gammaFromC", "=", FractionBox[
         RowBox[{"2", " ", RowBox[{"(", RowBox[{RowBox[{"-", SuperscriptBox[
                  "\[Pi]", "2"]}], " ", "b", " ", RowBox[{"Log", "[", 
                 RowBox[{SuperscriptBox["p", "2"], "+", SuperscriptBox["k", 
                    "2"]}], "]"}], " ", "EulerGamma", " ", RowBox[
                {"Re", "[", FractionBox["1", RowBox[{"a", "-", RowBox[
                     {"\[ImaginaryI]", " ", "p"}]}]], "]"}]}], ")"}]}], 
         RowBox[{RowBox[{"(", RowBox[{SuperscriptBox["p", "2"], "+", 
               SuperscriptBox["k", "2"]}], ")"}], " ", 
           RowBox[{"(", RowBox[{SuperscriptBox["p", "2"], "+", SuperscriptBox[
                "b", "2"]}], ")"}]}]]}], ";", 
      RowBox[{"gammaFromD", "=", RowBox[{"-", FractionBox[
           RowBox[{"2", " ", SuperscriptBox["\[Pi]", "2"], " ", "b", " ", 
             RowBox[{"Log", "[", RowBox[{SuperscriptBox["p", "2"], "+", 
                 SuperscriptBox["k", "2"]}], "]"}], " ", 
             RowBox[{"Re", "[", RowBox[{FractionBox[RowBox[{"a", " ", 
                    "EulerGamma"}], RowBox[{"k", "-", RowBox[
                     {"\[ImaginaryI]", " ", "p"}]}]], "-", FractionBox[
                  RowBox[{"k", " ", "EulerGamma"}], RowBox[{"a", "-", 
                    RowBox[{"\[ImaginaryI]", " ", "p"}]}]]}], "]"}]}], 
           RowBox[{RowBox[{"(", RowBox[{"k", " ", RowBox[{"(", RowBox[
                    {SuperscriptBox["a", "2"], "-", SuperscriptBox["k", 
                      "2"]}], ")"}]}], ")"}], " ", RowBox[{"(", RowBox[
                {SuperscriptBox["p", "2"], "+", SuperscriptBox["b", "2"]}], 
               ")"}]}]]}]}], ";", RowBox[{"checkExact", "[", 
        RowBox[{"\"Euler terms of 2 x (4.11) and (4.13)\"", ",", 
          RowBox[{"Together", "[", RowBox[{"ComplexExpand", "[", 
              RowBox[{RowBox[{"gammaFromC", "-", "gammaFromD"}], ",", 
                RowBox[{"TargetFunctions", "\[Rule]", RowBox[{"{", 
                    RowBox[{"Re", ",", "Im"}], "}"}]}]}], "]"}], "]"}]}], 
        "]"}], ";", RowBox[{"sectionRows", "[", "start", "]"}]}]], "Input"], 
  Cell[BoxData[TagBox[GridBox[{{"\"check\"", "\"kind\"", "\"residual\"", 
        "\"agreement\""}, {"\"Euler terms of 2 x (4.11) and (4.13)\"", 
        "\"exact\"", "0", "\"identity\""}}, GridBoxAlignment -> 
       {"Columns" -> {{Left}}}, AutoDelete -> False, 
      GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
      GridBoxItemSize -> {"Columns" -> {{Automatic}}, 
        "Rows" -> {{Automatic}}}], "Grid"]], "Output"], 
  Cell["5. Section 4.1.3", "Section"], Cell["Re[Log[c - I p]/(c - I p)] is \
kept as a symbol R[c]. The cell checks that 2 times (4.11) minus (4.13), \
without the Euler terms, has the integrand on the right-hand side of (4.14). \
Integrate, after Apart, gives (4.17) up to a k-independent term. The \
k-derivative of (4.18) is (4.16), and (4.17) plus the constant fixed at large \
k is (4.18). Quadrature of (4.15) includes b = k, a = k, and k above both a \
and b. The subtracted large-k growth of Q/Pi tends to 0.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"start", "=", 
        RowBox[{RowBox[{"Length", "[", "checks", "]"}], "+", "1"}]}], ";", 
      RowBox[{RowBox[{"Qh", "[", RowBox[{"u_", ",", "v_", ",", "t_"}], "]"}], 
        ":=", RowBox[{FractionBox[RowBox[{RowBox[{"PolyLog", "[", RowBox[
                {"2", ",", FractionBox[RowBox[{"v", "-", "t"}], RowBox[
                   {"u", "+", "v"}]]}], "]"}], "+", RowBox[{FractionBox["1", 
                "2"], " ", SuperscriptBox[RowBox[{"Log", "[", RowBox[
                   {RowBox[{"(", RowBox[{"u", "+", "v"}], ")"}], " ", 
                    RowBox[{"(", RowBox[{"v", "+", "t"}], ")"}]}], "]"}], 
                "2"]}], "+", FractionBox[SuperscriptBox["\[Pi]", "2"], 
              "6"]}], RowBox[{"v", " ", RowBox[{"(", RowBox[{"u", "+", "v"}], 
               ")"}]}]], "+", FractionBox[RowBox[
            {RowBox[{"PolyLog", "[", RowBox[{"2", ",", FractionBox[
                  RowBox[{"v", "-", "u"}], RowBox[{"v", "+", "t"}]]}], "]"}], 
             "-", FractionBox[RowBox[{"v", " ", RowBox[{"(", RowBox[
                   {SuperscriptBox[RowBox[{"Log", "[", RowBox[{"u", "+", 
                         "t"}], "]"}], "2"], "-", SuperscriptBox[RowBox[
                      {"Log", "[", RowBox[{"v", "+", "t"}], "]"}], "2"]}], 
                  ")"}]}], RowBox[{"u", "+", "v"}]]}], 
           RowBox[{"v", " ", RowBox[{"(", RowBox[{"u", "-", "v"}], 
               ")"}]}]]}]}], ";", 
      RowBox[{RowBox[{"qDer", "[", RowBox[{"u_", ",", "v_", ",", "t_"}], 
          "]"}], ":=", FractionBox[RowBox[{"2", " ", "\[Pi]", " ", 
           RowBox[{"(", RowBox[{FractionBox[RowBox[{"Log", "[", RowBox[
                   {"u", "+", "t"}], "]"}], RowBox[{"u", "+", "t"}]], "-", 
               FractionBox[RowBox[{"t", " ", RowBox[{"Log", "[", RowBox[
                     {"u", "+", "v"}], "]"}]}], RowBox[{"v", " ", 
                  RowBox[{"(", RowBox[{"u", "+", "v"}], ")"}]}]]}], ")"}]}], 
         RowBox[{SuperscriptBox["v", "2"], "-", SuperscriptBox["t", 
            "2"]}]]}], ";", RowBox[
       {RowBox[{"qPrim", "[", RowBox[{"u_", ",", "v_", ",", "t_"}], "]"}], 
        ":=", RowBox[{FractionBox[RowBox[{RowBox[{"PolyLog", "[", RowBox[
                {"2", ",", FractionBox[RowBox[{"v", "-", "t"}], RowBox[
                   {"u", "+", "v"}]]}], "]"}], "+", 
             RowBox[{RowBox[{"Log", "[", RowBox[{"u", "+", "v"}], "]"}], " ", 
               RowBox[{"Log", "[", RowBox[{"v", "+", "t"}], "]"}]}]}], 
           RowBox[{"v", " ", RowBox[{"(", RowBox[{"u", "+", "v"}], ")"}]}]], 
          "+", FractionBox[RowBox[{RowBox[{"PolyLog", "[", RowBox[
                {"2", ",", FractionBox[RowBox[{"v", "-", "u"}], RowBox[
                   {"v", "+", "t"}]]}], "]"}], "+", RowBox[{FractionBox["1", 
                "2"], " ", SuperscriptBox[RowBox[{"Log", "[", RowBox[
                   {"v", "+", "t"}], "]"}], "2"]}]}], 
           RowBox[{"v", " ", RowBox[{"(", RowBox[{"u", "-", "v"}], ")"}]}]], 
          "-", FractionBox[SuperscriptBox[RowBox[{"Log", "[", 
              RowBox[{"u", "+", "t"}], "]"}], "2"], 
           RowBox[{RowBox[{"(", RowBox[{"u", "-", "v"}], ")"}], " ", 
             RowBox[{"(", RowBox[{"u", "+", "v"}], ")"}]}]]}]}], ";", 
      RowBox[{RowBox[{"qConst", "[", RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
        FractionBox[RowBox[{FractionBox[SuperscriptBox["\[Pi]", "2"], "6"], 
           "+", RowBox[{FractionBox["1", "2"], " ", SuperscriptBox[
              RowBox[{"Log", "[", RowBox[{"u", "+", "v"}], "]"}], "2"]}]}], 
         RowBox[{"v", " ", RowBox[{"(", RowBox[{"u", "+", "v"}], ")"}]}]]}], 
      ";", RowBox[{"logP", "=", RowBox[{"Log", "[", 
          RowBox[{SuperscriptBox["p", "2"], "+", SuperscriptBox["k", "2"]}], 
          "]"}]}], ";", RowBox[{"integrandC", "=", 
        RowBox[{"-", FractionBox[RowBox[{SuperscriptBox["\[Pi]", "2"], " ", 
             "b", " ", "logP", " ", RowBox[{"R", "[", "a", "]"}]}], 
           RowBox[{RowBox[{"(", RowBox[{SuperscriptBox["p", "2"], "+", 
                 SuperscriptBox["k", "2"]}], ")"}], " ", 
             RowBox[{"(", RowBox[{SuperscriptBox["p", "2"], "+", 
                 SuperscriptBox["b", "2"]}], ")"}]}]]}]}], ";", 
      RowBox[{"integrandD", "=", RowBox[{"-", FractionBox[
           RowBox[{"2", " ", SuperscriptBox["\[Pi]", "2"], " ", "b", " ", 
             "logP", " ", RowBox[{"(", RowBox[{RowBox[{"a", " ", RowBox[
                    {"R", "[", "k", "]"}]}], "-", RowBox[{"k", " ", 
                   RowBox[{"R", "[", "a", "]"}]}]}], ")"}]}], 
           RowBox[{RowBox[{"(", RowBox[{"k", " ", RowBox[{"(", RowBox[
                    {SuperscriptBox["a", "2"], "-", SuperscriptBox["k", 
                      "2"]}], ")"}]}], ")"}], " ", RowBox[{"(", RowBox[
                {SuperscriptBox["p", "2"], "+", SuperscriptBox["b", "2"]}], 
               ")"}]}]]}]}], ";", RowBox[{"rhsQ", "=", 
        RowBox[{"2", " ", SuperscriptBox["\[Pi]", "2"], " ", "b", " ", 
          "logP", " ", RowBox[{"(", RowBox[{FractionBox[RowBox[
                {FractionBox[RowBox[{"R", "[", "a", "]"}], RowBox[
                   {SuperscriptBox["p", "2"], "+", SuperscriptBox["b", 
                     "2"]}]], "-", FractionBox[RowBox[{"R", "[", "a", "]"}], 
                  RowBox[{SuperscriptBox["p", "2"], "+", SuperscriptBox["k", 
                     "2"]}]]}], RowBox[{SuperscriptBox["b", "2"], "-", 
                 SuperscriptBox["k", "2"]}]], "-", FractionBox[RowBox[
                {FractionBox[RowBox[{"k", " ", RowBox[{"R", "[", "a", 
                      "]"}]}], RowBox[{SuperscriptBox["p", "2"], "+", 
                    SuperscriptBox["b", "2"]}]], "-", FractionBox[
                  RowBox[{"a", " ", RowBox[{"R", "[", "k", "]"}]}], 
                  RowBox[{SuperscriptBox["p", "2"], "+", SuperscriptBox["b", 
                     "2"]}]]}], RowBox[{"k", " ", RowBox[{"(", RowBox[
                    {SuperscriptBox["a", "2"], "-", SuperscriptBox["k", 
                      "2"]}], ")"}]}]]}], ")"}]}]}], ";", 
      RowBox[{"checkExact", "[", RowBox[{"\"(4.14) integrand identity\"", 
          ",", RowBox[{"Together", "[", RowBox[{RowBox[{"(", RowBox[
                 {RowBox[{"2", " ", "integrandC"}], "-", "integrandD"}], 
                ")"}], "-", "rhsQ"}], "]"}]}], "]"}], ";", 
      RowBox[{"integrated", "=", RowBox[{"Integrate", "[", 
          RowBox[{RowBox[{"Apart", "[", RowBox[{RowBox[{"qDer", "[", 
                  RowBox[{"a", ",", "b", ",", "k"}], "]"}], ",", "k"}], 
              "]"}], ",", "k", ",", RowBox[{"Assumptions", "\[Rule]", 
              RowBox[{RowBox[{"a", ">", "0"}], "&&", RowBox[{"b", ">", "0"}], 
                "&&", RowBox[{"a", "\[NotEqual]", "b"}]}]}]}], "]"}]}], ";", 
      RowBox[{"checkExact", "[", RowBox[{"\"(4.16) integrates to (4.17)\"", 
          ",", RowBox[{"FullSimplify", "[", RowBox[
             {RowBox[{SubscriptBox["\[PartialD]", RowBox[{"k"}]], 
                RowBox[{"(", RowBox[{"integrated", "-", RowBox[{"\[Pi]", " ", 
                      RowBox[{"qPrim", "[", RowBox[{"a", ",", "b", ",", 
                          "k"}], "]"}]}]}], ")"}]}], ",", 
              RowBox[{"Assumptions", "\[Rule]", RowBox[{RowBox[{"a", ">", 
                    "0"}], "&&", RowBox[{"b", ">", "0"}], "&&", RowBox[
                   {"a", "\[NotEqual]", "b"}]}]}]}], "]"}]}], "]"}], ";", 
      RowBox[{"checkExact", "[", RowBox[
         {"\"k-derivative of (4.18) is (4.16)\"", ",", 
          RowBox[{"FullSimplify", "[", RowBox[{RowBox[{RowBox[
                 {SubscriptBox["\[PartialD]", RowBox[{"k"}]], RowBox[
                   {"(", RowBox[{"\[Pi]", " ", RowBox[{"Qh", "[", RowBox[
                         {"a", ",", "b", ",", "k"}], "]"}]}], ")"}]}], "-", 
                RowBox[{"qDer", "[", RowBox[{"a", ",", "b", ",", "k"}], 
                  "]"}]}], ",", RowBox[{"Assumptions", "\[Rule]", 
                RowBox[{RowBox[{"a", ">", "0"}], "&&", RowBox[{"b", ">", 
                    "0"}], "&&", RowBox[{"k", ">", "0"}], "&&", RowBox[
                   {"a", "\[NotEqual]", "b"}], "&&", RowBox[{"a", 
                    "\[NotEqual]", "k"}], "&&", RowBox[{"b", "\[NotEqual]", 
                    "k"}]}]}]}], "]"}]}], "]"}], ";", 
      RowBox[{"checkExact", "[", RowBox[
         {"\"(4.17) plus the constant is (4.18)\"", ",", 
          RowBox[{"FullSimplify", "[", RowBox[{RowBox[{RowBox[{"Qh", "[", 
                  RowBox[{"a", ",", "b", ",", "k"}], "]"}], "-", 
                RowBox[{"qPrim", "[", RowBox[{"a", ",", "b", ",", "k"}], 
                  "]"}], "-", RowBox[{"qConst", "[", RowBox[{"a", ",", "b"}], 
                  "]"}]}], ",", RowBox[{"Assumptions", "\[Rule]", 
                RowBox[{RowBox[{"a", ">", "0"}], "&&", RowBox[{"b", ">", 
                    "0"}], "&&", RowBox[{"k", ">", "0"}], "&&", RowBox[
                   {"a", "\[NotEqual]", "b"}]}]}]}], "]"}]}], "]"}], ";", 
      RowBox[{RowBox[{"qIntegral", "[", RowBox[{"u_", ",", "v_", ",", "t_"}], 
          "]"}], ":=", RowBox[{"2", " ", RowBox[{"NIntegrate", "[", 
            RowBox[{FractionBox[RowBox[{RowBox[{"Log", "[", RowBox[
                    {SuperscriptBox["p", "2"], "+", SuperscriptBox["t", 
                      "2"]}], "]"}], " ", RowBox[{"Re", "[", FractionBox[
                    RowBox[{"Log", "[", RowBox[{"u", "-", RowBox[
                         {"\[ImaginaryI]", " ", "p"}]}], "]"}], RowBox[
                     {"u", "-", RowBox[{"\[ImaginaryI]", " ", "p"}]}]], 
                   "]"}]}], RowBox[{SuperscriptBox["p", "2"], "+", 
                 SuperscriptBox["v", "2"]}]], ",", RowBox[{"{", 
                RowBox[{"p", ",", "0", ",", "1", ",", "10", ",", 
                  "\[Infinity]"}], "}"}], ",", RowBox[{"WorkingPrecision", 
                "\[Rule]", "24"}], ",", RowBox[{"PrecisionGoal", "\[Rule]", 
                "14"}], ",", RowBox[{"MaxRecursion", "\[Rule]", "25"}], ",", 
              RowBox[{"Method", "\[Rule]", RowBox[{"{", RowBox[
                   {"\"GlobalAdaptive\"", ",", RowBox[
                     {"\"SymbolicProcessing\"", "\[Rule]", "0"}]}], 
                  "}"}]}]}], "]"}]}]}], ";", 
      RowBox[{"Do", "[", RowBox[{RowBox[{"checkNumerical", "[", 
            RowBox[{RowBox[{"\"(4.18) against (4.15) at \"", "<>", 
                RowBox[{"ToString", "[", RowBox[{"N", "[", RowBox[{"pt", ",", 
                      "2"}], "]"}], "]"}]}], ",", RowBox[{"\[Pi]", " ", 
                RowBox[{"Qh", "@@", "pt"}]}], ",", RowBox[{"qIntegral", "@@", 
                "pt"}], ",", "12"}], "]"}], ",", 
          RowBox[{"{", RowBox[{"pt", ",", RowBox[{"{", RowBox[
                 {RowBox[{"{", RowBox[{FractionBox["13", "10"], ",", 
                      FractionBox["17", "10"], ",", FractionBox["7", "10"]}], 
                    "}"}], ",", RowBox[{"{", RowBox[{FractionBox["13", "10"], 
                      ",", FractionBox["7", "10"], ",", FractionBox["7", 
                       "10"]}], "}"}], ",", RowBox[{"{", RowBox[{FractionBox[
                       "7", "10"], ",", FractionBox["17", "10"], ",", 
                      FractionBox["7", "10"]}], "}"}], ",", RowBox[
                   {"{", RowBox[{FractionBox["1", "2"], ",", FractionBox["4", 
                       "5"], ",", "3"}], "}"}], ",", RowBox[{"{", RowBox[
                     {FractionBox["4", "5"], ",", FractionBox["3", "2"], ",", 
                      FractionBox["5", "2"]}], "}"}]}], "}"}]}], "}"}]}], 
        "]"}], ";", RowBox[{"checkNumerical", "[", 
        RowBox[{"\"Q benchmark (1.3, 1.7, 0.7)\"", ",", 
          RowBox[{"\[Pi]", " ", RowBox[{"Qh", "[", RowBox[{FractionBox["13", 
                 "10"], ",", FractionBox["17", "10"], ",", FractionBox["7", 
                 "10"]}], "]"}]}], ",", RowBox[{"bench", "[", 
            "\"0.8857014652289425316587\"", "]"}], ",", "18"}], "]"}], ";", 
      RowBox[{"checkNumerical", "[", RowBox[
         {"\"Q benchmark (0.8, 1.5, 2.5)\"", ",", 
          RowBox[{"\[Pi]", " ", RowBox[{"Qh", "[", RowBox[{FractionBox["4", 
                 "5"], ",", FractionBox["3", "2"], ",", FractionBox["5", 
                 "2"]}], "]"}]}], ",", RowBox[{"bench", "[", 
            "\"1.863559683929656771766\"", "]"}], ",", "18"}], "]"}], ";", 
      RowBox[{"checkExact", "[", RowBox[{"\"large-k limit of Q/Pi\"", ",", 
          RowBox[{"Limit", "[", RowBox[{RowBox[{RowBox[{"Qh", "[", 
                  RowBox[{"a", ",", "b", ",", "k"}], "]"}], "-", 
                FractionBox[RowBox[{"2", " ", RowBox[{"Log", "[", "k", "]"}], 
                   " ", RowBox[{"Log", "[", RowBox[{"a", "+", "b"}], "]"}]}], 
                 RowBox[{"b", " ", RowBox[{"(", RowBox[{"a", "+", "b"}], 
                     ")"}]}]]}], ",", RowBox[{"k", "\[Rule]", 
                "\[Infinity]"}], ",", RowBox[{"Assumptions", "\[Rule]", 
                RowBox[{RowBox[{"a", ">", "0"}], "&&", RowBox[{"b", ">", 
                    "0"}], "&&", RowBox[{"a", "\[NotEqual]", "b"}]}]}]}], 
            "]"}]}], "]"}], ";", RowBox[{"sectionRows", "[", "start", 
        "]"}]}]], "Input"], 
  Cell[BoxData[TagBox[GridBox[{{"\"check\"", "\"kind\"", "\"residual\"", 
        "\"agreement\""}, {"\"(4.14) integrand identity\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"(4.16) integrates to (4.17)\"", "\"exact\"", 
        "0", "\"identity\""}, {"\"k-derivative of (4.18) is (4.16)\"", 
        "\"exact\"", "0", "\"identity\""}, 
       {"\"(4.17) plus the constant is (4.18)\"", "\"exact\"", "0", 
        "\"identity\""}, {"\"(4.18) against (4.15) at {1.3, 1.7, 0.70}\"", 
        "\"numerical\"", "0``21.75168264119789", "\"22 digits\""}, 
       {"\"(4.18) against (4.15) at {1.3, 0.70, 0.70}\"", "\"numerical\"", 
        "0``21.697233365847243", "\"22 digits\""}, 
       {"\"(4.18) against (4.15) at {0.70, 1.7, 0.70}\"", "\"numerical\"", 
        "0``21.663771303032505", "\"22 digits\""}, 
       {"\"(4.18) against (4.15) at {0.50, 0.80, 3.0}\"", "\"numerical\"", 
        "0``21.348584275870767", "\"22 digits\""}, 
       {"\"(4.18) against (4.15) at {0.80, 1.5, 2.5}\"", "\"numerical\"", 
        "0``21.42862669794311", "\"22 digits\""}, 
       {"\"Q benchmark (1.3, 1.7, 0.7)\"", "\"numerical\"", 
        RowBox[{"-", "2.163028214697234`5.086744825642712*^-23"}], 
        "\"22 digits\""}, {"\"Q benchmark (0.8, 1.5, 2.5)\"", 
        "\"numerical\"", RowBox[{"-", 
          "7.248273697587543`5.288861282047265*^-23"}], "\"22 digits\""}, 
       {"\"large-k limit of Q/Pi\"", "\"exact\"", "0", "\"identity\""}}, 
      GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
      GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
      GridBoxItemSize -> {"Columns" -> {{Automatic}}, 
        "Rows" -> {{Automatic}}}], "Grid"]], "Output"], 
  Cell["6. Section 4.1.4, the assembly", "Section"], 
  Cell["Qh is Q/Pi from (4.18). mom[a,b] is (4.14) with that normalization, \
and deriv = mom[a,b] + mom[b,a] - (4.9). The ten dilogarithm arguments are \
the two in (4.9), the four (a-k)/(a+b), (a-b)/(a+k), (a-k)/(a+k) and \
-(a-k)/(2k), and their images under a <-> b. Qh[a,k] contains Li2(0), which \
vanishes, and Qh[k,b] contains Li2((b-k)/(b+k)) twice. Each line of (4.20), \
and the images of the first and third, is Landen's identity (4.19): w/(w-1) \
is the dilogarithm on the right, and the squared log equals log^2(1-w). On \
the first and third lines the printed logarithm is the reciprocal of 1-w, so \
the squares agree. The two dilogarithms on the second line of (4.20) have \
equal coefficients. After those replacements, four dilogarithms remain. \
Expanding the logarithms in Log[a+k], Log[b+k], Log[a+b], Log[2] and Log[k], \
the same reduction of (4.21) leaves a zero residual, Log[a+b] drops out, and \
only the four dilogarithms of (4.21) remain.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"start", "=", 
        RowBox[{RowBox[{"Length", "[", "checks", "]"}], "+", "1"}]}], ";", 
      RowBox[{RowBox[{"mom", "[", RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
        RowBox[{"2", " ", SuperscriptBox["\[Pi]", "3"], " ", "v", " ", 
          RowBox[{"(", RowBox[{FractionBox[RowBox[{RowBox[{"Qh", "[", 
                   RowBox[{"u", ",", "v", ",", "k"}], "]"}], "-", 
                 RowBox[{"Qh", "[", RowBox[{"u", ",", "k", ",", "k"}], 
                   "]"}]}], RowBox[{SuperscriptBox["v", "2"], "-", 
                 SuperscriptBox["k", "2"]}]], "-", FractionBox[RowBox[
                {RowBox[{"k", " ", RowBox[{"Qh", "[", RowBox[{"u", ",", "v", 
                       ",", "k"}], "]"}]}], "-", RowBox[{"u", " ", 
                   RowBox[{"Qh", "[", RowBox[{"k", ",", "v", ",", "k"}], 
                     "]"}]}]}], RowBox[{"k", " ", RowBox[{"(", RowBox[
                    {SuperscriptBox["u", "2"], "-", SuperscriptBox["k", 
                      "2"]}], ")"}]}]]}], ")"}]}]}], ";", 
      RowBox[{"deriv", "=", RowBox[{RowBox[{"mom", "[", 
            RowBox[{"a", ",", "b"}], "]"}], "+", 
          RowBox[{"mom", "[", RowBox[{"b", ",", "a"}], "]"}], "-", 
          RowBox[{"zzClosed", "[", RowBox[{"a", ",", "b", ",", "k"}], 
            "]"}]}]}], ";", RowBox[{RowBox[{"matchArg", "[", 
          RowBox[{"z_", ",", "target_"}], "]"}], ":=", 
        RowBox[{RowBox[{"Together", "[", RowBox[{"z", "-", "target"}], "]"}], 
          "===", "0"}]}], ";", RowBox[{"canon", "=", 
        RowBox[{"Expand", "[", RowBox[{"deriv", "/.", "\[VeryThinSpace]", 
            RowBox[{RowBox[{"PolyLog", "[", RowBox[{"2", ",", "z_"}], "]"}], 
              "\[RuleDelayed]", RowBox[{"PolyLog", "[", RowBox[{"2", ",", 
                  RowBox[{"Together", "[", "z", "]"}]}], "]"}]}]}], "]"}]}], 
      ";", RowBox[{"gotArgs", "=", RowBox[{"Sort", "[", 
          RowBox[{"DeleteDuplicates", "[", RowBox[{"Cases", "[", 
              RowBox[{"canon", ",", RowBox[{RowBox[{"PolyLog", "[", 
                    RowBox[{"2", ",", "z_"}], "]"}], "\[RuleDelayed]", "z"}], 
                ",", "\[Infinity]"}], "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"wantArgs", "=", RowBox[{"Sort", "[", 
          RowBox[{"DeleteDuplicates", "[", RowBox[{"Together", "/@", 
              RowBox[{"{", RowBox[{RowBox[{"-", FractionBox[RowBox[{"a", "-", 
                       "k"}], RowBox[{"b", "+", "k"}]]}], ",", RowBox[
                   {"-", FractionBox[RowBox[{"b", "-", "k"}], RowBox[
                      {"a", "+", "k"}]]}], ",", FractionBox[RowBox[{"a", "-", 
                     "k"}], RowBox[{"a", "+", "b"}]], ",", FractionBox[
                   RowBox[{"a", "-", "b"}], RowBox[{"a", "+", "k"}]], ",", 
                  FractionBox[RowBox[{"a", "-", "k"}], RowBox[{"a", "+", 
                     "k"}]], ",", RowBox[{"-", FractionBox[RowBox[{"a", "-", 
                       "k"}], RowBox[{"2", " ", "k"}]]}], ",", FractionBox[
                   RowBox[{"b", "-", "k"}], RowBox[{"a", "+", "b"}]], ",", 
                  FractionBox[RowBox[{"b", "-", "a"}], RowBox[{"b", "+", 
                     "k"}]], ",", FractionBox[RowBox[{"b", "-", "k"}], 
                   RowBox[{"b", "+", "k"}]], ",", RowBox[{"-", FractionBox[
                     RowBox[{"b", "-", "k"}], RowBox[{"2", " ", "k"}]]}]}], 
                "}"}]}], "]"}], "]"}]}], ";", 
      RowBox[{"If", "[", RowBox[{RowBox[{"gotArgs", "=!=", "wantArgs"}], ",", 
          RowBox[{"failCheck", "[", RowBox[{"\"ten dilogarithm arguments\"", 
              ",", RowBox[{"{", RowBox[{"gotArgs", ",", "wantArgs"}], 
                "}"}]}], "]"}]}], "]"}], ";", 
      RowBox[{"checkExact", "[", RowBox[{"\"ten dilogarithm arguments\"", 
          ",", RowBox[{RowBox[{"Length", "[", "gotArgs", "]"}], "-", 
            "10"}]}], "]"}], ";", RowBox[{"checkExact", "[", 
        RowBox[{"\"Qh[a,k] first argument is 0\"", ",", 
          RowBox[{"Together", "[", RowBox[{FractionBox[RowBox[{"v", "-", 
                 "k"}], RowBox[{"u", "+", "v"}]], "/.", "\[VeryThinSpace]", 
              RowBox[{"{", RowBox[{RowBox[{"u", "\[Rule]", "a"}], ",", 
                  RowBox[{"v", "\[Rule]", "k"}]}], "}"}]}], "]"}]}], "]"}], 
      ";", RowBox[{"checkExact", "[", RowBox[{"\"PolyLog[2, 0] vanishes\"", 
          ",", RowBox[{"PolyLog", "[", RowBox[{"2", ",", "0"}], "]"}]}], 
        "]"}], ";", RowBox[{"qkbArgs", "=", RowBox[{"Cases", "[", 
          RowBox[{RowBox[{"Qh", "[", RowBox[{"k", ",", "b", ",", "k"}], 
              "]"}], ",", RowBox[{RowBox[{"PolyLog", "[", RowBox[{"2", ",", 
                  "z_"}], "]"}], "\[RuleDelayed]", RowBox[{"Together", "[", 
                "z", "]"}]}], ",", "\[Infinity]"}], "]"}]}], ";", 
      RowBox[{"checkExact", "[", RowBox[{"\"Qh[k,b] repeats (b-k)/(b+k)\"", 
          ",", RowBox[{RowBox[{"Count", "[", RowBox[{"qkbArgs", ",", 
                RowBox[{"Together", "[", FractionBox[RowBox[{"b", "-", "k"}], 
                   RowBox[{"b", "+", "k"}]], "]"}]}], "]"}], "-", "2"}]}], 
        "]"}], ";", RowBox[{"cLeft", "=", RowBox[{"Coefficient", "[", 
          RowBox[{"canon", ",", RowBox[{"PolyLog", "[", RowBox[{"2", ",", 
                RowBox[{"Together", "[", FractionBox[RowBox[{"b", "-", "a"}], 
                   RowBox[{"b", "+", "k"}]], "]"}]}], "]"}]}], "]"}]}], ";", 
      RowBox[{"cRight", "=", RowBox[{"Coefficient", "[", 
          RowBox[{"canon", ",", RowBox[{"PolyLog", "[", RowBox[{"2", ",", 
                RowBox[{"Together", "[", FractionBox[RowBox[{"a", "-", "b"}], 
                   RowBox[{"a", "+", "k"}]], "]"}]}], "]"}]}], "]"}]}], ";", 
      RowBox[{"checkExact", "[", RowBox[
         {"\"equal coefficients on the second Landen line\"", ",", 
          RowBox[{"Together", "[", RowBox[{"cLeft", "-", "cRight"}], "]"}]}], 
        "]"}], ";", RowBox[{"pairs", "=", 
        RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{FractionBox[RowBox[
                  {"a", "-", "k"}], RowBox[{"a", "+", "k"}]], ",", 
                RowBox[{"-", FractionBox[RowBox[{"a", "-", "k"}], 
                   RowBox[{"2", " ", "k"}]]}], ",", FractionBox[
                 RowBox[{"a", "+", "k"}], RowBox[{"2", " ", "k"}]]}], "}"}], 
            ",", RowBox[{"{", RowBox[{FractionBox[RowBox[{"b", "-", "k"}], 
                 RowBox[{"b", "+", "k"}]], ",", RowBox[{"-", FractionBox[
                   RowBox[{"b", "-", "k"}], RowBox[{"2", " ", "k"}]]}], ",", 
                FractionBox[RowBox[{"b", "+", "k"}], RowBox[{"2", " ", 
                   "k"}]]}], "}"}], ",", RowBox[{"{", RowBox[{FractionBox[
                 RowBox[{"b", "-", "a"}], RowBox[{"b", "+", "k"}]], ",", 
                FractionBox[RowBox[{"a", "-", "b"}], RowBox[{"a", "+", 
                   "k"}]], ",", FractionBox[RowBox[{"a", "+", "k"}], 
                 RowBox[{"b", "+", "k"}]]}], "}"}], ",", 
            RowBox[{"{", RowBox[{FractionBox[RowBox[{"a", "-", "k"}], 
                 RowBox[{"a", "+", "b"}]], ",", RowBox[{"-", FractionBox[
                   RowBox[{"a", "-", "k"}], RowBox[{"b", "+", "k"}]]}], ",", 
                FractionBox[RowBox[{"a", "+", "b"}], RowBox[{"b", "+", 
                   "k"}]]}], "}"}], ",", RowBox[{"{", RowBox[{FractionBox[
                 RowBox[{"b", "-", "k"}], RowBox[{"a", "+", "b"}]], ",", 
                RowBox[{"-", FractionBox[RowBox[{"b", "-", "k"}], 
                   RowBox[{"a", "+", "k"}]]}], ",", FractionBox[
                 RowBox[{"a", "+", "b"}], RowBox[{"a", "+", "k"}]]}], 
              "}"}]}], "}"}]}], ";", RowBox[{"Do", "[", 
        RowBox[{RowBox[{RowBox[{"ww", "=", RowBox[{"pair", 
                "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
            ";", RowBox[{"rhs", "=", RowBox[{"pair", "\[LeftDoubleBracket]", 
                "2", "\[RightDoubleBracket]"}]}], ";", 
            RowBox[{"logArg", "=", RowBox[{"pair", "\[LeftDoubleBracket]", 
                "3", "\[RightDoubleBracket]"}]}], ";", 
            RowBox[{"checkExact", "[", RowBox[{RowBox[
                 {"\"Landen partner, line \"", "<>", RowBox[{"ToString", "[", 
                    "i", "]"}]}], ",", RowBox[{"Together", "[", RowBox[
                   {FractionBox["ww", RowBox[{"ww", "-", "1"}]], "-", 
                    "rhs"}], "]"}]}], "]"}], ";", RowBox[{"checkExact", "[", 
              RowBox[{RowBox[{"\"Landen logarithm, line \"", "<>", 
                  RowBox[{"ToString", "[", "i", "]"}]}], ",", RowBox[
                 {"PowerExpand", "[", RowBox[{SuperscriptBox[RowBox[{"Log", 
                       "[", RowBox[{"Together", "[", RowBox[{"1", "-", 
                          "ww"}], "]"}], "]"}], "2"], "-", SuperscriptBox[
                     RowBox[{"Log", "[", "logArg", "]"}], "2"]}], "]"}]}], 
              "]"}], ";"}], ",", RowBox[{"{", RowBox[{"i", ",", 
              RowBox[{"Length", "[", "pairs", "]"}]}], "}"}], ",", 
          RowBox[{"{", RowBox[{"pair", ",", RowBox[{"{", RowBox[{"pairs", 
                  "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
                "}"}]}], "}"}]}], "]"}], ";", 
      RowBox[{RowBox[{"applyLanden", "[", "e_", "]"}], ":=", 
        RowBox[{"e", "/.", "\[VeryThinSpace]", 
          RowBox[{RowBox[{"PolyLog", "[", RowBox[{"2", ",", "z_"}], "]"}], 
            "\[RuleDelayed]", RowBox[{"Which", "[", RowBox[{RowBox[
                 {"matchArg", "[", RowBox[{"z", ",", FractionBox[RowBox[
                      {"a", "-", "k"}], RowBox[{"a", "+", "k"}]]}], "]"}], 
                ",", RowBox[{RowBox[{"-", RowBox[{"PolyLog", "[", RowBox[
                       {"2", ",", RowBox[{"-", FractionBox[RowBox[{"a", "-", 
                          "k"}], RowBox[{"2", " ", "k"}]]}]}], "]"}]}], "-", 
                  RowBox[{FractionBox["1", "2"], " ", SuperscriptBox[
                     RowBox[{"Log", "[", FractionBox[RowBox[{"a", "+", "k"}], 
                        RowBox[{"2", " ", "k"}]], "]"}], "2"]}]}], ",", 
                RowBox[{"matchArg", "[", RowBox[{"z", ",", FractionBox[
                     RowBox[{"b", "-", "k"}], RowBox[{"b", "+", "k"}]]}], 
                  "]"}], ",", RowBox[{RowBox[{"-", RowBox[{"PolyLog", "[", 
                      RowBox[{"2", ",", RowBox[{"-", FractionBox[RowBox[
                          {"b", "-", "k"}], RowBox[{"2", " ", "k"}]]}]}], 
                      "]"}]}], "-", RowBox[{FractionBox["1", "2"], " ", 
                    SuperscriptBox[RowBox[{"Log", "[", FractionBox[RowBox[
                         {"b", "+", "k"}], RowBox[{"2", " ", "k"}]], "]"}], 
                     "2"]}]}], ",", RowBox[{"matchArg", "[", RowBox[
                   {"z", ",", FractionBox[RowBox[{"b", "-", "a"}], RowBox[
                      {"b", "+", "k"}]]}], "]"}], ",", RowBox[
                 {RowBox[{"-", RowBox[{"PolyLog", "[", RowBox[{"2", ",", 
                        FractionBox[RowBox[{"a", "-", "b"}], RowBox[{"a", 
                          "+", "k"}]]}], "]"}]}], "-", RowBox[{FractionBox[
                     "1", "2"], " ", SuperscriptBox[RowBox[{"Log", "[", 
                       FractionBox[RowBox[{"a", "+", "k"}], RowBox[{"b", "+", 
                          "k"}]], "]"}], "2"]}]}], ",", RowBox[{"matchArg", 
                  "[", RowBox[{"z", ",", FractionBox[RowBox[{"a", "-", "k"}], 
                     RowBox[{"a", "+", "b"}]]}], "]"}], ",", RowBox[
                 {RowBox[{"-", RowBox[{"PolyLog", "[", RowBox[{"2", ",", 
                        RowBox[{"-", FractionBox[RowBox[{"a", "-", "k"}], 
                          RowBox[{"b", "+", "k"}]]}]}], "]"}]}], "-", 
                  RowBox[{FractionBox["1", "2"], " ", SuperscriptBox[
                     RowBox[{"Log", "[", FractionBox[RowBox[{"a", "+", "b"}], 
                        RowBox[{"b", "+", "k"}]], "]"}], "2"]}]}], ",", 
                RowBox[{"matchArg", "[", RowBox[{"z", ",", FractionBox[
                     RowBox[{"b", "-", "k"}], RowBox[{"a", "+", "b"}]]}], 
                  "]"}], ",", RowBox[{RowBox[{"-", RowBox[{"PolyLog", "[", 
                      RowBox[{"2", ",", RowBox[{"-", FractionBox[RowBox[
                          {"b", "-", "k"}], RowBox[{"a", "+", "k"}]]}]}], 
                      "]"}]}], "-", RowBox[{FractionBox["1", "2"], " ", 
                    SuperscriptBox[RowBox[{"Log", "[", FractionBox[RowBox[
                         {"a", "+", "b"}], RowBox[{"a", "+", "k"}]], "]"}], 
                     "2"]}]}], ",", "True", ",", RowBox[{"PolyLog", "[", 
                  RowBox[{"2", ",", "z"}], "]"}]}], "]"}]}]}]}], ";", 
      RowBox[{RowBox[{"dropZeroLi2", "[", "e_", "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"ee", "=", RowBox[{"Expand", "[", 
                    "e", "]"}]}], ",", "args", ",", "rest"}], "}"}], ",", 
            RowBox[{RowBox[{"args", "=", RowBox[{"DeleteDuplicates", "[", 
                  RowBox[{"Cases", "[", RowBox[{"ee", ",", RowBox[
                       {RowBox[{"PolyLog", "[", RowBox[{"2", ",", "z_"}], 
                          "]"}], "\[RuleDelayed]", "z"}], ",", 
                      "\[Infinity]"}], "]"}], "]"}]}], ";", RowBox[{"rest", 
                "=", RowBox[{"ee", "/.", "\[VeryThinSpace]", RowBox[
                   {RowBox[{"PolyLog", "[", RowBox[{"2", ",", "_"}], "]"}], 
                    "\[RuleDelayed]", "0"}]}]}], ";", RowBox[{"rest", "+", 
                RowBox[{"Total", "[", RowBox[{"Table", "[", RowBox[
                     {RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[
                          {"c", "=", RowBox[{"Together", "[", RowBox[
                          {"Coefficient", "[", RowBox[{"ee", ",", RowBox[
                          {"PolyLog", "[", RowBox[{"2", ",", "arg"}], 
                          "]"}]}], "]"}], "]"}]}], "}"}], ",", RowBox[{"If", 
                          "[", RowBox[{RowBox[{"c", "===", "0"}], ",", "0", 
                          ",", RowBox[{"c", " ", RowBox[{"PolyLog", "[", 
                          RowBox[{"2", ",", "arg"}], "]"}]}]}], "]"}]}], 
                        "]"}], ",", RowBox[{"{", RowBox[{"arg", ",", 
                          "args"}], "}"}]}], "]"}], "]"}]}]}]}], "]"}]}], 
      ";", RowBox[{"reduced", "=", RowBox[{"dropZeroLi2", "[", 
          RowBox[{"applyLanden", "[", "canon", "]"}], "]"}]}], ";", 
      RowBox[{"remain", "=", RowBox[{"Sort", "[", 
          RowBox[{"DeleteDuplicates", "[", RowBox[{"Cases", "[", 
              RowBox[{"reduced", ",", RowBox[{RowBox[{"PolyLog", "[", 
                    RowBox[{"2", ",", "z_"}], "]"}], "\[RuleDelayed]", 
                  RowBox[{"Together", "[", "z", "]"}]}], ",", 
                "\[Infinity]"}], "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"four", "=", RowBox[{"Sort", "[", RowBox[{"Together", "/@", 
            RowBox[{"{", RowBox[{RowBox[{"-", FractionBox[RowBox[{"a", "-", 
                     "k"}], RowBox[{"2", " ", "k"}]]}], ",", RowBox[
                 {"-", FractionBox[RowBox[{"b", "-", "k"}], RowBox[{"2", " ", 
                     "k"}]]}], ",", RowBox[{"-", FractionBox[RowBox[
                    {"a", "-", "k"}], RowBox[{"b", "+", "k"}]]}], ",", 
