             ")"}]}]}], ";"}], "\[IndentingNewLine]", 
     RowBox[{RowBox[{RowBox[{"edgeClosed", "[", RowBox[{"a_", ",", "k_"}], 
           "]"}], ":=", RowBox[{RowBox[{"1", "/", "k"}], " ", 
