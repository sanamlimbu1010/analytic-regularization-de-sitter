                          "nu"}], "]"}], " ", "/.", " ", RowBox[{"nu", "->", 
                         "0"}]}], "]"}], "-", RowBox[{"laplaceLog", "[", 
                     RowBox[{"c", ",", "p"}], "]"}]}], ",", RowBox[
                  {"Assumptions", "->", RowBox[{RowBox[{"c", ">", "0"}], 
                     "&&", RowBox[{"p", " ", "\[Element]", " ", 
                       "Reals"}]}]}]}], "]"}]}], "}"}]}], "]"}]}], "Input", 
   ExpressionUUID -> "ddf56444-ba2c-0c47-87e9-4716062e0b5e"], 
  Cell["3. Section 4.1.1 \[LongDash] no momentum logarithm", "Section", 
