        TraditionalForm]], ExpressionUUID -> 
       "f1e6b902-17a5-3342-83e9-6f2cb5600ca3"], ". All logs are principal \
with positive arguments, and all displayed polylogarithm arguments are below \
one. "}], "Text", ExpressionUUID -> "8834e165-d302-0f45-92fc-1c56f5196ef2"], 
  Cell[BoxData[{RowBox[{RowBox[{"ClearAll", "[", "\"Global`*\"", "]"}], 
