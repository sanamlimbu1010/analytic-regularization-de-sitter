                       ")"}]}], ")"}]}], "+", RowBox[{RowBox[{"Log", "[", 
                   RowBox[{RowBox[{"(", RowBox[{"a", "+", "k"}], ")"}], "/", 
                     RowBox[{"(", RowBox[{"2", " ", "k"}], ")"}]}], "]"}], 
                 " ", RowBox[{RowBox[{"Log", "[", RowBox[{RowBox[{"(", 
                         RowBox[{"b", "+", "k"}], ")"}], "/", RowBox[
                        {"(", RowBox[{"2", " ", "k"}], ")"}]}], "]"}], "/", 
                   RowBox[{"(", RowBox[{RowBox[{"(", RowBox[{"a", "-", "k"}], 
                         ")"}], " ", RowBox[{"(", RowBox[{"b", "-", "k"}], 
                         ")"}]}], ")"}]}]}], "-", RowBox[
                {RowBox[{"(", RowBox[{RowBox[{"PolyLog", "[", RowBox[
                        {"2", ",", RowBox[{RowBox[{"-", RowBox[{"(", RowBox[
                          {"a", "-", "k"}], ")"}]}], "/", RowBox[{"(", 
                          RowBox[{"2", " ", "k"}], ")"}]}]}], "]"}], "+", 
                     RowBox[{"PolyLog", "[", RowBox[{"2", ",", RowBox[
                          {RowBox[{"-", RowBox[{"(", RowBox[{"b", "-", "k"}], 
                          ")"}]}], "/", RowBox[{"(", RowBox[{"2", " ", "k"}], 
                          ")"}]}]}], "]"}], "+", RowBox[{RowBox[{"Pi", "^", 
                         "2"}], "/", "6"}]}], ")"}], "/", RowBox[
                  {"(", RowBox[{RowBox[{"(", RowBox[{"a", "+", "k"}], ")"}], 
                     " ", RowBox[{"(", RowBox[{"b", "+", "k"}], ")"}]}], 
                   ")"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
     RowBox[{RowBox[{"qAssemblyValue", "=", RowBox[{"Quiet", "[", 
           RowBox[{RowBox[{"N", "[", RowBox[{RowBox[{RowBox[{"(", RowBox[
                      {RowBox[{"momentumFromQ", "[", RowBox[{"a", ",", "b", 
                          ",", "k"}], "]"}], "-", RowBox[{"zzClosed", "[", 
                         RowBox[{"a", ",", "b", ",", "k"}], "]"}]}], ")"}], 
                   " ", "/.", " ", RowBox[{"Thread", "[", RowBox[
                      {RowBox[{"{", RowBox[{"a", ",", "b", ",", "k"}], "}"}], 
                       "->", "testPoint"}], "]"}]}], ",", "35"}], "]"}], ",", 
             RowBox[{"N", "::", "meprec"}]}], "]"}]}], ";"}], 
     "\[IndentingNewLine]", 
     RowBox[{RowBox[{"closedValue", "=", RowBox[{"N", "[", 
           RowBox[{RowBox[{"derivativeClosed", " ", "@@", " ", "testPoint"}], 
             ",", "35"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
     RowBox[{RowBox[{"sourceValue", "=", RowBox[{"With", "[", 
           RowBox[{RowBox[{"{", RowBox[{RowBox[{"aa", "=", RowBox[
