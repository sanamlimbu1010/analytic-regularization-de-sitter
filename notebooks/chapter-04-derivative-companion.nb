Notebook[
 {Cell["Chapter 4 companion: the differentiated difference (section 4.1)", 
   "Title"], Cell["Thesis: Comparing UV Regularizations for Cosmological \
Correlators in de Sitter Space, Sanam Limbu (LMU Munich, 2026), Chapter 4. \
Notation: a = k12, b = k34, and k is the exchanged momentum. 14.3.0 for \
Microsoft Windows (64-bit) (July 8, 2025).", "Text"], 
  Cell["This notebook checks the computer-algebra steps of section 4.1; the \
key result is the boxed derivative (4.21).\nExact checks return residual 0 \
for generic a, b, k > 0 (pairwise different).\nNumerical checks state the \
digits of relative agreement reached; a precision goal is not an error \
bound.\nEvaluate top to bottom in a fresh kernel. The ledger at the end lists \
every check.", "Text"], Cell["Setup", "Section"], 
  Cell["ClearAll[\"Global`*\"];\n$MaxExtraPrecision = 10000;\n(* generic \
positive kinematics: a = k12, b = k34, k = exchanged momentum *)\nasm = a > 0 \
&& b > 0 && k > 0 && a != b && a != k && b != k;\nledger = {};\nsec = \
\"\";\n\n(* all logarithm arguments below are positive: split products and \
quotients *)\nlogExpand[e_] := Together[PowerExpand[e /. Log[z_] :> \
Log[Together[z]]]];\n\n(* exact check: the residual must reduce to 0, \
otherwise the build stops *)\ncheckExact[name_, eq_, residual_] := Module[{r \
= residual},\n  Scan[If[r =!= 0, r = #[residual]] &,\n    {Together, Expand, \
Simplify[#, Assumptions -> asm] &,\n     FullSimplify[#, Assumptions -> asm] \
&}];\n  If[r =!= 0, Print[\"FAILED: \", name]; Print[residual]; Abort[]];\n  \
AppendTo[ledger, {sec, name, eq, \"exact\", 0, Infinity}];\n  0];\n\n(* \
numerical check: records the digits of relative agreement reached \
*)\ncheckNum[name_, eq_, got_, want_, digits_] := Module[{d, rel, n},\n  d = \
Quiet[N[got, digits + 10] - N[want, digits + 10], {N::meprec, N::precw}];\n  \
rel = Abs[d]/Max[1, Abs[N[want, 20]]];\n  n = If[rel == 0, digits + 10, \
Floor[-Log10[rel]]];\n  If[n < digits, Print[\"FAILED: \", name, \" \", n]; \
Abort[]];\n  AppendTo[ledger, {sec, name, eq, \"numerical\", ToString[n] <> \
\" digits\", n}];\n  n];\n\n(* short PASS line for the current section \
*)\npass[] := Module[{r = Select[ledger, First[#] === sec &], nd},\n  nd = \
Cases[r, {_, _, _, \"numerical\", _, n_} :> n];\n  \"PASS \" <> sec <> \": \" \
<> ToString[Count[r, {_, _, _, \"exact\", __}]] <> \" exact\"\n   <> If[nd \
=== {}, \"\", \", \" <> ToString[Length[nd]] <> \" numerical (at least \"\n   \
  <> ToString[Min[nd]] <> \" digits)\"]]", "Input"], 
  Cell["4.1.1  (4.9) against its s integral", "Section"], 
  Cell["(4.9)  [(Z1-Z4)^2 Pdot] in closed form\n(4.6)  the same quantity as \
an s integral\nChecked numerically at two points; the second has k > a, b.", 
   "Text"], Cell["sec = \"4.1.1\";\n\n(* (4.9): [(Z1-Z4)^2 Pdot] in closed \
form; u = k12, v = k34, t = k *)\nzz49[u_, v_, t_] := Pi^3/t (\n  -PolyLog[2, \
-(u - t)/(v + t)]/((u - t) (v + t))\n  - PolyLog[2, -(v - t)/(u + t)]/((u + \
t) (v - t))\n  + (Log[(u + t)/(v + t)]^2/2 + Pi^2/6)/((u + t) (v + \
t)));\n\n(* (4.6): the same quantity as the s integral over (0, Infinity), \
split at s = 1 *)\nzzS[u_, v_, t_] := Pi^3/(2 t) NIntegrate[\n  Log[s]^2 \
(1/(u s + v + t Abs[s - 1])^2 + 1/((u + t) s + v + t)^2),\n  {s, 0, 1, 10, \
Infinity},\n  WorkingPrecision -> 22, PrecisionGoal -> 14, MaxRecursion -> \
20,\n  Method -> {\"GlobalAdaptive\", \"SymbolicProcessing\" -> 0}];\n\nDo[\n \
 checkNum[\"(4.9) vs s integral (4.6) at (a,b,k) = \" <> ToString[pt, \
InputForm], \"(4.9)\",\n    zz49 @@ pt, zzS @@ pt, 12],\n  {pt, {{13/10, \
17/10, 7/10}, {4/5, 3/2, 5/2}}}];  (* second point: k > a, b *)\npass[]", 
   "Input"], 
  Cell[BoxData["\"PASS 4.1.1: 0 exact, 2 numerical (at least 22 digits)\""], 
   "Output"], Cell["4.1.3  The kernel Q", "Section"], 
  Cell["(4.18)  closed form of Q/Pi\n(4.17)  primitive in k of (4.16), up to \
a k-independent term\n(4.16)  dQ/dk\nExact: Integrate gives (4.17); (4.17) \
plus the constant is (4.18); the k-derivative of (4.18) is (4.16).", "Text"], 
  Cell["sec = \"4.1.3\";\n\n(* (4.18): closed form of Q/Pi; u = a, v = b, t = \
k *)\nQh[u_, v_, t_] := (\n  (PolyLog[2, (v - t)/(u + v)] + Log[(u + v) (v + \
t)]^2/2 + Pi^2/6)/(v (u + v))\n  + (PolyLog[2, (v - u)/(v + t)] - v/(u + v) \
(Log[u + t]^2 - Log[v + t]^2))/(v (u - v)));\n\n(* (4.16): dQ/dk *)\nqDer[u_, \
v_, t_] := 2 Pi/(v^2 - t^2) (Log[u + t]/(u + t) - t/v Log[u + v]/(u + \
v));\n\n(* (4.17): primitive of Q/Pi in k, up to a k-independent term \
*)\nqPrim[u_, v_, t_] := (\n  (PolyLog[2, (v - t)/(u + v)] + Log[u + v] Log[v \
+ t])/(v (u + v))\n  + (PolyLog[2, (v - u)/(v + t)] + Log[v + t]^2/2)/(v (u - \
v))\n  - Log[u + t]^2/((u - v) (u + v)));\n\n(* Mathematica's primitive of \
(4.16) after Apart agrees with (4.17) up to a constant *)\nprim = \
Integrate[Apart[qDer[a, b, k], k], k, Assumptions -> a > 0 && b > 0 && a != \
b];\ncheckExact[\"Integrate of (4.16) gives (4.17) up to a constant\", \
\"(4.17)\",\n  logExpand[D[prim - Pi qPrim[a, b, k], k]]];\n\n(* (4.17) plus \
the k-independent constant fixed at large k is (4.18) *)\ncheckExact[\"(4.17) \
+ constant = (4.18)\", \"(4.18)\",\n  logExpand[Qh[a, b, k] - qPrim[a, b, k] \
- (Pi^2/6 + Log[a + b]^2/2)/(b (a + b))]];\n\n(* k-derivative of (4.18) is \
(4.16) *)\ncheckExact[\"d/dk of (4.18) = (4.16)\", \"(4.16)\",\n  \
logExpand[D[Pi Qh[a, b, k], k] - qDer[a, b, k]]];", "Input"], 
  Cell["(4.15)  Q as a p integral\nQuadrature of (4.15) against (4.18), \
including b = k, a = k and k > a, b.", "Text"], 
  Cell["(* (4.15): Q(a,b;k) as the one-dimensional integral over p \
*)\nqQuad[u_, v_, t_] := 2 NIntegrate[\n  Log[p^2 + t^2]/(p^2 + v^2) Re[Log[u \
- I p]/(u - I p)],\n  {p, 0, 1, 10, Infinity},\n  WorkingPrecision -> 24, \
PrecisionGoal -> 14, MaxRecursion -> 25,\n  Method -> {\"GlobalAdaptive\", \
\"SymbolicProcessing\" -> 0}];\n\n(* (4.18) against (4.15): generic point, b \
= k, a = k (used in (4.14)), k > a, b *)\nDo[\n  checkNum[\"(4.18) vs \
quadrature of (4.15), \" <> pt[[1]] <> \" (a,b,k) = \" <> ToString[pt[[2]], \
InputForm],\n    \"(4.18)\", Pi Qh @@ pt[[2]], qQuad @@ pt[[2]], 12],\n  {pt, \
{{\"generic\", {13/10, 17/10, 7/10}}, {\"b = k\", {13/10, 7/10, 7/10}},\n     \
   {\"a = k\", {7/10, 17/10, 7/10}}, {\"k > a, b\", {1/2, 4/5, \
3}}}}];\npass[]", "Input"], 
  Cell[BoxData["\"PASS 4.1.3: 3 exact, 4 numerical (at least 22 digits)\""], 
   "Output"], Cell["4.1.4  Assembly of the derivative", "Section"], 
  Cell["(4.14)  2[Z1 P Pdot] - [Pdot Z P] through Q\n(4.2)   derivative = \
(4.14) + its image under a <-> b - (4.9): six values of Q\n(4.21)  boxed \
derivative, typed as printed", "Text"], Cell["sec = \"4.1.4, \
assembly\";\n\n(* (4.14) with Q = Pi Qh: 2[Z1 P Pdot] - [Pdot Z P] \
*)\nmom[u_, v_] := 2 Pi^3 v (\n  (Qh[u, v, k] - Qh[u, k, k])/(v^2 - k^2)\n  - \
(k Qh[u, v, k] - u Qh[k, v, k])/(k (u^2 - k^2)));\n\n(* (4.21) as printed: \
four terms grouped by denominator *)\nres421[u_, v_, t_] := Pi^3/t (\n  \
(PolyLog[2, -(v - t)/(u + t)] - PolyLog[2, -(v - t)/(2 t)]\n    + Log[(u + \
t)/(2 t)]^2/2)/((u - t) (v + t))\n  + (PolyLog[2, -(u - t)/(v + t)] - \
PolyLog[2, -(u - t)/(2 t)]\n    + Log[(v + t)/(2 t)]^2/2)/((u + t) (v - t))\n \
 + Log[(u + t)/(2 t)] Log[(v + t)/(2 t)]/((u - t) (v - t))\n  - (PolyLog[2, \
-(u - t)/(2 t)] + PolyLog[2, -(v - t)/(2 t)]\n    + Pi^2/6)/((u + t) (v + \
t)));\n\n(* (4.2): six values of Q (two copies of (4.14)) minus (4.9) \
*)\nderiv = mom[a, b] + mom[b, a] - zz49[a, b, k];", "Input"], 
  Cell["Ten dilogarithm arguments, forming five Landen pairs \
(4.19)-(4.20).\nLine 2 of (4.20) is its own image; its two dilogarithms enter \
with equal coefficients.", "Text"], Cell["(* ten dilogarithm arguments, each \
brought to a canonical form *)\ncanon = Expand[deriv /. PolyLog[2, z_] :> \
PolyLog[2, Together[z]]];\nargs = Sort[DeleteDuplicates[Cases[canon, \
PolyLog[2, z_] :> z, Infinity]]];\nten = Sort[Together /@ {\n   -(a - k)/(b + \
k), (a - k)/(a + b), (a - b)/(a + k), (a - k)/(a + k), -(a - k)/(2 k),\n   \
-(b - k)/(a + k), (b - k)/(a + b), (b - a)/(b + k), (b - k)/(b + k), -(b - \
k)/(2 k)}];\ncheckExact[\"the ten dilogarithm arguments\", \"4.1.4\", \
Boole[args =!= ten]];\n\n(* (4.19)-(4.20): five Landen pairs {w, w/(w-1), \
argument of the squared log} *)\npairs = {\n  {(a - k)/(a + k), -(a - k)/(2 \
k), (a + k)/(2 k)},   (* (4.20), line 1 *)\n  {(b - a)/(b + k), (a - b)/(a + \
k), (a + k)/(b + k)},(* (4.20), line 2 *)\n  {(a - k)/(a + b), -(a - k)/(b + \
k), (a + b)/(b + k)},(* (4.20), line 3 *)\n  {(b - k)/(b + k), -(b - k)/(2 \
k), (b + k)/(2 k)},   (* image of line 1 *)\n  {(b - k)/(a + b), -(b - k)/(a \
+ k), (a + b)/(a + k)}};(* image of line 3 *)\ncheckExact[\"pairs: w/(w-1) is \
the partner, 1-w the log argument\", \"(4.20)\",\n  \
Total[Map[Together[#[[1]]/(#[[1]] - 1) - #[[2]]] +\n     \
PowerExpand[Log[Together[1 - #[[1]]]]^2 - Log[#[[3]]]^2] &, \
pairs]]];\ncheckNum[\"Landen (4.19) on the five pairs at (a,b,k) = (13/10, \
17/10, 7/10)\", \"(4.19)\",\n  Max[Map[Abs[N[PolyLog[2, #[[1]]], 40] + \
N[PolyLog[2, #[[1]]/(#[[1]] - 1)], 40]\n     + N[Log[1 - #[[1]]]^2/2, 40]] &, \
pairs /. {a -> 13/10, b -> 17/10, k -> 7/10}]], 0, 25];\n\n(* line 2: its two \
dilogarithms enter with equal coefficients *)\ncL = Coefficient[canon, \
PolyLog[2, Together[(b - a)/(b + k)]]];\ncR = Coefficient[canon, PolyLog[2, \
Together[(a - b)/(a + k)]]];\ncheckExact[\"line 2 enters with equal \
coefficients\", \"(4.20)\",\n  Together[cL - cR] + \
Boole[PossibleZeroQ[cL]]];\nargs", "Input"], 
  Cell[BoxData[RowBox[{"{", RowBox[{FractionBox[RowBox[{"a", "-", "k"}], 
         RowBox[{"a", "+", "b"}]], ",", FractionBox[RowBox[{"b", "-", "k"}], 
         RowBox[{"a", "+", "b"}]], ",", FractionBox[
         RowBox[{RowBox[{"-", "a"}], "+", "k"}], RowBox[{"2", " ", "k"}]], 
        ",", FractionBox[RowBox[{"a", "-", "b"}], RowBox[{"a", "+", "k"}]], 
        ",", FractionBox[RowBox[{"a", "-", "k"}], RowBox[{"a", "+", "k"}]], 
        ",", FractionBox[RowBox[{RowBox[{"-", "b"}], "+", "k"}], 
         RowBox[{"2", " ", "k"}]], ",", FractionBox[
         RowBox[{RowBox[{"-", "b"}], "+", "k"}], RowBox[{"a", "+", "k"}]], 
        ",", FractionBox[RowBox[{RowBox[{"-", "a"}], "+", "b"}], 
         RowBox[{"b", "+", "k"}]], ",", FractionBox[RowBox[{"b", "-", "k"}], 
         RowBox[{"b", "+", "k"}]], ",", FractionBox[
         RowBox[{RowBox[{"-", "a"}], "+", "k"}], RowBox[{"b", "+", "k"}]]}], 
      "}"}]], "Output"], Cell["Apply (4.20) and its images: four distinct \
dilogarithms remain.\nExpand the logarithms; the difference to (4.21) must be \
0.", "Text"], Cell["(* (4.20): replace the left member of each pair by the \
right one; the images follow\n   from the pairs above, and line 2 cancels by \
the equal coefficients *)\nlookup[z_] := SelectFirst[pairs, PossibleZeroQ[z - \
#[[1]]] &, None];\nreduceLi[z_] := With[{p = lookup[z]},\n  If[p === None, \
PolyLog[2, z], -PolyLog[2, p[[2]]] - Log[p[[3]]]^2/2]];\nreduced = \
Collect[canon /. PolyLog[2, z_] :> reduceLi[z], _PolyLog, Together];\nreduced \
= Collect[reduced /. PolyLog[2, z_] :> PolyLog[2, Together[z]], _PolyLog, \
Together];\n\n(* four distinct dilogarithms remain, as in (4.21) *)\nfour = \
Sort[Together /@ {-(a - k)/(2 k), -(b - k)/(2 k), -(a - k)/(b + k), -(b - \
k)/(a + k)}];\nremain = Sort[DeleteDuplicates[Cases[reduced, PolyLog[2, z_] \
:> z, Infinity]]];\ncheckExact[\"four dilogarithms remain\", \"(4.21)\", \
Boole[remain =!= four]];\n\n(* expand every logarithm; the four dilogarithms \
become symbols *)\nliOf = <|Together[-(a - k)/(2 k)] -> liA, Together[-(b - \
k)/(2 k)] -> liB,\n  Together[-(a - k)/(b + k)] -> liC, Together[-(b - k)/(a \
+ k)] -> liD|>;\nexpandLogs[e_] := Expand[PowerExpand[\n  Collect[e /. \
PolyLog[2, z_] :> PolyLog[2, Together[z]], _PolyLog, Together]\n    /. \
PolyLog[2, z_] :> liOf[z]]];\nlhs = expandLogs[reduced];\nrhs = \
expandLogs[res421[a, b, k]];\n\n(* the logarithms combine into (a+k)/(2k) and \
(b+k)/(2k); Log[a+b] drops out *)\ncheckExact[\"assembly minus (4.21)\", \
\"(4.21)\", Together[lhs - rhs]];\ncheckExact[\"Log[a+b] drops out\", \
\"(4.21)\", Coefficient[lhs, Log[a + b]]];\ncheckExact[\"logs only in a+k, \
b+k, 2, k\", \"(4.21)\",\n  Boole[Union[Cases[lhs, Log[x_] :> x, Infinity]] \
=!= Union[{2, k, a + k, b + k}]]];\npass[]", "Input"], 
  Cell[BoxData[
    "\"PASS 4.1.4, assembly: 7 exact, 1 numerical (at least 35 digits)\""], 
   "Output"], Cell["(4.21) against one-dimensional integrals", "Section"], 
  Cell["(4.21) against (4.6), (4.11), (4.13), Euler's constant kept, combined \
as in (4.2).\nThis does not use Q.", "Text"], 
  Cell["sec = \"4.1.4, integrals\";\n\n(* (4.4): Re[(EulerGamma + Log[c - I \
p])/(c - I p)] with the sign of the cosine transform *)\nt1[c_, p_] := \
-Re[(EulerGamma + Log[c - I p])/(c - I p)];\nline[f_] := 2 NIntegrate[f[p], \
{p, 0, 1, 10, Infinity},\n  WorkingPrecision -> 22, PrecisionGoal -> 12, \
MaxRecursion -> 20,\n  Method -> {\"GlobalAdaptive\", \"SymbolicProcessing\" \
-> 0}];\n\n(* (4.11): [Z1 P Pdot], Euler's constant kept *)\nc411[u_, v_, t_] \
:= Pi^2 v line[Function[p,\n  Log[p^2 + t^2]/((p^2 + t^2) (p^2 + v^2)) t1[u, \
p]]];\n(* (4.13): [Pdot Z P], Euler's constant kept *)\nd413[u_, v_, t_] := \
-2 Pi^2 v/(t (u^2 - t^2)) line[Function[p,\n  Log[p^2 + t^2]/(p^2 + v^2) (t \
t1[u, p] - u t1[t, p])]];\n\n(* (4.2) with the images under k12 <-> k34; \
(4.6) is zzS from section 4.1.1 *)\nfromIntegrals[u_, v_, t_] := -(zzS[u, v, \
t]\n  - 2 (c411[u, v, t] + c411[v, u, t]) + d413[u, v, t] + d413[v, u, \
t]);\n\nDo[\n  checkNum[\"(4.21) vs (4.6), (4.11), (4.13) at (a,b,k) = \" <> \
ToString[pt, InputForm], \"(4.21)\",\n    res421 @@ pt, fromIntegrals @@ pt, \
12],\n  {pt, {{13/10, 17/10, 7/10}, {4/5, 3/2, 5/2}}}];\npass[]", "Input"], 
  Cell[BoxData[
    "\"PASS 4.1.4, integrals: 0 exact, 2 numerical (at least 22 digits)\""], 
   "Output"], Cell["Ledger", "Section"], Cell["Grid[Prepend[ledger[[All, 1 ;; \
5]],\n  {\"section\", \"check\", \"equation\", \"kind\", \"residual / \
agreement\"}],\n  Frame -> All, Alignment -> Left]", "Input"], 
  Cell[BoxData[TagBox[GridBox[{{"\"section\"", "\"check\"", "\"equation\"", 
        "\"kind\"", "\"residual / agreement\""}, {"\"4.1.1\"", 
        "\"(4.9) vs s integral (4.6) at (a,b,k) = {13/10, 17/10, 7/10}\"", 
        "\"(4.9)\"", "\"numerical\"", "\"22 digits\""}, 
       {"\"4.1.1\"", 
        "\"(4.9) vs s integral (4.6) at (a,b,k) = {4/5, 3/2, 5/2}\"", 
        "\"(4.9)\"", "\"numerical\"", "\"22 digits\""}, 
       {"\"4.1.3\"", "\"Integrate of (4.16) gives (4.17) up to a constant\"", 
        "\"(4.17)\"", "\"exact\"", "0"}, {"\"4.1.3\"", 
        "\"(4.17) + constant = (4.18)\"", "\"(4.18)\"", "\"exact\"", "0"}, 
       {"\"4.1.3\"", "\"d/dk of (4.18) = (4.16)\"", "\"(4.16)\"", 
        "\"exact\"", "0"}, {"\"4.1.3\"", "\"(4.18) vs quadrature of (4.15), \
generic (a,b,k) = {13/10, 17/10, 7/10}\"", "\"(4.18)\"", "\"numerical\"", 
        "\"22 digits\""}, {"\"4.1.3\"", "\"(4.18) vs quadrature of (4.15), b \
= k (a,b,k) = {13/10, 7/10, 7/10}\"", "\"(4.18)\"", "\"numerical\"", 
        "\"22 digits\""}, {"\"4.1.3\"", "\"(4.18) vs quadrature of (4.15), a \
= k (a,b,k) = {7/10, 17/10, 7/10}\"", "\"(4.18)\"", "\"numerical\"", 
        "\"22 digits\""}, {"\"4.1.3\"", "\"(4.18) vs quadrature of (4.15), k \
> a, b (a,b,k) = {1/2, 4/5, 3}\"", "\"(4.18)\"", "\"numerical\"", 
        "\"22 digits\""}, {"\"4.1.4, assembly\"", 
        "\"the ten dilogarithm arguments\"", "\"4.1.4\"", "\"exact\"", "0"}, 
       {"\"4.1.4, assembly\"", 
        "\"pairs: w/(w-1) is the partner, 1-w the log argument\"", 
        "\"(4.20)\"", "\"exact\"", "0"}, {"\"4.1.4, assembly\"", "\"Landen \
(4.19) on the five pairs at (a,b,k) = (13/10, 17/10, 7/10)\"", "\"(4.19)\"", 
        "\"numerical\"", "\"35 digits\""}, {"\"4.1.4, assembly\"", 
        "\"line 2 enters with equal coefficients\"", "\"(4.20)\"", 
        "\"exact\"", "0"}, {"\"4.1.4, assembly\"", 
        "\"four dilogarithms remain\"", "\"(4.21)\"", "\"exact\"", "0"}, 
       {"\"4.1.4, assembly\"", "\"assembly minus (4.21)\"", "\"(4.21)\"", 
        "\"exact\"", "0"}, {"\"4.1.4, assembly\"", "\"Log[a+b] drops out\"", 
        "\"(4.21)\"", "\"exact\"", "0"}, {"\"4.1.4, assembly\"", 
        "\"logs only in a+k, b+k, 2, k\"", "\"(4.21)\"", "\"exact\"", "0"}, 
       {"\"4.1.4, integrals\"", "\"(4.21) vs (4.6), (4.11), (4.13) at (a,b,k) \
= {13/10, 17/10, 7/10}\"", "\"(4.21)\"", "\"numerical\"", "\"22 digits\""}, 
       {"\"4.1.4, integrals\"", 
        "\"(4.21) vs (4.6), (4.11), (4.13) at (a,b,k) = {4/5, 3/2, 5/2}\"", 
        "\"(4.21)\"", "\"numerical\"", "\"22 digits\""}}, 
      GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
      GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
      GridBoxItemSize -> {"Columns" -> {{Automatic}}, 
        "Rows" -> {{Automatic}}}], "Grid"]], "Output"]}, 
 WindowTitle -> "chapter-04-derivative-companion.nb", 
 StyleDefinitions -> "Default.nb", WindowSize -> {1100, 850}]
