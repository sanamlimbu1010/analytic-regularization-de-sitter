  Cell["Old common-denominator form equals the revised four-term form", 
   "Subsection", ExpressionUUID -> "19aaf1fd-afae-d947-9d6d-ce7956d428bf"], 
  Cell[TextData[{"The next cell applies the three stated Landen identities to \
temporary symbols and compares rational coefficients exactly, without ", 
     Cell[BoxData[TemplateBox[{"PowerExpand", "paclet:ref/PowerExpand", 
         "https://reference.wolfram.com/language/ref/PowerExpand.html"}, 
        "TextRefLink", DisplayFunction -> 
         (TagBox[ButtonBox[StyleBox[#1, ShowStringCharacters -> True, 
             FontFamily -> "Source Sans Pro"], 
            BaseStyle -> {"Link", 
              FontColor -> LightDarkSwitched[RGBColor[0.02, 0.286, 0.651], 
                RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, 
            ContentPadding -> False], MouseAppearanceTag["LinkHand"]] & )]], ExpressionUUID -> 
       "946c3e17-a187-5741-9040-e7539eaaf7e1"], ". "}], "Text", 
   ExpressionUUID -> "1ea15323-e30a-d642-bb66-32bc2d4e8017"], 
  Cell[BoxData[
    {RowBox[{RowBox[{"Clear", "[", RowBox[{"lA", ",", "lB", ",", "lE", ",", 
           "ra", ",", "rb", ",", "xa", ",", "xb", ",", "na", ",", "nb", ",", 
           "ya", ",", "yb"}], "]"}], ";"}], "\[IndentingNewLine]", 
     RowBox[{RowBox[{"den", "=", RowBox[{"k", " ", 
           RowBox[{"(", RowBox[{RowBox[{"a", "^", "2"}], "-", RowBox[
                {"k", "^", "2"}]}], ")"}], " ", 
           RowBox[{"(", RowBox[{RowBox[{"b", "^", "2"}], "-", RowBox[
                {"k", "^", "2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
     RowBox[{RowBox[{"oldSymbolic", "=", 
         RowBox[{RowBox[{"(", RowBox[{RowBox[{"b", " ", RowBox[{"(", 
                   RowBox[{"a", "-", "k"}], ")"}], " ", RowBox[{"lA", "^", 
                   "2"}]}], "+", RowBox[{"a", " ", RowBox[{"(", RowBox[
                    {"b", "-", "k"}], ")"}], " ", RowBox[{"lB", "^", "2"}]}], 
               "+", RowBox[{RowBox[{"(", RowBox[{"a", "+", "k"}], ")"}], " ", 
                 RowBox[{"(", RowBox[{"b", "+", "k"}], ")"}], " ", "lA", " ", 
                 "lB"}], "+", RowBox[{RowBox[{"(", RowBox[{"a", "+", "k"}], 
                   ")"}], " ", RowBox[{"(", RowBox[{"b", "-", "k"}], ")"}], 
                 " ", "lA", " ", "lE"}], "+", RowBox[{RowBox[{"(", 
                   RowBox[{"a", "-", "k"}], ")"}], " ", RowBox[{"(", 
                   RowBox[{"b", "+", "k"}], ")"}], " ", "lB", " ", "lE"}], 
               "-", RowBox[{RowBox[{"(", RowBox[{RowBox[{"a", " ", "b"}], 
                     "-", RowBox[{"k", "^", "2"}]}], ")"}], " ", 
                 RowBox[{"lE", "^", "2"}]}], "-", RowBox[
                {RowBox[{"(", RowBox[{"a", "-", "k"}], ")"}], " ", 
                 RowBox[{"(", RowBox[{"b", "-", "k"}], ")"}], " ", 
                 RowBox[{RowBox[{"Pi", "^", "2"}], "/", "6"}]}], "+", RowBox[
                {"2", " ", "b", " ", RowBox[{"(", RowBox[{"a", "-", "k"}], 
                   ")"}], " ", "ra"}], "+", RowBox[{"2", " ", "a", " ", 
                 RowBox[{"(", RowBox[{"b", "-", "k"}], ")"}], " ", "rb"}], 
               "-", RowBox[{RowBox[{"(", RowBox[{"a", "-", "k"}], ")"}], " ", 
                 RowBox[{"(", RowBox[{"b", "+", "k"}], ")"}], " ", "xa"}], 
               "-", RowBox[{RowBox[{"(", RowBox[{"a", "+", "k"}], ")"}], " ", 
                 RowBox[{"(", RowBox[{"b", "-", "k"}], ")"}], " ", "xb"}]}], 
             ")"}], "/", "den"}]}], ";"}], "\[IndentingNewLine]", 
     RowBox[{RowBox[{"landenRules", "=", 
         RowBox[{"{", RowBox[{RowBox[{"ra", "->", RowBox[
                {RowBox[{"-", "na"}], "-", RowBox[{RowBox[{"lA", "^", "2"}], 
                   "/", "2"}]}]}], ",", RowBox[{"rb", "->", RowBox[
                {RowBox[{"-", "nb"}], "-", RowBox[{RowBox[{"lB", "^", "2"}], 
                   "/", "2"}]}]}], ",", RowBox[{"xa", "->", RowBox[
                {RowBox[{"-", "ya"}], "-", RowBox[{RowBox[{RowBox[{"(", 
                       RowBox[{"lE", "-", "lB"}], ")"}], "^", "2"}], "/", 
                   "2"}]}]}], ",", RowBox[{"xb", "->", RowBox[
                {RowBox[{"-", "yb"}], "-", RowBox[{RowBox[{RowBox[{"(", 
                       RowBox[{"lE", "-", "lA"}], ")"}], "^", "2"}], "/", 
                   "2"}]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
     RowBox[{RowBox[{"currentSymbolic", "=", RowBox[{RowBox[{"1", "/", "k"}], 
           " ", RowBox[{"(", RowBox[{RowBox[{RowBox[{"(", RowBox[{"yb", "-", 
                     "nb", "+", RowBox[{RowBox[{"lA", "^", "2"}], "/", 
                       "2"}]}], ")"}], "/", RowBox[{"(", RowBox[
                    {RowBox[{"(", RowBox[{"a", "-", "k"}], ")"}], " ", 
                     RowBox[{"(", RowBox[{"b", "+", "k"}], ")"}]}], ")"}]}], 
               "+", RowBox[{RowBox[{"(", RowBox[{"ya", "-", "na", "+", 
                     RowBox[{RowBox[{"lB", "^", "2"}], "/", "2"}]}], ")"}], 
                 "/", RowBox[{"(", RowBox[{RowBox[{"(", RowBox[{"a", "+", 
                         "k"}], ")"}], " ", RowBox[{"(", RowBox[{"b", "-", 
                         "k"}], ")"}]}], ")"}]}], "+", RowBox[{"lA", " ", 
                 RowBox[{"lB", "/", RowBox[{"(", RowBox[{RowBox[{"(", 
                         RowBox[{"a", "-", "k"}], ")"}], " ", RowBox[
                        {"(", RowBox[{"b", "-", "k"}], ")"}]}], ")"}]}]}], 
               "-", RowBox[{RowBox[{"(", RowBox[{"na", "+", "nb", "+", 
                     RowBox[{RowBox[{"Pi", "^", "2"}], "/", "6"}]}], ")"}], 
                 "/", RowBox[{"(", RowBox[{RowBox[{"(", RowBox[{"a", "+", 
                         "k"}], ")"}], " ", RowBox[{"(", RowBox[{"b", "+", 
                         "k"}], ")"}]}], ")"}]}]}], ")"}]}]}], ";"}], 
     "\[IndentingNewLine]", RowBox[{"record", "[", 
       RowBox[{"\"old form equals current form\"", ",", 
         RowBox[{"Cancel", "[", RowBox[{"Together", "[", 
             RowBox[{RowBox[{"Expand", "[", RowBox[{"oldSymbolic", " ", "/.", 
                   " ", "landenRules"}], "]"}], "-", "currentSymbolic"}], 
             "]"}], "]"}]}], "]"}]}], "Input", 
   ExpressionUUID -> "3518f6eb-841c-644c-aa4b-3e6921aa06d0"], 
  Cell[BoxData[
    {RowBox[{RowBox[{RowBox[{"derivativeClosed", "[", 
