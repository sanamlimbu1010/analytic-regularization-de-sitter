          "state" -> "Boxes"|>, "TeXAssistantTemplate"], TraditionalForm]], 
      ExpressionUUID -> "4baf89cc-e1b2-fc4e-906f-b9adbcb6e551"], 
     "; physical kinematics further has ", 
     Cell[BoxData[FormBox[TemplateBox[
         <|"boxes" -> FormBox[RowBox[{StyleBox["a", "TI"], ">", 
              StyleBox["k", "TI"]}], TraditionalForm], "errors" -> {}, 
          "input" -> "a>k", "state" -> "Boxes"|>, "TeXAssistantTemplate"], 
        TraditionalForm]], ExpressionUUID -> 
       "2a69ecf6-b171-7b4f-83d7-696019380a75"], ", ", 
     Cell[BoxData[FormBox[TemplateBox[
         <|"boxes" -> FormBox[RowBox[{StyleBox["b", "TI"], ">", 
              StyleBox["k", "TI"]}], TraditionalForm], "errors" -> {}, 
