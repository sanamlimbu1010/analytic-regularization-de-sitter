                  {"cIntegral", "[", RowBox[{"aa", ",", "bb", ",", "kk"}], 
                   "]"}]}], "+", RowBox[{"2", " ", RowBox[{"cIntegral", "[", 
                   RowBox[{"bb", ",", "aa", ",", "kk"}], "]"}]}], "-", RowBox[
                {"dIntegral", "[", RowBox[{"aa", ",", "bb", ",", "kk"}], 
                 "]"}], "-", RowBox[{"dIntegral", "[", RowBox[{"bb", ",", 
                   "aa", ",", "kk"}], "]"}]}]}], "]"}]}], ";"}], 
     "\[IndentingNewLine]", RowBox[{"record", "[", 
       RowBox[{"\"three evaluations\"", ",", 
         RowBox[{"{", RowBox[{"qAssemblyValue", ",", "sourceValue", ",", 
