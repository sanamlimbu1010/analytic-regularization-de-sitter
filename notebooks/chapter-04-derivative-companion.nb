                {"cos", RowBox[{"(", RowBox[{StyleBox["p", "TI"], StyleBox[
                      "z", "TI"]}], ")"}], "cos", RowBox[{"(", RowBox[
                    {StyleBox["p", "TI"], SuperscriptBox[StyleBox["z", "TI"], 
                      "\[Prime]"]}], ")"}]}], RowBox[{SuperscriptBox[
                  StyleBox["p", "TI"], "2"], "+", SuperscriptBox[StyleBox[
                   "k", "TI"], "2"]}]], "\[DifferentialD]", StyleBox["p", 
               "TI"], "\[LongEqual]", FractionBox["\[Pi]", RowBox[
