  Cell["Both sides of the five-term relation (4.28) vanish at b = k, their \
b-derivatives agree after the logarithms are reduced to Log[(a+k)/(2k)] and \
Log[(b+k)/(2k)], and the relation is checked numerically, including a point \
with k above both a and b.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"start", "=", 
        RowBox[{RowBox[{"Length", "[", "checks", "]"}], "+", "1"}]}], ";", 
      RowBox[{"fiveL", "=", RowBox[{"PolyLog", "[", 
          RowBox[{"2", ",", "rab"}], "]"}]}], ";", 
      RowBox[{"fiveR", "=", RowBox[{RowBox[{"PolyLog", "[", 
            RowBox[{"2", ",", "ca"}], "]"}], "+", 
          RowBox[{"PolyLog", "[", RowBox[{"2", ",", "cb"}], "]"}], "-", 
          RowBox[{"PolyLog", "[", RowBox[{"2", ",", "na"}], "]"}], "-", 
          RowBox[{"PolyLog", "[", RowBox[{"2", ",", "nb"}], "]"}], "-", 
          RowBox[{"lA", " ", "lB"}]}]}], ";", 
      RowBox[{"five", "=", RowBox[{"fiveL", "-", "fiveR"}]}], ";", 
      RowBox[{"checkExact", "[", RowBox[
         {"\"(4.28) left side vanishes at b = k\"", ",", 
          RowBox[{"fiveL", "/.", "\[VeryThinSpace]", 
            RowBox[{"b", "\[Rule]", "k"}]}]}], "]"}], ";", 
      RowBox[{"checkExact", "[", RowBox[
         {"\"(4.28) right side vanishes at b = k\"", ",", 
          RowBox[{"fiveR", "/.", "\[VeryThinSpace]", 
            RowBox[{"b", "\[Rule]", "k"}]}]}], "]"}], ";", 
      RowBox[{"checkExact", "[", RowBox[{"\"(4.28) vanishes at b = k\"", ",", 
          RowBox[{"FullSimplify", "[", RowBox[{RowBox[{"five", "/.", 
                "\[VeryThinSpace]", RowBox[{"b", "\[Rule]", "k"}]}], ",", 
              RowBox[{"Assumptions", "\[Rule]", RowBox[{RowBox[{"a", ">", 
                    "0"}], "&&", RowBox[{"k", ">", "0"}]}]}]}], "]"}]}], 
        "]"}], ";", RowBox[{"logTable", "=", 
        RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{FractionBox[RowBox[
                  {"a", "+", "k"}], RowBox[{"2", " ", "k"}]], ",", "LA"}], 
              "}"}], ",", RowBox[{"{", RowBox[{FractionBox[RowBox[{"b", "+", 
                   "k"}], RowBox[{"2", " ", "k"}]], ",", "LB"}], "}"}], ",", 
            RowBox[{"{", RowBox[{FractionBox[RowBox[{"a", "+", "b"}], 
                 RowBox[{"2", " ", "k"}]], ",", "LE"}], "}"}], ",", 
            RowBox[{"{", RowBox[{RowBox[{"1", "-", "ra"}], ",", 
                RowBox[{"-", "LA"}]}], "}"}], ",", 
            RowBox[{"{", RowBox[{RowBox[{"1", "-", "rb"}], ",", 
                RowBox[{"-", "LB"}]}], "}"}], ",", 
            RowBox[{"{", RowBox[{RowBox[{"1", "-", "na"}], ",", "LA"}], 
              "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"1", "-", "nb"}], ",", 
                "LB"}], "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"1", "-", 
                  "ca"}], ",", RowBox[{"LE", "-", "LB"}]}], "}"}], ",", 
            RowBox[{"{", RowBox[{RowBox[{"1", "-", "cb"}], ",", 
                RowBox[{"LE", "-", "LA"}]}], "}"}], ",", 
            RowBox[{"{", RowBox[{RowBox[{"1", "-", "rab"}], ",", 
                RowBox[{"LE", "-", "LA", "-", "LB"}]}], "}"}]}], "}"}]}], 
      ";", RowBox[{RowBox[{"reduceLog", "[", "z_", "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"hits", "=", 
                RowBox[{"Select", "[", RowBox[{"logTable", ",", RowBox[
                     {RowBox[{RowBox[{"Together", "[", RowBox[{"z", "-", 
                          RowBox[{"#1", "\[LeftDoubleBracket]", "1", 
                          "\[RightDoubleBracket]"}]}], "]"}], "===", "0"}], 
                      "&"}]}], "]"}]}], "}"}], ",", 
            RowBox[{"If", "[", RowBox[{RowBox[{"hits", "===", RowBox[
                   {"{", "}"}]}], ",", RowBox[{"unhandledLog", "[", "z", 
                  "]"}], ",", RowBox[{"hits", "\[LeftDoubleBracket]", 
                  RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]}], 
              "]"}]}], "]"}]}], ";", 
      RowBox[{RowBox[{"reduceLogs", "[", "e_", "]"}], ":=", 
        RowBox[{RowBox[{"e", "/.", "\[VeryThinSpace]", 
            RowBox[{RowBox[{"PolyLog", "[", RowBox[{"1", ",", "z_"}], "]"}], 
              "\[RuleDelayed]", RowBox[{"-", RowBox[{"Log", "[", 
                  RowBox[{"1", "-", "z"}], "]"}]}]}]}], "/.", 
          "\[VeryThinSpace]", RowBox[{RowBox[{"Log", "[", "z_", "]"}], 
            "\[RuleDelayed]", RowBox[{"reduceLog", "[", "z", "]"}]}]}]}], 
      ";", RowBox[{"logsSub", "=", RowBox[
         {"{", RowBox[{RowBox[{"lA", "\[Rule]", RowBox[{"Log", "[", 
                FractionBox[RowBox[{"a", "+", "k"}], RowBox[{"2", " ", 
                   "k"}]], "]"}]}], ",", RowBox[{"lB", "\[Rule]", 
              RowBox[{"Log", "[", FractionBox[RowBox[{"b", "+", "k"}], 
                 RowBox[{"2", " ", "k"}]], "]"}]}]}], "}"}]}], ";", 
      RowBox[{"fiveDeriv", "=", RowBox[{"Cancel", "[", 
          RowBox[{"Together", "[", RowBox[{"reduceLogs", "[", 
              RowBox[{SubscriptBox["\[PartialD]", RowBox[{"b"}]], 
                RowBox[{"(", RowBox[{"five", "/.", "\[VeryThinSpace]", 
                    "logsSub"}], ")"}]}], "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"checkExact", "[", RowBox[{"\"(4.28) b-derivatives agree\"", 
          ",", "fiveDeriv"}], "]"}], ";", 
      RowBox[{"Do", "[", RowBox[{RowBox[{"checkNumerical", "[", 
            RowBox[{RowBox[{"\"(4.28) at \"", "<>", RowBox[{"ToString", "[", 
                  RowBox[{"N", "[", RowBox[{"pt", ",", "2"}], "]"}], "]"}]}], 
              ",", RowBox[{"fiveL", "/.", "\[VeryThinSpace]", RowBox[
                 {"{", RowBox[{RowBox[{"a", "\[Rule]", RowBox[{"pt", 
                        "\[LeftDoubleBracket]", "1", 
                        "\[RightDoubleBracket]"}]}], ",", RowBox[{"b", 
                      "\[Rule]", RowBox[{"pt", "\[LeftDoubleBracket]", "2", 
                        "\[RightDoubleBracket]"}]}], ",", RowBox[{"k", 
                      "\[Rule]", RowBox[{"pt", "\[LeftDoubleBracket]", "3", 
                        "\[RightDoubleBracket]"}]}]}], "}"}]}], ",", 
              RowBox[{"fiveR", "/.", "\[VeryThinSpace]", RowBox[
                 {"{", RowBox[{RowBox[{"a", "\[Rule]", RowBox[{"pt", 
                        "\[LeftDoubleBracket]", "1", 
                        "\[RightDoubleBracket]"}]}], ",", RowBox[{"b", 
                      "\[Rule]", RowBox[{"pt", "\[LeftDoubleBracket]", "2", 
                        "\[RightDoubleBracket]"}]}], ",", RowBox[{"k", 
                      "\[Rule]", RowBox[{"pt", "\[LeftDoubleBracket]", "3", 
                        "\[RightDoubleBracket]"}]}]}], "}"}]}], ",", "20"}], 
            "]"}], ",", RowBox[{"{", RowBox[{"pt", ",", RowBox[{"{", 
                RowBox[{RowBox[{"{", RowBox[{FractionBox["13", "10"], ",", 
                      FractionBox["17", "10"], ",", FractionBox["7", "10"]}], 
                    "}"}], ",", RowBox[{"{", RowBox[{FractionBox["4", "5"], 
                      ",", FractionBox["3", "2"], ",", FractionBox["5", 
                       "2"]}], "}"}], ",", RowBox[{"{", RowBox[{"2", ",", 
                      "3", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], "]"}], ";", 
      RowBox[{"sectionRows", "[", "start", "]"}]}]], "Input"], 
  Cell[BoxData[TagBox[GridBox[{{"\"check\"", "\"kind\"", "\"residual\"", 
        "\"agreement\""}, {"\"(4.28) left side vanishes at b = k\"", 
        "\"exact\"", "0", "\"identity\""}, 
