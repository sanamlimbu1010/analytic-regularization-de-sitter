  Cell["6. Verification", "Section"], Cell["Landen's identity is checked for \
r12 and r34, the first line of (4.20) and its image.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"start", "=", 
        RowBox[{RowBox[{"Length", "[", "checks", "]"}], "+", "1"}]}], ";", 
      RowBox[{"checkExact", "[", RowBox[{"\"Landen partner for r12\"", ",", 
          RowBox[{"Together", "[", RowBox[{FractionBox["ra", RowBox[
