              "+", FractionBox["pMinus", RowBox[{"a", "-", "b"}]]}], 
            ")"}]}]}], ";", RowBox[{"fullDerivativeResidual", "=", 
        RowBox[{RowBox[{SubscriptBox["\[PartialD]", RowBox[{"k"}]], 
            "deltaExpr"}], "-", RowBox[{"2", " ", "k", " ", 
            RowBox[{"result421", "[", RowBox[{"a", ",", "b", ",", "k"}], 
              "]"}]}]}]}], ";", RowBox[{"checkExact", "[", 
        RowBox[{"\"derivative of (4.24) equals (4.21)\"", ",", 
          RowBox[{"Cancel", "[", RowBox[{"Together", "[", 
              RowBox[{RowBox[{"reduceAll", "[", "fullDerivativeResidual", 
                  "]"}], "/.", "\[VeryThinSpace]", RowBox[{"{", RowBox[
                   {RowBox[{"LA", "\[Rule]", "lA"}], ",", RowBox[{"LB", 
                      "\[Rule]", "lB"}], ",", RowBox[{"LE", "\[Rule]", 
                      RowBox[{"Log", "[", FractionBox[RowBox[{"a", "+", 
                          "b"}], RowBox[{"2", " ", "k"}]], "]"}]}]}], 
                  "}"}]}], "]"}], "]"}]}], "]"}], ";", 
      RowBox[{"sectionRows", "[", "start", "]"}]}]], "Input"], 
  Cell[BoxData[TagBox[GridBox[{{"\"check\"", "\"kind\"", "\"residual\"", 
        "\"agreement\""}, {"\"derivative of (4.24) equals (4.21)\"", 
