  Cell["The k-derivative of (4.24), reduced with Landen and (4.28), equals 2 \
k times (4.21). As k goes to infinity the trilogarithm arguments tend to -1, \
1/2, 1 and 1, and P+ and P- tend to 0. Equation (4.24) is compared with the \
integral (4.22) at (1.3, 1.7, 0.7), and with direct integration of (3.17), \
with [PZP] as in (4.23), at (1.3, 1.7, 0.7) and (0.8, 1.5, 2.5). The \
benchmark values are the reference.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"start", "=", 
        RowBox[{RowBox[{"Length", "[", "checks", "]"}], "+", "1"}]}], ";", 
      RowBox[{"liTable", "=", RowBox[{"{", RowBox[
           {RowBox[{"{", RowBox[{"ra", ",", RowBox[{RowBox[{"-", RowBox[
                     {"PolyLog", "[", RowBox[{"2", ",", "na"}], "]"}]}], "-", 
                  FractionBox[SuperscriptBox["LA", "2"], "2"]}]}], "}"}], 
            ",", RowBox[{"{", RowBox[{"rb", ",", RowBox[{RowBox[{"-", 
                    RowBox[{"PolyLog", "[", RowBox[{"2", ",", "nb"}], 
                      "]"}]}], "-", FractionBox[SuperscriptBox["LB", "2"], 
                   "2"]}]}], "}"}], ",", RowBox[{"{", RowBox[{"rab", ",", 
                RowBox[{RowBox[{"PolyLog", "[", RowBox[{"2", ",", "ca"}], 
                    "]"}], "+", RowBox[{"PolyLog", "[", RowBox[{"2", ",", 
                      "cb"}], "]"}], "-", RowBox[{"PolyLog", "[", RowBox[
                     {"2", ",", "na"}], "]"}], "-", RowBox[{"PolyLog", "[", 
                    RowBox[{"2", ",", "nb"}], "]"}], "-", RowBox[{"LA", " ", 
                    "LB"}]}]}], "}"}]}], "}"}]}], ";", 
      RowBox[{RowBox[{"reduceLi", "[", "z_", "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"hits", "=", 
                RowBox[{"Select", "[", RowBox[{"liTable", ",", RowBox[
                     {RowBox[{RowBox[{"Together", "[", RowBox[{"z", "-", 
                          RowBox[{"#1", "\[LeftDoubleBracket]", "1", 
                          "\[RightDoubleBracket]"}]}], "]"}], "===", "0"}], 
                      "&"}]}], "]"}]}], "}"}], ",", 
            RowBox[{"If", "[", RowBox[{RowBox[{"hits", "===", RowBox[
                   {"{", "}"}]}], ",", RowBox[{"PolyLog", "[", RowBox[
                   {"2", ",", "z"}], "]"}], ",", RowBox[{"hits", 
                  "\[LeftDoubleBracket]", RowBox[{"1", ",", "2"}], 
                  "\[RightDoubleBracket]"}]}], "]"}]}], "]"}]}], ";", 
      RowBox[{RowBox[{"reduceAll", "[", "e_", "]"}], ":=", 
        RowBox[{"Cancel", "[", RowBox[{"Together", "[", 
            RowBox[{RowBox[{"reduceLogs", "[", "e", "]"}], "/.", 
              "\[VeryThinSpace]", RowBox[{RowBox[{"PolyLog", "[", 
                  RowBox[{"2", ",", "z_"}], "]"}], "\[RuleDelayed]", 
                RowBox[{"reduceLi", "[", "z", "]"}]}]}], "]"}], "]"}]}], ";", 
      RowBox[{RowBox[{"result421", "[", RowBox[{"u_", ",", "v_", ",", "t_"}], 
          "]"}], ":=", FractionBox[RowBox[{SuperscriptBox["\[Pi]", "3"], " ", 
           RowBox[{"(", RowBox[{FractionBox[RowBox[{RowBox[{"PolyLog", "[", 
                    RowBox[{"2", ",", RowBox[{"-", FractionBox[RowBox[
                          {"v", "-", "t"}], RowBox[{"u", "+", "t"}]]}]}], 
                    "]"}], "-", RowBox[{"PolyLog", "[", RowBox[{"2", ",", 
                      RowBox[{"-", FractionBox[RowBox[{"v", "-", "t"}], 
                         RowBox[{"2", " ", "t"}]]}]}], "]"}], "+", 
                  RowBox[{FractionBox["1", "2"], " ", SuperscriptBox[
                     RowBox[{"Log", "[", FractionBox[RowBox[{"u", "+", "t"}], 
                        RowBox[{"2", " ", "t"}]], "]"}], "2"]}]}], 
                RowBox[{RowBox[{"(", RowBox[{"u", "-", "t"}], ")"}], " ", 
                  RowBox[{"(", RowBox[{"v", "+", "t"}], ")"}]}]], "+", 
               FractionBox[RowBox[{RowBox[{"PolyLog", "[", RowBox[{"2", ",", 
                      RowBox[{"-", FractionBox[RowBox[{"u", "-", "t"}], 
                         RowBox[{"v", "+", "t"}]]}]}], "]"}], "-", 
                  RowBox[{"PolyLog", "[", RowBox[{"2", ",", RowBox[{"-", 
                        FractionBox[RowBox[{"u", "-", "t"}], RowBox[{"2", 
                          " ", "t"}]]}]}], "]"}], "+", RowBox[{FractionBox[
                     "1", "2"], " ", SuperscriptBox[RowBox[{"Log", "[", 
