  Cell["4. Section 4.2.3, the closed form", "Section"], 
  Cell["Differentiation lowers the transcendental weight by one. The \
displayed partial-fraction identity is checked exactly. Each trilogarithm \
argument u, and 1 - u, factors, up to sign, into powers of 2k, a +- k, b +- k \
and E = a + b. P+ and P- are (4.25) and (4.26), and Delta is (4.24). P+ is \
symmetric and P- antisymmetric under the simultaneous exchange a <-> b. For \
positive momenta every logarithm has a positive argument and every \
polylogarithm argument is below 1.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"start", "=", 
        RowBox[{RowBox[{"Length", "[", "checks", "]"}], "+", "1"}]}], ";", 
      RowBox[{"checkExact", "[", RowBox[{"\"weight lowering\"", ",", 
          RowBox[{"FullSimplify", "[", RowBox[{RowBox[{RowBox[
                 {SubscriptBox["\[PartialD]", RowBox[{"k"}]], RowBox[
                   {"PolyLog", "[", RowBox[{"n", ",", RowBox[{"u", "[", "k", 
                        "]"}]}], "]"}]}], "-", RowBox[{RowBox[{"PolyLog", 
                    "[", RowBox[{RowBox[{"n", "-", "1"}], ",", RowBox[
                       {"u", "[", "k", "]"}]}], "]"}], " ", RowBox[
                   {SubscriptBox["\[PartialD]", RowBox[{"k"}]], RowBox[
                     {"Log", "[", RowBox[{"u", "[", "k", "]"}], "]"}]}]}]}], 
              ",", RowBox[{"Assumptions", "\[Rule]", RowBox[
                 {RowBox[{"n", ">", "1"}], "&&", RowBox[{"n", "\[Element]", 
                    TemplateBox[{}, "Integers"]}]}]}]}], "]"}]}], "]"}], ";", 
      RowBox[{"checkExact", "[", RowBox[{"\"partial fractions\"", ",", 
          RowBox[{"Together", "[", RowBox[{FractionBox["1", RowBox[
                {RowBox[{"(", RowBox[{"a", "-", "k"}], ")"}], " ", 
                 RowBox[{"(", RowBox[{"b", "+", "k"}], ")"}]}]], "-", 
              FractionBox[RowBox[{FractionBox["1", RowBox[{"a", "-", "k"}]], 
                 "+", FractionBox["1", RowBox[{"b", "+", "k"}]]}], RowBox[
                {"a", "+", "b"}]]}], "]"}]}], "]"}], ";", 
      RowBox[{"uList", "=", RowBox[{"{", RowBox[{"ra", ",", "rb", ",", "rab", 
            ",", "na", ",", "nb", ",", "ca", ",", "cb"}], "}"}]}], ";", 
      RowBox[{"uNames", "=", RowBox[{"{", RowBox[{"\"(a-k)/(a+k)\"", ",", 
            "\"(b-k)/(b+k)\"", ",", "\"r12 r34\"", ",", "\"-(a-k)/(2k)\"", 
            ",", "\"-(b-k)/(2k)\"", ",", "\"-(a-k)/(b+k)\"", ",", 
            "\"-(b-k)/(a+k)\""}], "}"}]}], ";", 
      RowBox[{"expectedU", "=", RowBox[
         {"{", RowBox[{FractionBox[RowBox[{"a", "-", "k"}], 
             RowBox[{"a", "+", "k"}]], ",", FractionBox[
             RowBox[{"b", "-", "k"}], RowBox[{"b", "+", "k"}]], ",", 
            FractionBox[RowBox[{RowBox[{"(", RowBox[{"a", "-", "k"}], ")"}], 
               " ", RowBox[{"(", RowBox[{"b", "-", "k"}], ")"}]}], 
             RowBox[{RowBox[{"(", RowBox[{"a", "+", "k"}], ")"}], " ", RowBox[
                {"(", RowBox[{"b", "+", "k"}], ")"}]}]], ",", 
            RowBox[{"-", FractionBox[RowBox[{"a", "-", "k"}], RowBox[
                {"2", " ", "k"}]]}], ",", RowBox[{"-", FractionBox[RowBox[
                {"b", "-", "k"}], RowBox[{"2", " ", "k"}]]}], ",", 
            RowBox[{"-", FractionBox[RowBox[{"a", "-", "k"}], RowBox[
                {"b", "+", "k"}]]}], ",", RowBox[{"-", FractionBox[RowBox[
                {"b", "-", "k"}], RowBox[{"a", "+", "k"}]]}]}], "}"}]}], ";", 
      RowBox[{"expectedOne", "=", RowBox[
         {"{", RowBox[{FractionBox[RowBox[{"2", " ", "k"}], 
             RowBox[{"a", "+", "k"}]], ",", FractionBox[
             RowBox[{"2", " ", "k"}], RowBox[{"b", "+", "k"}]], ",", 
            FractionBox[RowBox[{"2", " ", "k", " ", RowBox[{"(", 
                 RowBox[{"a", "+", "b"}], ")"}]}], RowBox[
              {RowBox[{"(", RowBox[{"a", "+", "k"}], ")"}], " ", RowBox[
                {"(", RowBox[{"b", "+", "k"}], ")"}]}]], ",", 
            FractionBox[RowBox[{"a", "+", "k"}], RowBox[{"2", " ", "k"}]], 
            ",", FractionBox[RowBox[{"b", "+", "k"}], 
             RowBox[{"2", " ", "k"}]], ",", FractionBox[
             RowBox[{"a", "+", "b"}], RowBox[{"b", "+", "k"}]], ",", 
            FractionBox[RowBox[{"a", "+", "b"}], RowBox[{"a", "+", "k"}]]}], 
          "}"}]}], ";", RowBox[{"checkExact", "[", 
        RowBox[{"\"Factor[u] on the trilogarithm arguments\"", ",", 
          RowBox[{"Total", "[", RowBox[{"Together", "[", RowBox[{
                RowBox[{"Factor", "[", "uList", "]"}], "-", "expectedU"}], 
              "]"}], "]"}]}], "]"}], ";", RowBox[{"checkExact", "[", 
        RowBox[{"\"Factor[1-u] on the trilogarithm arguments\"", ",", 
          RowBox[{"Total", "[", RowBox[{"Together", "[", RowBox[{
                RowBox[{"Factor", "[", RowBox[{"1", "-", "uList"}], "]"}], 
                "-", "expectedOne"}], "]"}], "]"}]}], "]"}], ";", 
      RowBox[{"factorGrid", "=", RowBox[{"Grid", "[", 
          RowBox[{RowBox[{"Prepend", "[", RowBox[{RowBox[{"Table", "[", 
                  RowBox[{RowBox[{"{", RowBox[{RowBox[{"uNames", 
                          "\[LeftDoubleBracket]", "i", 
                          "\[RightDoubleBracket]"}], ",", RowBox[{"Factor", 
                          "[", RowBox[{"uList", "\[LeftDoubleBracket]", "i", 
                          "\[RightDoubleBracket]"}], "]"}], ",", RowBox[
                         {"Factor", "[", RowBox[{"1", "-", RowBox[{"uList", 
                          "\[LeftDoubleBracket]", "i", 
                          "\[RightDoubleBracket]"}]}], "]"}]}], "}"}], ",", 
                    RowBox[{"{", RowBox[{"i", ",", RowBox[{"Length", "[", 
                          "uList", "]"}]}], "}"}]}], "]"}], ",", 
                RowBox[{"{", RowBox[{"\"u\"", ",", "\"Factor[u]\"", ",", 
                    "\"Factor[1-u]\""}], "}"}]}], "]"}], ",", 
            RowBox[{"Frame", "\[Rule]", "All"}]}], "]"}]}], ";", 
      RowBox[{RowBox[{"canonPoly", "[", "e_", "]"}], ":=", 
        RowBox[{"e", "/.", "\[VeryThinSpace]", 
          RowBox[{RowBox[{"PolyLog", "[", RowBox[{"n_", ",", "z_"}], "]"}], 
            "\[RuleDelayed]", RowBox[{"PolyLog", "[", RowBox[{"n", ",", 
                RowBox[{"Together", "[", "z", "]"}]}], "]"}]}]}]}], ";", 
      RowBox[{RowBox[{"swap", "[", "e_", "]"}], ":=", 
        RowBox[{"e", "/.", "\[VeryThinSpace]", 
          RowBox[{"{", RowBox[{RowBox[{"a", "\[Rule]", "b"}], ",", 
              RowBox[{"b", "\[Rule]", "a"}]}], "}"}]}]}], ";", 
      RowBox[{"checkExact", "[", RowBox[{"\"P+ symmetric under a <-> b\"", 
          ",", RowBox[{"Together", "[", RowBox[{"canonPoly", "[", 
              RowBox[{"pPlus", "-", RowBox[{"swap", "[", "pPlus", "]"}]}], 
              "]"}], "]"}]}], "]"}], ";", RowBox[{"checkExact", "[", 
        RowBox[{"\"P- antisymmetric under a <-> b\"", ",", 
          RowBox[{"Together", "[", RowBox[{"canonPoly", "[", 
              RowBox[{"pMinus", "+", RowBox[{"swap", "[", "pMinus", "]"}]}], 
              "]"}], "]"}]}], "]"}], ";", RowBox[{"checkTrue", "[", 
        RowBox[{"\"(4.25) and (4.26): positive logs and polylogarithm \
arguments below 1\"", ",", RowBox[{"Resolve", "[", 
            RowBox[{RowBox[{SubscriptBox["\[ForAll]", RowBox[
                  {RowBox[{"{", RowBox[{"a", ",", "b", ",", "k"}], "}"}], 
                   ",", RowBox[{RowBox[{"a", ">", "0"}], "&&", RowBox[
                      {"b", ">", "0"}], "&&", RowBox[{"k", ">", "0"}]}]}]], 
                RowBox[{"(", RowBox[{RowBox[{FractionBox[RowBox[{RowBox[
                          {"(", RowBox[{"a", "+", "k"}], ")"}], " ", RowBox[
                          {"(", RowBox[{"b", "+", "k"}], ")"}]}], RowBox[
                        {"4", " ", SuperscriptBox["k", "2"]}]], ">", "0"}], 
                    "&&", RowBox[{FractionBox[RowBox[{"a", "+", "k"}], 
                       RowBox[{"b", "+", "k"}]], ">", "0"}], "&&", 
                    RowBox[{FractionBox[RowBox[{"a", "+", "k"}], RowBox[
                        {"2", " ", "k"}]], ">", "0"}], "&&", RowBox[
                     {FractionBox[RowBox[{"b", "+", "k"}], RowBox[{"2", " ", 
                         "k"}]], ">", "0"}], "&&", RowBox[{FractionBox[
                       RowBox[{"a", "-", "k"}], RowBox[{"a", "+", "k"}]], 
                      "<", "1"}], "&&", RowBox[{FractionBox[RowBox[{"b", "-", 
                         "k"}], RowBox[{"b", "+", "k"}]], "<", "1"}], "&&", 
                    RowBox[{FractionBox[RowBox[{RowBox[{"(", RowBox[{"a", 
                          "-", "k"}], ")"}], " ", RowBox[{"(", RowBox[{"b", 
                          "-", "k"}], ")"}]}], RowBox[{RowBox[{"(", RowBox[
                          {"a", "+", "k"}], ")"}], " ", RowBox[{"(", RowBox[
                          {"b", "+", "k"}], ")"}]}]], "<", "1"}], "&&", 
                    RowBox[{RowBox[{"-", FractionBox[RowBox[{"a", "-", "k"}], 
                         RowBox[{"2", " ", "k"}]]}], "<", "1"}], "&&", 
                    RowBox[{RowBox[{"-", FractionBox[RowBox[{"b", "-", "k"}], 
                         RowBox[{"2", " ", "k"}]]}], "<", "1"}], "&&", 
                    RowBox[{RowBox[{"-", FractionBox[RowBox[{"a", "-", "k"}], 
                         RowBox[{"b", "+", "k"}]]}], "<", "1"}], "&&", 
                    RowBox[{RowBox[{"-", FractionBox[RowBox[{"b", "-", "k"}], 
                         RowBox[{"a", "+", "k"}]]}], "<", "1"}]}], ")"}]}], 
              ",", TemplateBox[{}, "Reals"]}], "]"}]}], "]"}], ";", 
      RowBox[{"{", RowBox[{"factorGrid", ",", RowBox[{"sectionRows", "[", 
            "start", "]"}]}], "}"}]}]], "Input"], 
  Cell[BoxData[RowBox[
     {"{", RowBox[{TagBox[GridBox[{{"\"u\"", "\"Factor[u]\"", 
            "\"Factor[1-u]\""}, {"\"(a-k)/(a+k)\"", FractionBox[
             RowBox[{"a", "-", "k"}], RowBox[{"a", "+", "k"}]], 
            FractionBox[RowBox[{"2", " ", "k"}], RowBox[{"a", "+", "k"}]]}, 
           {"\"(b-k)/(b+k)\"", FractionBox[RowBox[{"b", "-", "k"}], 
             RowBox[{"b", "+", "k"}]], FractionBox[RowBox[{"2", " ", "k"}], 
             RowBox[{"b", "+", "k"}]]}, {"\"r12 r34\"", 
            RowBox[{"-", FractionBox[RowBox[{RowBox[{"(", RowBox[{"a", "-", 
                     "k"}], ")"}], " ", RowBox[{"(", RowBox[{RowBox[
                      {"-", "b"}], "+", "k"}], ")"}]}], RowBox[
                {RowBox[{"(", RowBox[{"a", "+", "k"}], ")"}], " ", 
                 RowBox[{"(", RowBox[{"b", "+", "k"}], ")"}]}]]}], 
            FractionBox[RowBox[{"2", " ", RowBox[{"(", RowBox[{"a", "+", 
                   "b"}], ")"}], " ", "k"}], RowBox[{RowBox[{"(", 
                 RowBox[{"a", "+", "k"}], ")"}], " ", RowBox[
                {"(", RowBox[{"b", "+", "k"}], ")"}]}]]}, {"\"-(a-k)/(2k)\"", 
            RowBox[{"-", FractionBox[RowBox[{"a", "-", "k"}], RowBox[
                {"2", " ", "k"}]]}], FractionBox[RowBox[{"a", "+", "k"}], 
             RowBox[{"2", " ", "k"}]]}, {"\"-(b-k)/(2k)\"", 
            RowBox[{"-", FractionBox[RowBox[{"b", "-", "k"}], RowBox[
                {"2", " ", "k"}]]}], FractionBox[RowBox[{"b", "+", "k"}], 
             RowBox[{"2", " ", "k"}]]}, {"\"-(a-k)/(b+k)\"", 
            RowBox[{"-", FractionBox[RowBox[{"a", "-", "k"}], RowBox[
                {"b", "+", "k"}]]}], FractionBox[RowBox[{"a", "+", "b"}], 
             RowBox[{"b", "+", "k"}]]}, {"\"-(b-k)/(a+k)\"", 
            RowBox[{"-", FractionBox[RowBox[{"b", "-", "k"}], RowBox[
                {"a", "+", "k"}]]}], FractionBox[RowBox[{"a", "+", "b"}], 
             RowBox[{"a", "+", "k"}]]}}, AutoDelete -> False, 
          GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
          GridBoxItemSize -> {"Columns" -> {{Automatic}}, 
            "Rows" -> {{Automatic}}}], "Grid"], ",", 
        TagBox[GridBox[{{"\"check\"", "\"kind\"", "\"residual\"", 
            "\"agreement\""}, {"\"weight lowering\"", "\"exact\"", "0", 
            "\"identity\""}, {"\"partial fractions\"", "\"exact\"", "0", 
            "\"identity\""}, {"\"Factor[u] on the trilogarithm arguments\"", 
            "\"exact\"", "0", "\"identity\""}, 
           {"\"Factor[1-u] on the trilogarithm arguments\"", "\"exact\"", 
