Notebook[
 {Cell["Chapter 4 companion: the undifferentiated three-loop difference", 
   "Title"], Cell["Thesis: Comparing UV Regularizations for Cosmological \
Correlators in de Sitter Space, Sanam Limbu (LMU Munich, 2026), Chapter 4. \
Notation: a = k12, b = k34, and k is the exchanged momentum. 14.3.0 for \
Microsoft Windows (64-bit) (July 8, 2025).", "Text"], 
  Cell["This notebook follows section 4.2. It records the computer-algebra \
steps behind the boxed difference (4.24). It does not depend on the \
derivative notebook. Exact checks return a zero residual under a > 0, b > 0, \
k > 0. Numerical checks state how many digits agreed. A precision goal is not \
an error bound. The ansatz search that found (4.24) is not used, and the \
bounds behind the large-k limit are not added.", "Text"], 
  Cell["1. Setup", "Section"], Cell["a = k12, b = k34, and k is the exchanged \
momentum, all positive. Each check stores its name, whether it is exact or \
numerical, and its residual. A failed check aborts the evaluation.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", "\"Global`*\"", "]"}], ";", 
      RowBox[{"$MaxExtraPrecision", "=", "10000"}], ";", 
      RowBox[{"checks", "=", RowBox[{"{", "}"}]}], ";", 
      RowBox[{"assumptions", "=", RowBox[{RowBox[{"a", ">", "0"}], "&&", 
          RowBox[{"b", ">", "0"}], "&&", RowBox[{"k", ">", "0"}]}]}], ";", 
      RowBox[{RowBox[{"failCheck", "[", RowBox[{"name_", ",", "detail_"}], 
          "]"}], ":=", RowBox[{"(", RowBox[{RowBox[{"Print", "[", 
              RowBox[{"\"FAILED: \"", ",", "name"}], "]"}], ";", 
            RowBox[{"Print", "[", "detail", "]"}], ";", 
            RowBox[{"Abort", "[", "]"}]}], ")"}]}], ";", 
      RowBox[{RowBox[{"checkExact", "[", RowBox[{"name_", ",", "residual_"}], 
          "]"}], ":=", RowBox[{"Module", "[", 
          RowBox[{RowBox[{"{", RowBox[{"r", "=", "residual"}], "}"}], ",", 
            RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"r", "=!=", "0"}], 
                  ",", RowBox[{"r", "=", RowBox[{"Together", "[", "residual", 
                      "]"}]}]}], "]"}], ";", RowBox[{"If", "[", 
                RowBox[{RowBox[{"r", "=!=", "0"}], ",", RowBox[{"r", "=", 
                    RowBox[{"Expand", "[", "residual", "]"}]}]}], "]"}], ";", 
              RowBox[{"If", "[", RowBox[{RowBox[{"r", "=!=", "0"}], ",", 
                  RowBox[{"r", "=", RowBox[{"Simplify", "[", RowBox[
                       {"residual", ",", RowBox[{"Assumptions", "\[Rule]", 
                          "assumptions"}]}], "]"}]}]}], "]"}], ";", 
              RowBox[{"If", "[", RowBox[{RowBox[{"r", "=!=", "0"}], ",", 
                  RowBox[{"r", "=", RowBox[{"FullSimplify", "[", RowBox[
                       {"residual", ",", RowBox[{"Assumptions", "\[Rule]", 
                          "assumptions"}]}], "]"}]}]}], "]"}], ";", 
              RowBox[{"If", "[", RowBox[{RowBox[{"r", "=!=", "0"}], ",", 
                  RowBox[{"failCheck", "[", RowBox[{"name", ",", 
                      "residual"}], "]"}]}], "]"}], ";", RowBox[{"AppendTo", 
                "[", RowBox[{"checks", ",", RowBox[{"Association", "[", 
                    RowBox[{RowBox[{"\"name\"", "\[Rule]", "name"}], ",", 
                      RowBox[{"\"kind\"", "\[Rule]", "\"exact\""}], ",", 
                      RowBox[{"\"residual\"", "\[Rule]", "0"}], ",", 
                      RowBox[{"\"agreement\"", "\[Rule]", "\"identity\""}]}], 
                    "]"}]}], "]"}], ";", "0"}]}], "]"}]}], ";", 
      RowBox[{RowBox[{"checkTrue", "[", RowBox[{"name_", ",", "value_"}], 
          "]"}], ":=", RowBox[{"If", "[", RowBox[
           {RowBox[{"TrueQ", "[", "value", "]"}], ",", 
            RowBox[{"checkExact", "[", RowBox[{"name", ",", "0"}], "]"}], 
            ",", RowBox[{"failCheck", "[", RowBox[{"name", ",", "value"}], 
              "]"}]}], "]"}]}], ";", 
      RowBox[{RowBox[{"checkNumerical", "[", RowBox[{"name_", ",", "got_", 
            ",", "want_", ",", "digits_Integer"}], "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"diff", ",", 
                "scale", ",", "rel", ",", "agreement"}], "}"}], ",", 
            RowBox[{RowBox[{"diff", "=", RowBox[{"Quiet", "[", RowBox[
                   {RowBox[{RowBox[{"N", "[", RowBox[{"got", ",", RowBox[
                          {"digits", "+", "10"}]}], "]"}], "-", RowBox[
                       {"N", "[", RowBox[{"want", ",", RowBox[{"digits", "+", 
                          "10"}]}], "]"}]}], ",", RowBox[{"{", RowBox[
                       {StyleBox[RowBox[{"N", "::", "meprec"}], 
                         "MessageName"], ",", StyleBox[RowBox[{"N", "::", 
                          "precw"}], "MessageName"]}], "}"}]}], "]"}]}], ";", 
              RowBox[{"If", "[", RowBox[{RowBox[{"!", RowBox[{"NumericQ", 
                      "[", "diff", "]"}]}], ",", RowBox[{"failCheck", "[", 
                    RowBox[{"name", ",", "diff"}], "]"}]}], "]"}], ";", 
              RowBox[{"scale", "=", RowBox[{"Max", "[", RowBox[{"1", ",", 
                    RowBox[{"Abs", "[", RowBox[{"Quiet", "[", RowBox[
                         {RowBox[{"N", "[", RowBox[{"want", ",", RowBox[
                          {"digits", "+", "10"}]}], "]"}], ",", RowBox[
                          {"{", RowBox[{StyleBox[RowBox[{"N", "::", 
                          "meprec"}], "MessageName"], ",", StyleBox[RowBox[
                          {"N", "::", "precw"}], "MessageName"]}], "}"}]}], 
                        "]"}], "]"}]}], "]"}]}], ";", RowBox[{"rel", "=", 
                FractionBox[RowBox[{"Abs", "[", "diff", "]"}], "scale"]}], 
              ";", RowBox[{"agreement", "=", RowBox[{"If", "[", RowBox[
                   {RowBox[{"rel", "\[Equal]", "0"}], ",", RowBox[{"digits", 
                      "+", "10"}], ",", RowBox[{"Floor", "[", RowBox[
                       {"-", RowBox[{"Log10", "[", "rel", "]"}]}], "]"}]}], 
                  "]"}]}], ";", RowBox[{"If", "[", RowBox[
                 {RowBox[{RowBox[{"!", RowBox[{"IntegerQ", "[", "agreement", 
                        "]"}]}], "||", RowBox[{"agreement", "<", 
                      "digits"}]}], ",", RowBox[{"failCheck", "[", 
                    RowBox[{"name", ",", RowBox[{"{", RowBox[{RowBox[{"N", 
                          "[", RowBox[{"diff", ",", "8"}], "]"}], ",", 
                          "agreement"}], "}"}]}], "]"}]}], "]"}], ";", 
              RowBox[{"AppendTo", "[", RowBox[{"checks", ",", RowBox[
                   {"Association", "[", RowBox[{RowBox[{"\"name\"", 
                        "\[Rule]", "name"}], ",", RowBox[{"\"kind\"", 
                        "\[Rule]", "\"numerical\""}], ",", RowBox[
                       {"\"residual\"", "\[Rule]", RowBox[{"N", "[", RowBox[
                          {"diff", ",", "6"}], "]"}]}], ",", RowBox[
                       {"\"agreement\"", "\[Rule]", RowBox[{RowBox[
                          {"ToString", "[", "agreement", "]"}], "<>", 
                          "\" digits\""}]}]}], "]"}]}], "]"}], ";", 
              "agreement"}]}], "]"}]}], ";", 
      RowBox[{RowBox[{"bench", "[", "s_String", "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"t", "=", "s"}], ",", 
                RowBox[{"sign", "=", "1"}], ",", "parts", ",", "frac"}], 
              "}"}], ",", RowBox[{RowBox[{"If", "[", RowBox[
                 {RowBox[{"StringStartsQ", "[", RowBox[{"t", ",", "\"-\""}], 
                    "]"}], ",", RowBox[{RowBox[{"sign", "=", RowBox[
                       {"-", "1"}]}], ";", RowBox[{"t", "=", RowBox[
                       {"StringDrop", "[", RowBox[{"t", ",", "1"}], 
                        "]"}]}]}]}], "]"}], ";", RowBox[{"parts", "=", 
                RowBox[{"StringSplit", "[", RowBox[{"t", ",", "\".\""}], 
                  "]"}]}], ";", RowBox[{"frac", "=", RowBox[{"If", "[", 
                  RowBox[{RowBox[{RowBox[{"Length", "[", "parts", "]"}], 
                      "\[Equal]", "1"}], ",", "\"\"", ",", RowBox[{"parts", 
                      "\[LeftDoubleBracket]", "2", 
                      "\[RightDoubleBracket]"}]}], "]"}]}], ";", 
              FractionBox[RowBox[{"sign", " ", RowBox[{"ToExpression", "[", 
                   RowBox[{"StringDelete", "[", RowBox[{"t", ",", "\".\""}], 
                     "]"}], "]"}]}], SuperscriptBox["10", RowBox[
                 {"StringLength", "[", "frac", "]"}]]]}]}], "]"}]}], ";", 
      RowBox[{RowBox[{"sectionRows", "[", "start_Integer", "]"}], ":=", 
        RowBox[{"Grid", "[", RowBox[{RowBox[{"Prepend", "[", 
              RowBox[{RowBox[{"Values", "/@", RowBox[{"checks", 
                    "\[LeftDoubleBracket]", RowBox[{"start", ";;", "All"}], 
                    "\[RightDoubleBracket]"}]}], ",", RowBox[{"{", 
                  RowBox[{"\"check\"", ",", "\"kind\"", ",", "\"residual\"", 
                    ",", "\"agreement\""}], "}"}]}], "]"}], ",", 
            RowBox[{"Frame", "\[Rule]", "All"}], ",", 
            RowBox[{"Alignment", "\[Rule]", "Left"}]}], "]"}]}], ";", 
      "$Version"}]], "Input"], 
  Cell[BoxData["\"14.3.0 for Microsoft Windows (64-bit) (July 8, 2025)\""], 
   "Output"], Cell["2. Section 4.2.1, the integration prescription (4.23)", 
   "Section"], Cell["The energy integral in (4.23) is called the loop factor \
F[a, k, z]. Its closed form uses Log[Abs[k^2 - a^2]], which is needed for k > \
a. The cells compare it with oscillatory quadrature by LevinRule for k below \
a, k above a, and k close to a, at several positive z, and with the two \
benchmark values.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"start", "=", 
        RowBox[{RowBox[{"Length", "[", "checks", "]"}], "+", "1"}]}], ";", 
      RowBox[{RowBox[{"F", "[", RowBox[{RowBox[{"u_", "?", "NumericQ"}], ",", 
            RowBox[{"t_", "?", "NumericQ"}], ",", RowBox[{"z_", "?", 
              "NumericQ"}]}], "]"}], ":=", 
        RowBox[{RowBox[{"\[Pi]", " ", RowBox[{"Exp", "[", 
              RowBox[{RowBox[{"-", "u"}], " ", "z"}], "]"}], " ", 
            RowBox[{"Log", "[", RowBox[{"Abs", "[", RowBox[{SuperscriptBox[
                   "t", "2"], "-", SuperscriptBox["u", "2"]}], "]"}], 
              "]"}]}], "-", RowBox[{"\[Pi]", " ", RowBox[{"Exp", "[", 
              RowBox[{RowBox[{"-", "u"}], " ", "z"}], "]"}], " ", 
            RowBox[{"ExpIntegralEi", "[", RowBox[{RowBox[{"(", RowBox[
                   {"u", "-", "t"}], ")"}], " ", "z"}], "]"}]}], "+", 
          RowBox[{"\[Pi]", " ", RowBox[{"Exp", "[", RowBox[{"u", " ", "z"}], 
              "]"}], " ", RowBox[{"ExpIntegralEi", "[", RowBox[{
                RowBox[{"-", RowBox[{"(", RowBox[{"u", "+", "t"}], ")"}]}], 
                " ", "z"}], "]"}]}]}]}], ";", 
      RowBox[{RowBox[{"fNum", "[", RowBox[{"u_", ",", "t_", ",", "z_"}], 
          "]"}], ":=", RowBox[{"2", " ", RowBox[{"NIntegrate", "[", 
            RowBox[{FractionBox[RowBox[{"u", " ", RowBox[{"Log", "[", 
                   RowBox[{SuperscriptBox["p", "2"], "+", SuperscriptBox["t", 
                      "2"]}], "]"}], " ", RowBox[{"Cos", "[", RowBox[
                    {"p", " ", "z"}], "]"}]}], RowBox[{SuperscriptBox["p", 
                  "2"], "+", SuperscriptBox["u", "2"]}]], ",", 
              RowBox[{"{", RowBox[{"p", ",", "0", ",", "\[Infinity]"}], 
                "}"}], ",", RowBox[{"Method", "\[Rule]", "\"LevinRule\""}], 
              ",", RowBox[{"WorkingPrecision", "\[Rule]", "22"}], ",", 
              RowBox[{"PrecisionGoal", "\[Rule]", "14"}], ",", 
              RowBox[{"MaxRecursion", "\[Rule]", "30"}]}], "]"}]}]}], ";", 
      RowBox[{"fTests", "=", RowBox[{"{", RowBox[
           {RowBox[{"{", RowBox[{FractionBox["13", "10"], ",", FractionBox[
                 "7", "10"], ",", FractionBox["1", "4"]}], "}"}], ",", 
            RowBox[{"{", RowBox[{FractionBox["13", "10"], ",", FractionBox[
                 "7", "10"], ",", "1"}], "}"}], ",", 
            RowBox[{"{", RowBox[{FractionBox["13", "10"], ",", FractionBox[
                 "7", "10"], ",", "3"}], "}"}], ",", 
            RowBox[{"{", RowBox[{FractionBox["4", "5"], ",", FractionBox["5", 
                 "2"], ",", FractionBox["1", "4"]}], "}"}], ",", 
            RowBox[{"{", RowBox[{FractionBox["4", "5"], ",", FractionBox["5", 
                 "2"], ",", FractionBox["6", "5"]}], "}"}], ",", 
            RowBox[{"{", RowBox[{FractionBox["4", "5"], ",", FractionBox["5", 
                 "2"], ",", "3"}], "}"}], ",", RowBox[
             {"{", RowBox[{"1", ",", FractionBox["1000001", "1000000"], ",", 
                FractionBox["1", "4"]}], "}"}], ",", 
            RowBox[{"{", RowBox[{"1", ",", FractionBox["1000001", "1000000"], 
                ",", "1"}], "}"}], ",", RowBox[{"{", RowBox[{"1", ",", 
                FractionBox["1000001", "1000000"], ",", "3"}], "}"}]}], 
          "}"}]}], ";", RowBox[{"Do", "[", 
        RowBox[{RowBox[{"checkNumerical", "[", RowBox[
             {RowBox[{"\"F against LevinRule at \"", "<>", RowBox[
                 {"ToString", "[", RowBox[{"N", "[", RowBox[{"test", ",", 
                      "4"}], "]"}], "]"}]}], ",", RowBox[{"F", "@@", 
                "test"}], ",", RowBox[{"fNum", "@@", "test"}], ",", "12"}], 
            "]"}], ",", RowBox[{"{", RowBox[{"test", ",", "fTests"}], 
            "}"}]}], "]"}], ";", RowBox[{"checkNumerical", "[", 
        RowBox[{"\"F benchmark (1.3, 0.7, 1)\"", ",", 
          RowBox[{"F", "[", RowBox[{FractionBox["13", "10"], ",", 
              FractionBox["7", "10"], ",", "1"}], "]"}], ",", 
          RowBox[{"bench", "[", "\"-1.06675665228338521805\"", "]"}], ",", 
          "16"}], "]"}], ";", RowBox[{"checkNumerical", "[", 
        RowBox[{"\"F benchmark (0.8, 2.5, 1.2)\"", ",", 
          RowBox[{"F", "[", RowBox[{FractionBox["4", "5"], ",", 
              FractionBox["5", "2"], ",", FractionBox["6", "5"]}], "]"}], 
          ",", RowBox[{"bench", "[", "\"2.097562421166968576594\"", "]"}], 
          ",", "16"}], "]"}], ";", RowBox[{"sectionRows", "[", "start", 
        "]"}]}]], "Input"], 
  Cell[BoxData[TagBox[GridBox[{{"\"check\"", "\"kind\"", "\"residual\"", 
        "\"agreement\""}, 
       {"\"F against LevinRule at {1.300, 0.7000, 0.2500}\"", 
        "\"numerical\"", "7.741956663008475987`3.7938460695235103*^-19", 
        "\"18 digits\""}, 
       {"\"F against LevinRule at {1.300, 0.7000, 1.000}\"", "\"numerical\"", 
        RowBox[{"-", "3.43137044816134840796`4.206372251231783*^-18"}], 
        "\"17 digits\""}, 
       {"\"F against LevinRule at {1.300, 0.7000, 3.000}\"", "\"numerical\"", 
        "2.08612455248485586`2.520622777673855*^-20", "\"19 digits\""}, 
       {"\"F against LevinRule at {0.8000, 2.500, 0.2500}\"", 
        "\"numerical\"", RowBox[{"-", 
          "1.116504156349051701961`4.047885905214284*^-17"}], 
        "\"17 digits\""}, 
       {"\"F against LevinRule at {0.8000, 2.500, 1.200}\"", "\"numerical\"", 
        RowBox[{"-", "6.72278412033719935763`4.204804276081506*^-18"}], 
        "\"17 digits\""}, 
       {"\"F against LevinRule at {0.8000, 2.500, 3.000}\"", "\"numerical\"", 
        "5.21858611368754273753`4.724888480582574*^-18", "\"17 digits\""}, 
       {"\"F against LevinRule at {1.000, 1.000, 0.2500}\"", "\"numerical\"", 
        "5.9554007923749326463`3.3223888525900915*^-19", "\"18 digits\""}, 
       {"\"F against LevinRule at {1.000, 1.000, 1.000}\"", "\"numerical\"", 
        RowBox[{"-", "5.495693908626214322`3.9862712608009003*^-19"}], 
        "\"18 digits\""}, 
       {"\"F against LevinRule at {1.000, 1.000, 3.000}\"", "\"numerical\"", 
        "1.604711200665591468`2.657812768022215*^-20", "\"19 digits\""}, 
       {"\"F benchmark (1.3, 0.7, 1)\"", "\"numerical\"", 
        RowBox[{"-", "1.0368074680878201`3.686602761286058*^-22"}], 
        "\"22 digits\""}, {"\"F benchmark (0.8, 2.5, 1.2)\"", 
        "\"numerical\"", RowBox[{"-", 
          "9.17115736462286`2.33967925592749*^-24"}], "\"23 digits\""}}, 
      GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
      GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
      GridBoxItemSize -> {"Columns" -> {{Automatic}}, 
        "Rows" -> {{Automatic}}}], "Grid"]], "Output"], 
  Cell["3. Section 4.2.2, the limit at large k", "Section"], 
  Cell["Under a common shift of every momentum logarithm, each three-loop \
string changes by strings in which one or more loops carry no logarithm. In \
the prescriptions above such a loop collapses, and the changes cancel. The \
cell checks that cancellation. Numerically, k times (4.24) tends to a \
constant for k from 10 to 10^12. The closed form used for that column is \
(4.24)-(4.26), checked in the following sections.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"start", "=", 
        RowBox[{RowBox[{"Length", "[", "checks", "]"}], "+", "1"}]}], ";", 
      RowBox[{"shiftChange", "=", RowBox[
         {RowBox[{"c", " ", RowBox[{"(", RowBox[{RowBox[{"-", "zzNoP"}], "+", 
                RowBox[{"2", " ", "zSumP"}], "-", "oneZP", "-", "pZOne"}], 
              ")"}]}], "+", RowBox[{SuperscriptBox["c", "2"], " ", 
            RowBox[{"(", RowBox[{"zSum", "-", "oneZOne"}], ")"}]}]}]}], ";", 
      RowBox[{"collapseRules", "=", RowBox[
         {"{", RowBox[{RowBox[{"zzNoP", "\[Rule]", "0"}], ",", 
            RowBox[{"zSumP", "\[Rule]", RowBox[{"z1P", "+", "z4P"}]}], ",", 
            RowBox[{"oneZP", "\[Rule]", RowBox[{"2", " ", "z1P"}]}], ",", 
            RowBox[{"pZOne", "\[Rule]", RowBox[{"2", " ", "z4P"}]}], ",", 
            RowBox[{"oneZOne", "\[Rule]", "zSum"}]}], "}"}]}], ";", 
      RowBox[{"checkExact", "[", RowBox[
         {"\"common momentum-log shift cancels\"", ",", 
          RowBox[{"Expand", "[", RowBox[{"shiftChange", "/.", 
              "\[VeryThinSpace]", "collapseRules"}], "]"}]}], "]"}], ";", 
      RowBox[{"ra", "=", FractionBox[RowBox[{"a", "-", "k"}], 
         RowBox[{"a", "+", "k"}]]}], ";", 
      RowBox[{"rb", "=", FractionBox[RowBox[{"b", "-", "k"}], 
         RowBox[{"b", "+", "k"}]]}], ";", 
      RowBox[{"na", "=", RowBox[{"-", FractionBox[RowBox[{"a", "-", "k"}], 
           RowBox[{"2", " ", "k"}]]}]}], ";", 
      RowBox[{"nb", "=", RowBox[{"-", FractionBox[RowBox[{"b", "-", "k"}], 
           RowBox[{"2", " ", "k"}]]}]}], ";", 
      RowBox[{"ca", "=", RowBox[{"-", FractionBox[RowBox[{"a", "-", "k"}], 
           RowBox[{"b", "+", "k"}]]}]}], ";", 
      RowBox[{"cb", "=", RowBox[{"-", FractionBox[RowBox[{"b", "-", "k"}], 
           RowBox[{"a", "+", "k"}]]}]}], ";", 
      RowBox[{"rab", "=", RowBox[{"ra", " ", "rb"}]}], ";", 
      RowBox[{"lA", "=", RowBox[{"Log", "[", FractionBox[
           RowBox[{"a", "+", "k"}], RowBox[{"2", " ", "k"}]], "]"}]}], ";", 
      RowBox[{"lB", "=", RowBox[{"Log", "[", FractionBox[
           RowBox[{"b", "+", "k"}], RowBox[{"2", " ", "k"}]], "]"}]}], ";", 
      RowBox[{"pPlus", "=", RowBox[{RowBox[{"Zeta", "[", "3", "]"}], "-", 
          RowBox[{"PolyLog", "[", RowBox[{"3", ",", "ra"}], "]"}], "-", 
          RowBox[{"PolyLog", "[", RowBox[{"3", ",", "rb"}], "]"}], "-", 
          RowBox[{"PolyLog", "[", RowBox[{"3", ",", "rab"}], "]"}], "-", 
          RowBox[{"2", " ", RowBox[{"(", RowBox[{RowBox[{"PolyLog", "[", 
                  RowBox[{"3", ",", "na"}], "]"}], "+", RowBox[{"PolyLog", 
                  "[", RowBox[{"3", ",", "nb"}], "]"}]}], ")"}]}], "+", 
          RowBox[{"PolyLog", "[", RowBox[{"3", ",", "ca"}], "]"}], "+", 
          RowBox[{"PolyLog", "[", RowBox[{"3", ",", "cb"}], "]"}], "+", 
          RowBox[{RowBox[{"(", RowBox[{"lA", "+", "lB"}], ")"}], " ", 
            RowBox[{"(", RowBox[{RowBox[{"PolyLog", "[", RowBox[{"2", ",", 
                    "na"}], "]"}], "+", RowBox[{"PolyLog", "[", RowBox[
                   {"2", ",", "nb"}], "]"}]}], ")"}]}], "+", 
          RowBox[{FractionBox["1", "6"], " ", SuperscriptBox[
             RowBox[{"(", RowBox[{"lA", "+", "lB"}], ")"}], "3"]}]}]}], ";", 
      RowBox[{"pMinus", "=", RowBox[
         {RowBox[{"2", " ", RowBox[{"(", RowBox[{RowBox[{"PolyLog", "[", 
                  RowBox[{"3", ",", "ra"}], "]"}], "-", RowBox[{"PolyLog", 
                  "[", RowBox[{"3", ",", "rb"}], "]"}]}], ")"}]}], "+", 
          RowBox[{"2", " ", RowBox[{"(", RowBox[{RowBox[{"PolyLog", "[", 
                  RowBox[{"3", ",", "na"}], "]"}], "-", RowBox[{"PolyLog", 
                  "[", RowBox[{"3", ",", "nb"}], "]"}]}], ")"}]}], "-", 
          RowBox[{RowBox[{"(", RowBox[{"lA", "+", "lB"}], ")"}], " ", 
            RowBox[{"(", RowBox[{RowBox[{"PolyLog", "[", RowBox[{"2", ",", 
                    "na"}], "]"}], "-", RowBox[{"PolyLog", "[", RowBox[
                   {"2", ",", "nb"}], "]"}]}], ")"}]}], "+", 
          RowBox[{FractionBox["1", "6"], " ", SuperscriptBox["\[Pi]", "2"], 
            " ", RowBox[{"(", RowBox[{"lA", "-", "lB"}], ")"}]}], "-", 
          RowBox[{FractionBox["1", "3"], " ", RowBox[
             {"(", RowBox[{SuperscriptBox["lA", "3"], "-", SuperscriptBox[
                 "lB", "3"]}], ")"}]}]}]}], ";", 
      RowBox[{RowBox[{"deltaClosed", "[", RowBox[{"u_", ",", "v_", ",", 
            "t_"}], "]"}], ":=", RowBox[
         {RowBox[{"2", " ", SuperscriptBox["\[Pi]", "3"], " ", 
            RowBox[{"(", RowBox[{FractionBox["pPlus", RowBox[{"a", "+", 
                   "b"}]], "+", FractionBox["pMinus", RowBox[{"a", "-", 
                   "b"}]]}], ")"}]}], "/.", "\[VeryThinSpace]", 
          RowBox[{"{", RowBox[{RowBox[{"a", "\[Rule]", "u"}], ",", 
              RowBox[{"b", "\[Rule]", "v"}], ",", RowBox[{"k", "\[Rule]", 
                "t"}]}], "}"}]}]}], ";", RowBox[{"kValues", "=", 
        RowBox[{"{", RowBox[{"10", ",", "100", ",", SuperscriptBox["10", 
             "4"], ",", SuperscriptBox["10", "6"], ",", SuperscriptBox["10", 
             "8"], ",", SuperscriptBox["10", "12"]}], "}"}]}], ";", 
      RowBox[{"kRows", "=", RowBox[{"Table", "[", 
          RowBox[{RowBox[{"{", RowBox[{"kk", ",", RowBox[{"Quiet", "[", 
                  RowBox[{RowBox[{"N", "[", RowBox[{RowBox[{"kk", " ", 
                          RowBox[{"deltaClosed", "[", RowBox[{FractionBox[
                          "13", "10"], ",", FractionBox["17", "10"], ",", 
                          "kk"}], "]"}]}], ",", "12"}], "]"}], ",", 
                    RowBox[{"{", StyleBox[RowBox[{"N", "::", "meprec"}], 
