polylogarithm arguments below 1\"", "\"exact\"", "0", "\"identity\""}}, 
          GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
          GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
          GridBoxItemSize -> {"Columns" -> {{Automatic}}, 
            "Rows" -> {{Automatic}}}], "Grid"]}], "}"}]], "Output"], 
  Cell["5. The variables (4.27)", "Section"], Cell["r12 = (a - k)/(a + k) and \
r34 = (b - k)/(b + k). Substituting a = k (1 + r12)/(1 - r12) and b = k (1 + \
r34)/(1 - r34), k times (4.24) does not depend on k. Physical kinematics is \
the square 0 < r12, r34 < 1, and all positive momenta form the square -1 < \
r12, r34 < 1.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"start", "=", 
        RowBox[{RowBox[{"Length", "[", "checks", "]"}], "+", "1"}]}], ";", 
      RowBox[{RowBox[{"rDelta", "[", RowBox[{"r1_", ",", "r2_", ",", "kk_"}], 
          "]"}], ":=", RowBox[{"N", "[", RowBox[
           {RowBox[{"kk", " ", RowBox[{"deltaClosed", "[", RowBox[
                 {FractionBox[RowBox[{"kk", " ", RowBox[{"(", RowBox[
                        {"1", "+", "r1"}], ")"}]}], RowBox[{"1", "-", 
                     "r1"}]], ",", FractionBox[RowBox[{"kk", " ", RowBox[
                      {"(", RowBox[{"1", "+", "r2"}], ")"}]}], RowBox[
                    {"1", "-", "r2"}]], ",", "kk"}], "]"}]}], ",", "30"}], 
          "]"}]}], ";", RowBox[{"checkNumerical", "[", 
        RowBox[{"\"k (4.24) independent of k at r = (1/2, 1/3)\"", ",", 
          RowBox[{"rDelta", "[", RowBox[{FractionBox["1", "2"], ",", 
              FractionBox["1", "3"], ",", "1"}], "]"}], ",", 
          RowBox[{"rDelta", "[", RowBox[{FractionBox["1", "2"], ",", 
              FractionBox["1", "3"], ",", "5"}], "]"}], ",", "20"}], "]"}], 
      ";", RowBox[{"checkNumerical", "[", 
        RowBox[{"\"k (4.24) independent of k at r = (-1/2, 1/4)\"", ",", 
          RowBox[{"rDelta", "[", RowBox[{RowBox[{"-", FractionBox["1", 
                 "2"]}], ",", FractionBox["1", "4"], ",", "1"}], "]"}], ",", 
          RowBox[{"rDelta", "[", RowBox[{RowBox[{"-", FractionBox["1", 
                 "2"]}], ",", FractionBox["1", "4"], ",", "5"}], "]"}], ",", 
          "20"}], "]"}], ";", RowBox[{"checkTrue", "[", 
        RowBox[{"\"physical kinematics is 0 < r12, r34 < 1\"", ",", 
          RowBox[{"Resolve", "[", RowBox[{RowBox[{SubscriptBox["\[ForAll]", 
                 RowBox[{RowBox[{"{", RowBox[{"a", ",", "b", ",", "k"}], 
                     "}"}], ",", RowBox[{RowBox[{"a", ">", "k", ">", "0"}], 
                     "&&", RowBox[{"b", ">", "k"}]}]}]], RowBox[
                 {"(", RowBox[{RowBox[{"0", "<", FractionBox[RowBox[{"a", 
                         "-", "k"}], RowBox[{"a", "+", "k"}]], "<", "1"}], 
                    "&&", RowBox[{"0", "<", FractionBox[RowBox[{"b", "-", 
                         "k"}], RowBox[{"b", "+", "k"}]], "<", "1"}]}], 
                  ")"}]}], ",", TemplateBox[{}, "Reals"]}], "]"}]}], "]"}], 
      ";", RowBox[{"checkTrue", "[", RowBox[
         {"\"positive momenta are -1 < r12, r34 < 1\"", ",", 
          RowBox[{"Resolve", "[", RowBox[{RowBox[{SubscriptBox["\[ForAll]", 
                 RowBox[{RowBox[{"{", RowBox[{"a", ",", "b", ",", "k"}], 
                     "}"}], ",", RowBox[{RowBox[{"a", ">", "0"}], "&&", 
                     RowBox[{"b", ">", "0"}], "&&", RowBox[{"k", ">", 
                       "0"}]}]}]], RowBox[{"(", RowBox[{RowBox[
                     {RowBox[{"-", "1"}], "<", FractionBox[RowBox[{"a", "-", 
                         "k"}], RowBox[{"a", "+", "k"}]], "<", "1"}], "&&", 
                    RowBox[{RowBox[{"-", "1"}], "<", FractionBox[RowBox[
                        {"b", "-", "k"}], RowBox[{"b", "+", "k"}]], "<", 
                      "1"}]}], ")"}]}], ",", TemplateBox[{}, "Reals"]}], 
            "]"}]}], "]"}], ";", RowBox[{"checkTrue", "[", 
        RowBox[{"\"0 < r < 1 gives a > k and b > k\"", ",", 
          RowBox[{"Resolve", "[", RowBox[{RowBox[{SubscriptBox["\[ForAll]", 
                 RowBox[{RowBox[{"{", RowBox[{"r1", ",", "r2", ",", "k"}], 
                     "}"}], ",", RowBox[{RowBox[{"k", ">", "0"}], "&&", 
                     RowBox[{"0", "<", "r1", "<", "1"}], "&&", RowBox[
                      {"0", "<", "r2", "<", "1"}]}]}]], RowBox[
                 {"(", RowBox[{RowBox[{FractionBox[RowBox[{"k", " ", RowBox[
                          {"(", RowBox[{"1", "+", "r1"}], ")"}]}], RowBox[
                        {"1", "-", "r1"}]], ">", "k"}], "&&", RowBox[
                     {FractionBox[RowBox[{"k", " ", RowBox[{"(", RowBox[
                          {"1", "+", "r2"}], ")"}]}], RowBox[{"1", "-", 
                         "r2"}]], ">", "k"}]}], ")"}]}], ",", 
              TemplateBox[{}, "Reals"]}], "]"}]}], "]"}], ";", 
      RowBox[{"checkTrue", "[", RowBox[
         {"\"-1 < r < 1 gives positive momenta\"", ",", 
          RowBox[{"Resolve", "[", RowBox[{RowBox[{SubscriptBox["\[ForAll]", 
                 RowBox[{RowBox[{"{", RowBox[{"r1", ",", "r2", ",", "k"}], 
                     "}"}], ",", RowBox[{RowBox[{"k", ">", "0"}], "&&", 
                     RowBox[{RowBox[{"-", "1"}], "<", "r1", "<", "1"}], "&&", 
                     RowBox[{RowBox[{"-", "1"}], "<", "r2", "<", "1"}]}]}]], 
                RowBox[{"(", RowBox[{RowBox[{FractionBox[RowBox[{"k", " ", 
                         RowBox[{"(", RowBox[{"1", "+", "r1"}], ")"}]}], 
                       RowBox[{"1", "-", "r1"}]], ">", "0"}], "&&", 
                    RowBox[{FractionBox[RowBox[{"k", " ", RowBox[{"(", 
                          RowBox[{"1", "+", "r2"}], ")"}]}], RowBox[{"1", 
                         "-", "r2"}]], ">", "0"}]}], ")"}]}], ",", 
              TemplateBox[{}, "Reals"]}], "]"}]}], "]"}], ";", 
      RowBox[{"sectionRows", "[", "start", "]"}]}]], "Input"], 
